translate deutsch b2c12s19_3_ferries_wheel_68ad14b3:

    # zp "[mcname], {i}dude{/i}, what the hell is-!?"
    zp "[mcname], {i}Alter{/i}, was zur Hölle ist-!?"

# game/code/book-2/chapter-12/s19_3.rpy:484
translate deutsch b2c12s19_3_ferries_wheel_1abdb75a:

    # mc "... huhh... hahh... urghh..."
    mc "... huhh... hahh... urghh..."

