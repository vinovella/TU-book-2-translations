translate deutsch b2c12s19_3_ferries_wheel_cc6cd125:

    # mc "I... girls, {i}please{/i}. You're gonna make me blush."
    mc "Ich... Mädels, {i}bitte{/i}. Ihr macht mich noch rot."

# game/code/book-2/chapter-12/s19_3.rpy:429
translate deutsch b2c12s19_3_ferries_wheel_863cff52:

    # nv "I wouldn't mind that, haha!"
    nv "Das würde mir nichts ausmachen, haha!"

# game/code/book-2/chapter-12/s19_3.rpy:432
