# game/code/book-2/chapter-12/s19_3.rpy:440
translate deutsch b2c12s19_3_ferries_wheel_8f3fd2b3:

    # mct "-arugh! C'mon, not now... I feel guilty enough {i}without{/i} lines like that..."
    mct "-arugh! Komm schon, nicht jetzt... Ich fühl mich schon schuldig genug {i}ohne{/i} solche Sätze..."

# game/code/book-2/chapter-12/s19_3.rpy:443
translate deutsch b2c12s19_3_ferries_wheel_1086aace:

    # zp "Aww, you getting embarrassed again? I could get used to this."
    zp "Aww, wirst du wieder verlegen? Das könnte mir gefallen."

# game/code/book-2/chapter-12/s19_3.rpy:444
translate deutsch b2c12s19_3_ferries_wheel_f23f83b8:

    # zp "... It's me too, you know? If you hadn't run into me at the shooting range... I mean, it's like. Uncanny, right?"
    zp "... Mir geht's auch so, weißt du? Wenn du mich nicht beim Schießstand getroffen hättest... ich mein, es ist schon. Unheimlich, oder?"

# game/code/book-2/chapter-12/s19_3.rpy:450
