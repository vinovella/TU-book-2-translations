# game/code/book-2/chapter-12/s19_3.rpy:422
translate deutsch b2c12s19_3_ferries_wheel_0ce12f97:

    # zp "I'm... {i}guh{/i}, shit, {i}fine{/i}. I'm glad I decided to trust you, okay? Thanks."
    zp "Ich bin... {i}guh{/i}, scheiße, {i}froh{/i}. Ich bin froh, dass ich mich entschieden habe, dir zu vertrauen, okay? Danke."

# game/code/book-2/chapter-12/s19_3.rpy:426
translate deutsch b2c12s19_3_ferries_wheel_b21495d7:

    # mct "Oh... ouch."
    mct "Oh... aua."

