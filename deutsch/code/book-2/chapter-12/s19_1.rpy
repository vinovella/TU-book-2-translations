translate deutsch b2c12s19_1_exit_ferries_wheel_c2c3ce40:

    # zp "Hey, [mcname], chill... it's alright. Sick is sick - I made all the threesome jokes, but that's not important, okay? Just... rest."
    zp "Hey, [mcname], entspann... ist schon okay. Krank ist krank - ich hab all die Dreier-Witze gemacht, aber das ist nicht wichtig, okay? Einfach... ausruhen."

# game/code/book-2/chapter-12/s19_1.rpy:530
translate deutsch b2c12s19_1_exit_ferries_wheel_46e30c51:

    # zp "Silvia - you got anything good for an upset stomach or something?"
    zp "Silvia - hast du was Gutes gegen 'nen Magenverstimmung oder so?"

