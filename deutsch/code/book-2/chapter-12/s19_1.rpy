    zp "[mcname], {i}Alter{/i}, was zum Teufel ist-!?"

# game/code/book-2/chapter-12/s19_1.rpy:496
translate deutsch b2c12s19_1_exit_ferries_wheel_1abdb75a:

    # mc "... huhh... hahh... urghh..."
    mc "... huhh... hahh... urghh..."

