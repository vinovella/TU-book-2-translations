translate deutsch b2c12s06_2_6bb4c566:



    # mc "Yeah, we talked. And now we're talking some more. Maybe I have some more things to say."

    mc "Ja, wir haben geredet. Und jetzt reden wir weiter. Vielleicht hab ich noch ein paar Dinge zu sagen."



# game/code/book-2/chapter-12/s06_2.rpy:543

translate deutsch b2c12s06_2_74df0204:



    # pm "..."

    pm "..."



# game/code/book-2/chapter-12/s06_2.rpy:547

