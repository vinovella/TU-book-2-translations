translate deutsch b2c14s11_threesome_f13f8306:

    # oa "I'm not sure."
    oa "Ich bin mir nicht sicher."

# game/code/book-2/chapter-14/b2c14s11.rpy:1858
translate deutsch b2c14s11_threesome_5efdf5ae:

    # mc "Well, can't be worse than whatever that was."
    mc "Na ja, schlimmer als das, was gerade war, kann es nicht werden."

# game/code/book-2/chapter-14/b2c14s11.rpy:1859
translate deutsch b2c14s11_threesome_37a8c219:

    # mc "But... I guess it is nice to know your sister is very..."
    mc "Aber... ich schätze, es ist gut zu wissen, dass deine Schwester sehr..."

# game/code/book-2/chapter-14/b2c14s11.rpy:1860
translate deutsch b2c14s11_threesome_d322a0a0:

    # mc "Prepared."
    mc "Vorbereitet."

# game/code/book-2/chapter-14/b2c14s11.rpy:1863
translate deutsch b2c14s11_threesome_39552939:

    # oa "That is one word for it."
    oa "Das ist ein Wort dafür."

# game/code/book-2/chapter-14/b2c14s11.rpy:1864
translate deutsch b2c14s11_threesome_980fa7d1:

    # "She laughs. Her hands are still shaking."
    "Sie lacht. Ihre Hände zittern noch."

# game/code/book-2/chapter-14/b2c14s11.rpy:1866
translate deutsch b2c14s11_threesome_9b256691:

    # "The laugh dies."
    "Das Lachen stirbt ab."

# game/code/book-2/chapter-14/b2c14s11.rpy:1868
translate deutsch b2c14s11_threesome_e70bcefc:

    # oa "She... she looked at me, [mcname]. When she was... down there. She looked at me and she wasn't angry."
    oa "Sie... sie hat mich angeguckt, [mcname]. Als sie... unten da war. Sie hat mich angeguckt und sie war nicht wütend."

# game/code/book-2/chapter-14/b2c14s11.rpy:1869
translate deutsch b2c14s11_threesome_7847dd9c:

    # oa "I think that's the first time she hasn't been angry at me in years."
    oa "Ich glaube, das ist das erste Mal seit Jahren, dass sie nicht wütend auf mich ist."

# game/code/book-2/chapter-14/b2c14s11.rpy:1872
translate deutsch b2c14s11_threesome_522abf8b:

    # "You put your arm around her. She leans into your chest, shaking."
    "Du legst deinen Arm um sie. Sie lehnt sich an deine Brust, zitternd."

# game/code/book-2/chapter-14/b2c14s11.rpy:1874
translate deutsch b2c14s11_threesome_75fb0941:

    # oa "I don't know what that was."
    oa "Ich weiß nicht, was das war."

# game/code/book-2/chapter-14/b2c14s11.rpy:1876
translate deutsch b2c14s11_threesome_fc587791:

    # mc "I don't think it has a name yet."
    mc "Ich glaube, das hat noch keinen Namen."

# game/code/book-2/chapter-14/b2c14s11.rpy:1879
translate deutsch b2c14s11_threesome_975c004c:

    # oa "...Loud. If nothing else, it was loud."
    oa "...Laut. Wenn nichts anderes, es war laut."

# game/code/book-2/chapter-14/b2c14s11.rpy:1881
translate deutsch b2c14s11_threesome_70ec2d99:

    # mc "C'mon. Let's get the leg on."
    mc "Komm schon. Lass uns das Bein anziehen."

# game/code/book-2/chapter-14/b2c14s11.rpy:1885
translate deutsch b2c14s11_threesome_bbea7955:

    # "Click."
    "Klick."

# game/code/book-2/chapter-14/b2c14s11.rpy:1888
translate deutsch b2c14s11_threesome_43da557a:

    # "You reach down for your shirt."
    "Du beugst dich nach deinem Shirt runter."

# game/code/book-2/chapter-14/b2c14s11.rpy:1890
translate deutsch b2c14s11_threesome_d2bb6086:

    # oa "...Can you stay a little longer?"
    oa "...Kannst du noch ein bisschen bleiben?"

# game/code/book-2/chapter-14/b2c14s11.rpy:1892
translate deutsch b2c14s11_threesome_c7852d18:

    # "She tries to sound casual and misses by a mile."
    "Sie versucht, lässig zu klingen, und verfehlt das Ziel meilenweit."

# game/code/book-2/chapter-14/b2c14s11.rpy:1896
translate deutsch b2c14s11_threesome_cf1adef2_1:

    # mc "Yeah."
    mc "Ja."

# game/code/book-2/chapter-14/b2c14s11.rpy:1899
translate deutsch b2c14s11_threesome_4f0c530a:

    # mc "I've got you..."
    mc "Ich habe dich..."

# game/code/book-2/chapter-14/b2c14s11.rpy:1901
translate deutsch b2c14s11_threesome_6f953fa0:

    # oa "Mmmm."
    oa "Mmmm."

# game/code/book-2/chapter-14/b2c14s11.rpy:1902
translate deutsch b2c14s11_threesome_d1cb1898:

    # "You set the shirt back down and sit beside her again."
    "Du legst das Shirt zurück und setzt dich wieder neben sie."

# game/code/book-2/chapter-14/b2c14s11.rpy:1903
translate deutsch b2c14s11_threesome_57f6f264:

    # mc "You were incredible. All of it."
    mc "Du warst unglaublich. Das alles."

# game/code/book-2/chapter-14/b2c14s11.rpy:1904
translate deutsch b2c14s11_threesome_613e4c44:

    # oa "You're so sweet to me, [mcname]."
    oa "Du bist so süß zu mir, [mcname]."

# game/code/book-2/chapter-14/b2c14s11.rpy:1909
translate deutsch b2c14s11_threesome_6f953fa0_1:

    # oa "Mmmm."
    oa "Mmmm."

# game/code/book-2/chapter-14/b2c14s11.rpy:1910
translate deutsch b2c14s11_threesome_5b24f0af:

    # "Her smile comes small and tired and real. You tip her chin up and kiss her slow enough that the room finally starts to settle."
    "Ihr Lächeln kommt klein und müde und echt. Du hebst ihr Kinn an und küsst sie so langsam, dass sich das Zimmer endlich zu beruhigen beginnt."

