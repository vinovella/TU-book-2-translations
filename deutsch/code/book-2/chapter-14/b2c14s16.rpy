translate deutsch b2c14s16_c92591c8:

    # ass "I know my strengths, Foxy. Don't you worry."
    ass "Ich kenne meine Stärken, Foxy. Mach dir keine Sorgen."

# game/code/book-2/chapter-14/b2c14s16.rpy:226
translate deutsch b2c14s16_cd77c015:

    # fox "You got two minutes. Then it's Showtime."
    fox "Du hast zwei Minuten. Dann ist Showtime."

# game/code/book-2/chapter-14/b2c14s16.rpy:232
translate deutsch b2c14s16_f85cf1f2:

    # mc "Alright. Am I Eddie Murphy? Or De Niro?"
    mc "Gut. Bin ich Eddie Murphy? Oder De Niro?"

