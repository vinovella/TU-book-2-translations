translate deutsch b2c14s16_d8a2e851:

    # ass "Come on. That crowd is right at the edge of buzzed and drunk."
    ass "Komm schon. Die Menge steht genau an der Grenze zwischen gut gelaunt und betrunken."

# game/code/book-2/chapter-14/b2c14s16.rpy:167
translate deutsch b2c14s16_c933c921:

    # ass "But they're not opening up their wallets without getting a look at both fighters."
    ass "Aber sie öffnen ihre Brieftaschen nicht, ohne sich beide Kämpfer anzusehen."

# game/code/book-2/chapter-14/b2c14s16.rpy:172
