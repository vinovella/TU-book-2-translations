translate deutsch b2c14s16_760d4b54:

    # mc "You're going to leave without kissing me good luck."
    mc "Du willst gehen, ohne mir Glück zu küssen?"

# game/code/book-2/chapter-14/b2c14s16.rpy:364
translate deutsch b2c14s16_4835a67b:

    # rg "*giggles* Don't you mean wishing you good luck?"
    rg "*kicher* Meinst du nicht, mir Glück zu wünschen?"

