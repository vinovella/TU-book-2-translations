    fox "Heh."

# game/code/book-2/chapter-14/b2c14s16.rpy:173
translate deutsch b2c14s16_7a5c6cdc:

    # fox "Knock em dead, [mcname]."
    fox "Reiß sie rein, [mcname]."

# game/code/book-2/chapter-14/b2c14s16.rpy:180
