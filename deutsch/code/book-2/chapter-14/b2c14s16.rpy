    # fox "Yes."
    fox "Ja."

# game/code/book-2/chapter-14/b2c14s16.rpy:159
translate deutsch b2c14s16_0ddf45cf:

    # mc "Oh, didn't think you'd say that."
    mc "Oh, hätte nicht gedacht, dass du das sagst."

# game/code/book-2/chapter-14/b2c14s16.rpy:162
translate deutsch b2c14s16_fbd10c31:

    # fox "You should expect the unexpected, [mcname]."
    fox "Du solltest das Unerwartete erwarten, [mcname]."

