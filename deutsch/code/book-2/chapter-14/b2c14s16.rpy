translate deutsch b2c14s16_19634b6f:

    # fox "Just checking in to make sure you're good."
    fox "Nur mal vorbeigeschaut, um sicherzugehen, dass es dir gut geht."

# game/code/book-2/chapter-14/b2c14s16.rpy:153
translate deutsch b2c14s16_b1dc043b:

    # mc "You worried about me?"
    mc "Du machst dir Sorgen um mich?"

# game/code/book-2/chapter-14/b2c14s16.rpy:156
