translate deutsch b2c14s16_7c3fb0f1:

    # mg "Please Rory. I don't want you to land in the same position you were in two weeks ago."
    mg "Bitte Rory. Ich will nicht, dass du in die gleiche Lage gerätst wie vor zwei Wochen."

# game/code/book-2/chapter-14/b2c14s16.rpy:346
translate deutsch b2c14s16_fd0a804f:

    # mg "And I don't think you want that either."
    mg "Und ich glaube nicht, dass du das willst."

# game/code/book-2/chapter-14/b2c14s16.rpy:349
translate deutsch b2c14s16_b6690c5e:

    # rg "Yeah. Guess you're right about that."
    rg "Ja. Ich schätze, du hast recht."

# game/code/book-2/chapter-14/b2c14s16.rpy:351
translate deutsch b2c14s16_483d743e:

    # rg "Well, you still got a cheerleader in me, [mcname]."
    rg "Na ja, ich bin immer noch dein Cheerleader, [mcname]."

# game/code/book-2/chapter-14/b2c14s16.rpy:353
translate deutsch b2c14s16_a64e8bc0:

    # mc "Thanks."
    mc "Danke."

