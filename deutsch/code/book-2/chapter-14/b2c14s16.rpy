translate deutsch b2c14s16_27b224d3:

    # mc "I'll see you on the other side."
    mc "Wir sehen uns auf der anderen Seite."

# game/code/book-2/chapter-14/b2c14s16.rpy:398
translate deutsch b2c14s16_8cfb304f:

    # mg "Just don't come out too bruised and bloody."
    mg "Komm nur nicht zu zerquetscht und blutig zurück."

# game/code/book-2/chapter-14/b2c14s16.rpy:399
translate deutsch b2c14s16_d699020f:

    # mg "I've got plans for after this."
    mg "Ich habe Pläne für danach."

# game/code/book-2/chapter-14/b2c14s16.rpy:401
translate deutsch b2c14s16_c3a6f007:

    # mc "Oh you do?"
    mc "Oh, wirklich?"

# game/code/book-2/chapter-14/b2c14s16.rpy:403
translate deutsch b2c14s16_0f59aa0c:

    # mg "Yes. And they require that hot bod of yours to be mostly functional."
    mg "Ja. Und dafür muss dein heißer Körper größtenteils funktionsfähig sein."

# game/code/book-2/chapter-14/b2c14s16.rpy:404
