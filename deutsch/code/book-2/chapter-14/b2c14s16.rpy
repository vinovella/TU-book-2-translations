    # fox "The Beast!!!"
    fox "Die Bestie!!!"

# game/code/book-2/chapter-14/b2c14s16.rpy:444
translate deutsch b2c14s16_ed9c9b18:

    # mct "Huh. This guy definitely doesn't look like the fighters who have come from before."
    mct "Huh. Der Typ sieht definitiv nicht aus wie die Kämpfer, die früher kamen."

# game/code/book-2/chapter-14/b2c14s16.rpy:449
