translate deutsch b2c14s16_ddaabd3c:

    # mg "You said that the Wasps getting pinched was a sign, and you'd never gamble again."
    mg "Du hast gesagt, dass die Verhaftung der Wespen ein Zeichen war, und du würdest nie wieder glückspielen."

# game/code/book-2/chapter-14/b2c14s16.rpy:332
translate deutsch b2c14s16_899cb631:

    # mg "And there is no way that you screw up and get back in."
    mg "Und da ist kein Weg, dass du dich verhedderst und wieder einsteigst."

# game/code/book-2/chapter-14/b2c14s16.rpy:336
translate deutsch b2c14s16_e65631b9:

    # rg "I want to bet on [mcname]."
    rg "Ich will auf [mcname] wetten."

# game/code/book-2/chapter-14/b2c14s16.rpy:337
translate deutsch b2c14s16_24516c23:

    # rg "That's like betting on a sure thing."
    rg "Das ist so, als würde man auf eine sichere Sache wetten."

# game/code/book-2/chapter-14/b2c14s16.rpy:340
translate deutsch b2c14s16_391c033a:

    # mg "There is no such thing as a sure thing."
    mg "So etwas wie eine sichere Sache gibt es nicht."

