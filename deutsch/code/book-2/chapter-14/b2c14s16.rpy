translate deutsch b2c14s16_5f3732b4:

    # mg "Leave the gambling to the crowd."
    mg "Überlass das Glückspiel der Menge."

# game/code/book-2/chapter-14/b2c14s16.rpy:343
translate deutsch b2c14s16_76df6b7d:

    # rg "But."
    rg "Aber."

