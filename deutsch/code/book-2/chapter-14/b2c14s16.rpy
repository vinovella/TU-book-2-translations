    # mc "Guess I better win."
    mc "Dann gewinn ich besser."

# game/code/book-2/chapter-14/b2c14s16.rpy:405
translate deutsch b2c14s16_94cac918:

    # mg "Mmhmm."
    mg "Mhm."

# game/code/book-2/chapter-14/b2c14s16.rpy:410
translate deutsch b2c14s16_3cc092ba:

    # fox "We have a live one for you tonight, folks!"
    fox "Wir haben einen Lebenden für euch heute Abend, Leute!"

