translate deutsch b2c14s16_8a589710:

    # mc "I know what I'm about, Rory."
    mc "Ich weiß, was ich meine, Rory."

# game/code/book-2/chapter-14/b2c14s16.rpy:368
translate deutsch b2c14s16_c325e151:

    # rg "Haha."
    rg "Haha."

# game/code/book-2/chapter-14/b2c14s16.rpy:369
translate deutsch b2c14s16_75c70cae:

    # rg "Well, since you put it that way."
    rg "Na ja, wenn du es so sagst."

# game/code/book-2/chapter-14/b2c14s16.rpy:381
translate deutsch b2c14s16_9901a29f:

    # rg "Mwah."
    rg "Mwah."

# game/code/book-2/chapter-14/b2c14s16.rpy:384
translate deutsch b2c14s16_914bc095:

    # rg "Now go get 'em."
    rg "Jetzt geh und hol sie dir."

# game/code/book-2/chapter-14/b2c14s16.rpy:391
translate deutsch b2c14s16_b962addd:

    # mg "You got this, [mcname]."
    mg "Du schaffst das, [mcname]."

