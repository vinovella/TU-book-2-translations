translate deutsch b2c14s16_3af491df:

    # ass "Ready for this, [mcname]?"
    ass "Bereit dafür, [mcname]?"

# game/code/book-2/chapter-14/b2c14s16.rpy:214
translate deutsch b2c14s16_8f4821d9:

    # mc "Oh yeah. Always ready for action."
    mc "Oh yeah. Immer bereit für action."

# game/code/book-2/chapter-14/b2c14s16.rpy:217
translate deutsch b2c14s16_a13ff918:

    # fox "Asami, get working on another round."
    fox "Asami, mach dich an die nächste Runde."

