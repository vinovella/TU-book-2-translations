translate deutsch b2c14s16_e3a4839f:

    # fox "You can be whoever you want."
    fox "Du kannst sein, wer immer du willst."

# game/code/book-2/chapter-14/b2c14s16.rpy:236
translate deutsch b2c14s16_7d3057fb:

    # fox "Just don't end up as a cheap imitation HBO."
    fox "Nur nicht als billige HBO-Nachahmung enden."

# game/code/book-2/chapter-14/b2c14s16.rpy:238
translate deutsch b2c14s16_dc16ebcd:

    # mc "Got it."
    mc "Verstanden."

# game/code/book-2/chapter-14/b2c14s16.rpy:244
translate deutsch b2c14s16_c9c9dc67:

    # mc "This is our house, Foxy. The crowd will get what they came for."
    mc "Das ist unser Haus, Foxy. Die Menge kriegt, wofür sie gekommen ist."

# game/code/book-2/chapter-14/b2c14s16.rpy:247
translate deutsch b2c14s16_548e9770:

    # fox "Good."
    fox "Gut."

# game/code/book-2/chapter-14/b2c14s16.rpy:253
translate deutsch b2c14s16_918695dc:

    # mc "This ain't no thang."
    mc "Das ist kein Ding."

# game/code/book-2/chapter-14/b2c14s16.rpy:254
translate deutsch b2c14s16_b5503a7c:

    # mc "My skills have doubled since my last fight."
    mc "Meine Fähigkeiten haben sich seit meinem letzten Kampf verdoppelt."

# game/code/book-2/chapter-14/b2c14s16.rpy:257
translate deutsch b2c14s16_a1795c20:

    # fox "Good, but keep that to me."
    fox "Gut, aber behalt das für dich."

# game/code/book-2/chapter-14/b2c14s16.rpy:258
translate deutsch b2c14s16_a5fe7e90:

    # fox "Don't want to ruin your odds."
    fox "Will deine Chancen nicht ruinieren."

# game/code/book-2/chapter-14/b2c14s16.rpy:265
translate deutsch b2c14s16_244a9910:

    # rg "This is crazy. I was shocked when Morgan told me there was another fight going on tonight."
    rg "Das ist verrückt. Ich war schockiert, als Morgan mir sagte, dass heute Abend noch ein Kampf stattfindet."

# game/code/book-2/chapter-14/b2c14s16.rpy:270
translate deutsch b2c14s16_d15a3e8d:

    # mc "Yeah. I was thinking the same thing."
    mc "Ja. Ich habe das Gleiche gedacht."

# game/code/book-2/chapter-14/b2c14s16.rpy:273
translate deutsch b2c14s16_6c41cf41:

    # mg "Well, now ain't the time for thinking, [mcname]."
    mg "Nun, jetzt ist keine Zeit zum Denken, [mcname]."

# game/code/book-2/chapter-14/b2c14s16.rpy:274
translate deutsch b2c14s16_47d71523:

    # mg "I spent too much time training you to lose just because we don't have our usual pep time."
    mg "Ich habe zu viel Zeit damit verbracht, dich zu trainieren, als dass du nur verlieren solltest, weil wir unsere übliche Aufbauzeit nicht haben."

# game/code/book-2/chapter-14/b2c14s16.rpy:276
translate deutsch b2c14s16_79d0508c:

    # mc "Your pep talks could use some work, Morgan."
    mc "Deine Aufbaureden könnten etwas Arbeit vertragen, Morgan."

# game/code/book-2/chapter-14/b2c14s16.rpy:278
translate deutsch b2c14s16_6df3d70f:

    # mg "Maybe."
    mg "Vielleicht."

# game/code/book-2/chapter-14/b2c14s16.rpy:279
translate deutsch b2c14s16_4e4a0152:

    # mg "I'd give you something better but the new fighter is a wild card."
    mg "Ich würde dir etwas Besseres geben, aber der neue Kämpfer ist eine Unbekannte Größe."

# game/code/book-2/chapter-14/b2c14s16.rpy:282
translate deutsch b2c14s16_01f8d525:

    # rg "Wait, you don't know them, Morige?"
    rg "Warte, du kennst sie nicht, Morige?"

# game/code/book-2/chapter-14/b2c14s16.rpy:285
translate deutsch b2c14s16_f06ec116:

    # mg "It's alright. Foxy said they were cool, so I'm sure they're some college punk who watches too many Fast and Furious movies."
    mg "Schon gut. Foxy sagte, sie wären okay, also bin ich sicher, dass es irgendein Studentenrotz ist, der zu viele Fast-and-Furious-Filme schaut."

# game/code/book-2/chapter-14/b2c14s16.rpy:288
translate deutsch b2c14s16_9d036476:

    # rg "Well, it doesn't matter. It wasn't like I was going to bet on anyone but [mcname] after all."
    rg "Nun, egal. Es war ja nicht so, als hätte ich auf jemand anderen als [mcname] gewettet."

# game/code/book-2/chapter-14/b2c14s16.rpy:294
translate deutsch b2c14s16_c9956606:

    # mc "Thanks for the support, Rory."
    mc "Danke für die Unterstützung, Rory."

# game/code/book-2/chapter-14/b2c14s16.rpy:297
translate deutsch b2c14s16_f46bca1b:

    # mg "That's all she's giving you."
    mg "Mehr gibt sie dir nicht."

# game/code/book-2/chapter-14/b2c14s16.rpy:301
translate deutsch b2c14s16_59e6ad0c:

    # rg "Huh?"
    rg "Hä?"

# game/code/book-2/chapter-14/b2c14s16.rpy:303
translate deutsch b2c14s16_84fbce24:

    # mg "I told you, no more betting."
    mg "Ich habs dir gesagt, kein Wetten mehr."

# game/code/book-2/chapter-14/b2c14s16.rpy:305
translate deutsch b2c14s16_82e93915:

    # rg "Oh come on, Morgan."
    rg "Ach komm schon, Morgan."

# game/code/book-2/chapter-14/b2c14s16.rpy:308
translate deutsch b2c14s16_5ba8adb1:

    # mg "No way. Because you told me to remind you if you slip up."
    mg "Auf keinen Fall. Weil du mir gesagt hast, ich soll dich erinnern, wenn du einen Fehler machst."

# game/code/book-2/chapter-14/b2c14s16.rpy:310
translate deutsch b2c14s16_4bd273db:

    # rg "Thanks, Mom. When did you get so serious?"
    rg "Danke, Mutti. Wann bist du denn so ernst geworden?"

# game/code/book-2/chapter-14/b2c14s16.rpy:312
translate deutsch b2c14s16_f3032083:

    # mg "Since I had to help fix up your mess, Rory."
    mg "Seit ich deinen Schlamassel ausbügeln musste, Rory."

# game/code/book-2/chapter-14/b2c14s16.rpy:314
translate deutsch b2c14s16_f991a1ba:

    # rg "But Morgan..."
    rg "Aber Morgan..."

# game/code/book-2/chapter-14/b2c14s16.rpy:319
translate deutsch b2c14s16_42cb171f:

    # mc "That's... wait. Are you sure you should be gambling, Rory?"
    mc "Das ist... warte. Bist du sicher, dass du glückspielen solltest, Rory?"

# game/code/book-2/chapter-14/b2c14s16.rpy:320
translate deutsch b2c14s16_a049a28f:

    # mc "You know how it can get."
    mc "Du weißt, wie es werden kann."

# game/code/book-2/chapter-14/b2c14s16.rpy:324
translate deutsch b2c14s16_8cf54118:

    # mg "Thanks for making it so I don't have to be the bad girl."
    mg "Danke, dass du es so machst, dass ich nicht die Böse sein muss."

# game/code/book-2/chapter-14/b2c14s16.rpy:327
translate deutsch b2c14s16_97e8f4e4:

    # rg "What?"
    rg "Was?"

# game/code/book-2/chapter-14/b2c14s16.rpy:328
translate deutsch b2c14s16_91974cb3:

    # rg "Morgie. Please."
    rg "Morgie. Bitte."

