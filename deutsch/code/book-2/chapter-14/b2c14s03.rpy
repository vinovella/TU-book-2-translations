# game/code/book-2/chapter-14/b2c14s03.rpy:13
translate deutsch b2c14s03_475102ad:

    # mc "Phoebe..."
    mc "Phoebe..."

# game/code/book-2/chapter-14/b2c14s03.rpy:14
translate deutsch b2c14s03_74df0204:

    # pm "..."
    pm "..."

# game/code/book-2/chapter-14/b2c14s03.rpy:18
translate deutsch b2c14s03_c436491c:

    # pm "Thank god you're okay."
    pm "Gott sei Dank geht es dir gut."

# game/code/book-2/chapter-14/b2c14s03.rpy:27
translate deutsch b2c14s03_27d1fd0f:

    # pm "Mm."
    pm "Mm."

# game/code/book-2/chapter-14/b2c14s03.rpy:33
translate deutsch b2c14s03_a21f52a9:

    # mc "I'm fine. Not a scratch."
    mc "Mir geht's gut. Kein Kratzer."

# game/code/book-2/chapter-14/b2c14s03.rpy:34
translate deutsch b2c14s03_0d9d565b:

    # mc "Doctor Howerton wasn't so lucky."
    mc "Doctor Howerton hatte nicht so viel Glück."

# game/code/book-2/chapter-14/b2c14s03.rpy:37
translate deutsch b2c14s03_ae0b874c:

    # pm "I heard."
    pm "Ich hab's gehört."

# game/code/book-2/chapter-14/b2c14s03.rpy:41
translate deutsch b2c14s03_493aca19:

    # pm "I-"
    pm "Ich-"

# game/code/book-2/chapter-14/b2c14s03.rpy:51
translate deutsch b2c14s03_8e21cf41:

    # pm "Ahuah..."
    pm "Ahuah..."

# game/code/book-2/chapter-14/b2c14s03.rpy:53
translate deutsch b2c14s03_2d92195f:

    # mc "I'm glad I'm okay too, Phoebe."
    mc "Ich bin auch froh, dass es mir gut geht, Phoebe."

# game/code/book-2/chapter-14/b2c14s03.rpy:55
translate deutsch b2c14s03_1be26b01:

    # pm "*chuckles dryly*"
    pm "*lacht trocken*"

# game/code/book-2/chapter-14/b2c14s03.rpy:58
translate deutsch b2c14s03_ce1ba42e:

    # mc "Did the investigating officers pick up on anything?"
    mc "Haben die ermittelnden Beamten was gefunden?"

# game/code/book-2/chapter-14/b2c14s03.rpy:61
translate deutsch b2c14s03_f022edc9:

    # pm "Nothing concrete. But I will keep a close eye on things."
    pm "Nichts Konkretes. Aber ich werde die Dinge genau im Auge behalten."

# game/code/book-2/chapter-14/b2c14s03.rpy:62
translate deutsch b2c14s03_af2a4717:

    # pm "Don't want them picking up a hair sample from you and thinking they have their killer."
    pm "Will nicht, dass die eine Haarprobe von dir nehmen und denken, sie hätten ihren Mörder."

# game/code/book-2/chapter-14/b2c14s03.rpy:66
translate deutsch b2c14s03_8c96dc74:

    # mc "Yeah, that would be bad."
    mc "Ja, das wäre schlecht."

# game/code/book-2/chapter-14/b2c14s03.rpy:70
translate deutsch b2c14s03_698c98ca:

    # pm "Let's see what you have."
    pm "Mal sehen, was du hast."

# game/code/book-2/chapter-14/b2c14s03.rpy:73
translate deutsch b2c14s03_f238bedd:

    # mc "One laptop with a security lock. Hopefully full of juicy evidence."
    mc "Ein Laptop mit Sicherheitsschloss. Hoffentlich voller saftiger Beweise."

# game/code/book-2/chapter-14/b2c14s03.rpy:74
translate deutsch b2c14s03_23b76cc3:

    # mc "So how do we break into it?"
    mc "Also wie knacken wir den?"

# game/code/book-2/chapter-14/b2c14s03.rpy:78
translate deutsch b2c14s03_b7f2974c:

    # pm "{b}We{/b} don't."
    pm "{b}Wir{/b} nicht."

# game/code/book-2/chapter-14/b2c14s03.rpy:80
translate deutsch b2c14s03_05500ff6:

    # mc "Huh?"
    mc "Was?"

# game/code/book-2/chapter-14/b2c14s03.rpy:82
translate deutsch b2c14s03_f762c0a9:

    # pm "I'll handle it, [mcname]."
    pm "Ich kümmere mich darum, [mcname]."

# game/code/book-2/chapter-14/b2c14s03.rpy:83
translate deutsch b2c14s03_31889bd6:

    # pm "You have other responsibilities."
    pm "Du hast andere Verantwortlichkeiten."

# game/code/book-2/chapter-14/b2c14s03.rpy:87
translate deutsch b2c14s03_925748a4:

    # mc "What is more important than this?"
    mc "Was ist wichtiger als das?"

# game/code/book-2/chapter-14/b2c14s03.rpy:88
translate deutsch b2c14s03_f886e937:

    # mc "We crack that laptop, and we might find the clue we've been missing."
    mc "Wenn wir den Laptop knacken, finden wir vielleicht den Hinweis, den wir vermisst haben."

# game/code/book-2/chapter-14/b2c14s03.rpy:91
translate deutsch b2c14s03_a8e605fd:

    # pm "I know, and I'll stay on it until it's done."
    pm "Ich weiß, und ich bleib dran, bis es erledigt ist."

# game/code/book-2/chapter-14/b2c14s03.rpy:92
translate deutsch b2c14s03_59e7e569:

    # pm "One of the techs must know a way to unlock it, but that will still take time."
    pm "Einer der Techniker muss bestimmt einen Weg wissen, ihn zu entsperren, aber das braucht trotzdem Zeit."

# game/code/book-2/chapter-14/b2c14s03.rpy:93
translate deutsch b2c14s03_8d116838:

    # pm "And a warrant."
    pm "Und einen Durchsuchungsbefehl."

# game/code/book-2/chapter-14/b2c14s03.rpy:96
translate deutsch b2c14s03_c2ba2c22:

    # mc "I can get the warrant."
    mc "Ich kann den Durchsuchungsbefehl besorgen."

# game/code/book-2/chapter-14/b2c14s03.rpy:99
translate deutsch b2c14s03_21d49a5c:

    # pm "[mcname]...{w} Just... calm down, please."
    pm "[mcname]...{w} Einfach... beruhig dich, bitte."

# game/code/book-2/chapter-14/b2c14s03.rpy:100
translate deutsch b2c14s03_1c7608d8:

    # pm "I cannot believe I'm saying this but..."
    pm "Ich fass es nicht, dass ich das sage, aber..."

# game/code/book-2/chapter-14/b2c14s03.rpy:101
translate deutsch b2c14s03_fd5937a1:

    # pm "You still have a job to do."
    pm "Du hast noch einen Job zu erledigen."

# game/code/book-2/chapter-14/b2c14s03.rpy:104
translate deutsch b2c14s03_45944bdc:

    # mc "I... You're right."
    mc "Ich... Du hast recht."

# game/code/book-2/chapter-14/b2c14s03.rpy:108
translate deutsch b2c14s03_999d1b76:

    # pm "Can I hear that again?"
    pm "Kann ich das nochmal hören?"

# game/code/book-2/chapter-14/b2c14s03.rpy:110
translate deutsch b2c14s03_44a59604:

    # mc "You're right, Phoebe."
    mc "Du hast recht, Phoebe."

# game/code/book-2/chapter-14/b2c14s03.rpy:113
translate deutsch b2c14s03_351c099c:

    # mc "I have to stick close to the groups."
    mc "Ich muss nah an den Gruppen dranbleiben."

# game/code/book-2/chapter-14/b2c14s03.rpy:114
translate deutsch b2c14s03_d8ea8039:

    # mc "Especially the leaders."
    mc "Besonders die Anführer."

# game/code/book-2/chapter-14/b2c14s03.rpy:118
translate deutsch b2c14s03_3cd31a32:

    # pm "Not too close."
    pm "Nicht zu nah."

# game/code/book-2/chapter-14/b2c14s03.rpy:121
translate deutsch b2c14s03_3bec0361:

    # mc "Yeah. Eventually they're going to find out Howerton is dead, and then they'll have to act."
    mc "Ja. Früher oder später finden sie raus, dass Howerton tot ist, und dann müssen sie handeln."

# game/code/book-2/chapter-14/b2c14s03.rpy:122
translate deutsch b2c14s03_0c7d1041:

    # mc "It's already going to hit the news tonight, if it hasn't already."
    mc "Es kommt heute Abend schon in die Nachrichten, wenn es nicht schon so ist."

# game/code/book-2/chapter-14/b2c14s03.rpy:125
translate deutsch b2c14s03_ef0458dc:

    # pm "Bingo. {w}Criminals panicking and making a mistake is one of the best ways to catch them red-handed."
    pm "Bingo. {w}Wenn Kriminelle in Panik geraten und Fehler machen, ist das eine der besten Möglichkeiten, sie auf frischer Tat zu ertappen."

# game/code/book-2/chapter-14/b2c14s03.rpy:128
translate deutsch b2c14s03_db86ab2e:

    # mc "So it looks like I'm staying undercover."
    mc "Also sieht es so aus, als bleib ich im Undercover."

# game/code/book-2/chapter-14/b2c14s03.rpy:130
translate deutsch b2c14s03_5b375832:

    # pm "Don't look so glum."
    pm "Sieh nicht so düster drein."

# game/code/book-2/chapter-14/b2c14s03.rpy:134
translate deutsch b2c14s03_765e4886:

    # pm "We're really close, [mcname]."
    pm "Wir sind echt nah dran, [mcname]."

# game/code/book-2/chapter-14/b2c14s03.rpy:135
translate deutsch b2c14s03_4c8a6741:

    # pm "And anything you can discover from the leaders and members can just help build our case and make sure the charges stick."
    pm "Und alles, was du von den Anführern und Mitgliedern herausfindest, kann nur helfen, unseren Fall aufzubauen und sicherzustellen, dass die Anklagen halten."

# game/code/book-2/chapter-14/b2c14s03.rpy:136
translate deutsch b2c14s03_d705586c:

    # pm "So be watchful, but be extra vigilant."
    pm "Also sei wachsam, aber sei besonders auf der Hut."

# game/code/book-2/chapter-14/b2c14s03.rpy:137
translate deutsch b2c14s03_9a7f69ab:

    # pm "With Howerton dead, any crook with a brain could be extra paranoid."
    pm "Seit Howerton tot ist, könnte jeder Gauner mit Verstand besonders paranoid sein."

# game/code/book-2/chapter-14/b2c14s03.rpy:141
translate deutsch b2c14s03_6f027cfc:

    # mc "For sure. This is the smart play, but I can't shake the feeling that one of my lies will catch up to me."
    mc "Auf jeden Fall. Das ist der kluge Zug, aber ich werd das Gefühl nicht los, dass eine meiner Lügen mich einholen wird."

# game/code/book-2/chapter-14/b2c14s03.rpy:142
translate deutsch b2c14s03_6e8f4e5a:

    # mc "Sooner than later."
    mc "Früher als später."

# game/code/book-2/chapter-14/b2c14s03.rpy:145
translate deutsch b2c14s03_30920941:

    # pm "It's risky. But we've made it this far."
    pm "Es ist riskant. Aber wir haben es so weit geschafft."

# game/code/book-2/chapter-14/b2c14s03.rpy:146
translate deutsch b2c14s03_b585225a:

    # pm "But if you think it's too much-"
    pm "Aber wenn du denkst, es ist zu viel-"

# game/code/book-2/chapter-14/b2c14s03.rpy:148
translate deutsch b2c14s03_dec6f292:

    # mc "Nope. I need to end this."
    mc "Nee. Ich muss das beenden."

# game/code/book-2/chapter-14/b2c14s03.rpy:152
translate deutsch b2c14s03_c29feaed:

    # mc "Well, if it's for the greater good, I guess I can spend a bit more time staying close to the groups."
    mc "Nun, wenn es dem größeren Wohl dient, schätz ich, kann ich noch etwas mehr Zeit damit verbringen, nah an den Gruppen zu bleiben."

# game/code/book-2/chapter-14/b2c14s03.rpy:153
translate deutsch b2c14s03_6bcd355f:

    # mc "I'd hate to miss something {i}important{/i}."
    mc "Ich würde es hassen, etwas {i}Wichtiges{/i} zu verpassen."

# game/code/book-2/chapter-14/b2c14s03.rpy:156
translate deutsch b2c14s03_63e98ab8:

    # pm "Exactly."
    pm "Genau."

# game/code/book-2/chapter-14/b2c14s03.rpy:159
translate deutsch b2c14s03_fd0c79be:

    # mc "Call or text me the minute you crack the code, Phoebe."
    mc "Ruf mich an oder schreib mir, in dem Moment, wo du den Code knackst, Phoebe."

# game/code/book-2/chapter-14/b2c14s03.rpy:160
translate deutsch b2c14s03_f9175f17:

    # mc "I don't want to miss out."
    mc "Ich will nichts verpassen."

# game/code/book-2/chapter-14/b2c14s03.rpy:164
translate deutsch b2c14s03_0c1fa1c9:

    # pm "You won't."
    pm "Wirst du nicht."

