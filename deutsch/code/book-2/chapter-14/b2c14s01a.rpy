# game/code/book-2/chapter-14/b2c14s01a.rpy:22
translate deutsch b2c14s01a_dbc9c5b2:

    # mct "Oh shit."
    mct "Oh scheiße."

# game/code/book-2/chapter-14/b2c14s01a.rpy:25
translate deutsch b2c14s01a_93e2b882:

    # mct "I need to tell Brigitta I'm going to check out Doctor Howerton."
    mct "Ich muss Brigitta sagen, dass ich Doctor Howerton überprüfen werde."

# game/code/book-2/chapter-14/b2c14s01a.rpy:26
translate deutsch b2c14s01a_ba35a4ce:

    # mct "Like it or not, we both discovered the clue, and if I don't keep her in the loop, she might do something crazy."
    mct "Ob es ihr passt oder nicht, wir haben den Hinweis beide entdeckt, und wenn ich sie nicht auf dem Laufenden halte, macht sie vielleicht was Verrücktes."

# game/code/book-2/chapter-14/b2c14s01a.rpy:33
translate deutsch b2c14s01a_1d95a726:

    # mc "Can you meet me?"
    mc "Kannst du mich treffen?"

# game/code/book-2/chapter-14/b2c14s01a.rpy:39
translate deutsch b2c14s01a_fee1bcda:

    # mct "I hope this isn't a mistake."
    mct "Ich hoffe, das ist kein Fehler."

# game/code/book-2/chapter-14/b2c14s01a.rpy:43
translate deutsch b2c14s01a_a1ae8f32:

    # ba "What's so important?"
    ba "Was ist so wichtig?"

# game/code/book-2/chapter-14/b2c14s01a.rpy:47
translate deutsch b2c14s01a_858ed58a:

    # mc "Thanks for coming."
    mc "Danke, dass du kommst."

# game/code/book-2/chapter-14/b2c14s01a.rpy:50
translate deutsch b2c14s01a_9fadd6b1:

    # ba "Yeah well, don't get used to it."
    ba "Ja na, gewöhn dir nicht dran."

# game/code/book-2/chapter-14/b2c14s01a.rpy:51
translate deutsch b2c14s01a_511397bd:

    # ba "...{w} It sounded important."
    ba "...{w} Es klang wichtig."

# game/code/book-2/chapter-14/b2c14s01a.rpy:54
translate deutsch b2c14s01a_2844561c:

    # mc "I'm going to go to the Doctor's office today. And find out more about his connection to Harlan."
    mc "Ich gehe heute zum Arztbüro. Und finde mehr über seine Verbindung zu Harlan raus."

# game/code/book-2/chapter-14/b2c14s01a.rpy:57
translate deutsch b2c14s01a_25dde967:

    # ba "Don't be an idiot."
    ba "Sei kein Idiot."

# game/code/book-2/chapter-14/b2c14s01a.rpy:58
translate deutsch b2c14s01a_cc041c94:

    # ba "We should go together."
    ba "Wir sollten zusammen gehen."

# game/code/book-2/chapter-14/b2c14s01a.rpy:62
translate deutsch b2c14s01a_b332c0ac:

    # ba "And if he doesn't feel like talking, I'll convince him."
    ba "Und wenn er keine Lust hat zu reden, überzeuge ich ihn."

# game/code/book-2/chapter-14/b2c14s01a.rpy:65
translate deutsch b2c14s01a_f158e23d:

    # mc "Ah yeah. Great idea. I can see it now, volleyball player that nearly evaded arrest for drugs caught beating up doctor."
    mc "Ah ja. Tolle Idee. Ich seh's schon vor mir, Volleyballspielerin, die knapp einer Festnahme wegen Drogen entkommen ist, erwischt, wie sie einen Arzt verprügelt."

# game/code/book-2/chapter-14/b2c14s01a.rpy:68
translate deutsch b2c14s01a_d5745eea:

    # ba "Shaddup."
    ba "Halt die Fresse."

# game/code/book-2/chapter-14/b2c14s01a.rpy:71
translate deutsch b2c14s01a_1bdac5cd:

    # mc "Listen, it will work better if just one of us goes. Keeps a lower profile, you know."
    mc "Hör mal, es funktioniert besser, wenn nur einer von uns geht. Hält uns unauffälliger, weißt du."

# game/code/book-2/chapter-14/b2c14s01a.rpy:74
translate deutsch b2c14s01a_2f7168a1:

    # ba "So why should it be you and not me?"
    ba "Also warum du und nicht ich?"

# game/code/book-2/chapter-14/b2c14s01a.rpy:80
translate deutsch b2c14s01a_733567a1:

    # mc "Come on, Brigitta. You're not exactly a people person."
    mc "Komm schon, Brigitta. Du bist nicht gerade der Menschenfreund-Typ."

# game/code/book-2/chapter-14/b2c14s01a.rpy:81
translate deutsch b2c14s01a_151b3f5e:

    # mc "More of a pissed-off person."
    mc "Eher so der genervte Typ."

# game/code/book-2/chapter-14/b2c14s01a.rpy:84
translate deutsch b2c14s01a_169ea0e9:

    # ba "Yeah, because most people are idiots who piss me off."
    ba "Ja, weil die meisten Menschen Idioten sind, die mich nerven."

# game/code/book-2/chapter-14/b2c14s01a.rpy:86
translate deutsch b2c14s01a_09e52a4c:

    # mc "You see my point."
    mc "Du verstehst schon, was ich meine."

# game/code/book-2/chapter-14/b2c14s01a.rpy:89
translate deutsch b2c14s01a_c197d8e3:

    # ba "Shhh. Whatever."
    ba "Pscht. Egal."

# game/code/book-2/chapter-14/b2c14s01a.rpy:96
translate deutsch b2c14s01a_9e59f655:

    # mc "I'm going to go in and complain about some stomach and back pain."
    mc "Ich geh rein und beschwere mich über Bauch- und Rückenschmerzen."

# game/code/book-2/chapter-14/b2c14s01a.rpy:97
translate deutsch b2c14s01a_3908c576:

    # mc "You really want this asshole touching you up and taking your vitals."
    mc "Du willst wirklich, dass dieser Arschloch dich abtastet und deine Vitalwerte misst."

# game/code/book-2/chapter-14/b2c14s01a.rpy:100
translate deutsch b2c14s01a_c7020b2d:

    # ba "Fine fine. We'll do it your way."
    ba "Gut gut. Wir machen's auf deine Weise."

# game/code/book-2/chapter-14/b2c14s01a.rpy:104
translate deutsch b2c14s01a_0d130c47:

    # ba "*sighs* I'll be glad with this shit behind us."
    ba "*seufzt* Ich bin froh, wenn dieser Scheiß hinter uns ist."

# game/code/book-2/chapter-14/b2c14s01a.rpy:105
translate deutsch b2c14s01a_7fa5ce26:

    # ba "And we can stop- I mean..."
    ba "Und wir können aufhören- ich meine..."

# game/code/book-2/chapter-14/b2c14s01a.rpy:106
translate deutsch b2c14s01a_76c2a1f3:

    # ba "We can focus on volleyball and the team."
    ba "Wir können uns auf Volleyball und das Team konzentrieren."

# game/code/book-2/chapter-14/b2c14s01a.rpy:113
translate deutsch b2c14s01a_a50d1394:

    # mc "I don't think you want to stop the other things we've been doing while looking into Harlan's shit."
    mc "Ich glaube nicht, dass du die anderen Dinge stoppen willst, die wir gemacht haben, während wir Harlans Scheiß durchleuchtet haben."

# game/code/book-2/chapter-14/b2c14s01a.rpy:116
translate deutsch b2c14s01a_c3a0b629:

    # ba "I have no idea what you're talking about."
    ba "Keine Ahnung, wovon du redest."

# game/code/book-2/chapter-14/b2c14s01a.rpy:117
translate deutsch b2c14s01a_3b2cbba1:

    # ba "Heh.{w} Now wipe that smirk off your face, idiot."
    ba "Heh.{w} Jetzt wisch dir das Grinsen aus dem Gesicht, Idiot."

# game/code/book-2/chapter-14/b2c14s01a.rpy:124
translate deutsch b2c14s01a_30d6e571:

    # mc "Yeah. The sooner the better."
    mc "Ja. Je früher, desto besser."

# game/code/book-2/chapter-14/b2c14s01a.rpy:126
translate deutsch b2c14s01a_fdf130ed:

    # mc "Alright, I'm off. I'll text you any new stuff I find."
    mc "Gut, ich geh. Ich schreib dir, wenn ich was Neues finde."

# game/code/book-2/chapter-14/b2c14s01a.rpy:130
translate deutsch b2c14s01a_e5645a03:

    # ba "[mcname]."
    ba "[mcname]."

# game/code/book-2/chapter-14/b2c14s01a.rpy:135
translate deutsch b2c14s01a_46e4f3ad:

    # ba "You should, I don't know, just be careful."
    ba "Du solltest, keine Ahnung, einfach vorsichtig sein."

# game/code/book-2/chapter-14/b2c14s01a.rpy:138
translate deutsch b2c14s01a_deeda9ab:

    # ba "Any normal dumbass ideas you have, ignore them."
    ba "Alle normalen bescheuerten Ideen, die du hast, ignorier sie."

# game/code/book-2/chapter-14/b2c14s01a.rpy:139
translate deutsch b2c14s01a_3a27c664:

    # ba "If this guy is working for Harlan, there could be money involved, and he could do something stupid."
    ba "Wenn dieser Typ für Harlan arbeitet, könnte Geld im Spiel sein, und er könnte was Dummes machen."

# game/code/book-2/chapter-14/b2c14s01a.rpy:145
translate deutsch b2c14s01a_54174071:

    # mc "Ah. You're really starting to care about your fuck buddy."
    mc "Ah. Dir fängst du wirklich was an deinem Fickbuddy an."

# game/code/book-2/chapter-14/b2c14s01a.rpy:149
translate deutsch b2c14s01a_05bfc963:

    # ba "I wouldn't piss on you if you were on fire."
    ba "Ich würde dir nicht mal pinkeln, wenn du brennst."

# game/code/book-2/chapter-14/b2c14s01a.rpy:150
translate deutsch b2c14s01a_97bdbd32:

    # ba "But, you're not as shitty as Harlan."
    ba "Aber du bist nicht so scheiße wie Harlan."

# game/code/book-2/chapter-14/b2c14s01a.rpy:153
translate deutsch b2c14s01a_2e996f10:

    # ba "And I'll be really glad when that asshole is done screwing with my life!"
    ba "Und ich bin echt froh, wenn dieser Arschloch aufhört, mein Leben zu ruinieren!"

# game/code/book-2/chapter-14/b2c14s01a.rpy:156
translate deutsch b2c14s01a_6a91bbd7:

    # ba "Plus, if we can send him away, then the team won't get disrupted anymore."
    ba "Außerdem, wenn wir ihn wegschaffen können, wird das Team nicht mehr gestört."

# game/code/book-2/chapter-14/b2c14s01a.rpy:159
translate deutsch b2c14s01a_f52979b1:

    # mc "Deep down, you really care about us."
    mc "Tief drinnen liegt uns dir wirklich was."

# game/code/book-2/chapter-14/b2c14s01a.rpy:161
translate deutsch b2c14s01a_02759e7c:

    # ba "Nah. You guys all really suck, and we probably won't even make it to nationals."
    ba "Nä. Ihr seid alle richtig mies, und wir schaffen es wahrscheinlich nicht mal zur Landesmeisterschaft."

# game/code/book-2/chapter-14/b2c14s01a.rpy:164
translate deutsch b2c14s01a_50ab17d8:

    # ba "But you are {b}my fucking team {/b}."
    ba "Aber ihr seid {b}mein verdammtes Team{/b}."

# game/code/book-2/chapter-14/b2c14s01a.rpy:168
translate deutsch b2c14s01a_23e0f57e:

    # ba "So don't be stupid, and don't get caught."
    ba "Also sei nicht dumm, und lass dich nicht erwischen."

# game/code/book-2/chapter-14/b2c14s01a.rpy:171
translate deutsch b2c14s01a_dc16ebcd:

    # mc "Got it."
    mc "Verstanden."

# game/code/book-2/chapter-14/b2c14s01a.rpy:177
translate deutsch b2c14s01a_181b3f87:

    # mct "Best to play it cool."
    mct "Am besten, du machst es ruhig."

# game/code/book-2/chapter-14/b2c14s01a.rpy:178
translate deutsch b2c14s01a_6656d256:

    # mc "Thanks, Brigitta. I didn't think about that."
    mc "Danke, Brigitta. Daran hab ich nicht gedacht."

# game/code/book-2/chapter-14/b2c14s01a.rpy:181
translate deutsch b2c14s01a_cfb7a1b9:

    # mc "I'll text you once I have something."
    mc "Ich schreib dir, sobald ich was hab."

# game/code/book-2/chapter-14/b2c14s01a.rpy:184
translate deutsch b2c14s01a_354eb2f7:

    # ba "You fucking better. Don't leave me in the dark again."
    ba "Das machst du besser. Lass mich nicht wieder im Dunkeln."

# game/code/book-2/chapter-14/b2c14s01a.rpy:190
translate deutsch b2c14s01a_bf962d97:

    # mc "I'll be there and back before you know it."
    mc "Ich bin hin und zurück, bevor du's merkst."

# game/code/book-2/chapter-14/b2c14s01a.rpy:193
translate deutsch b2c14s01a_91485acc:

    # ba "Tch. Yeah, at that speed you'll probably miss something."
    ba "Tch. Ja, bei dem Tempo übersiehst du wahrscheinlich was."

# game/code/book-2/chapter-14/b2c14s01a.rpy:194
translate deutsch b2c14s01a_b9cf941b:

    # ba "Then I'll have to go fix your fuckup."
    ba "Dann muss ich deinen Mist wieder ausbügeln."

# game/code/book-2/chapter-14/b2c14s01a.rpy:197
translate deutsch b2c14s01a_5fbab194:

    # mc "Just like old times."
    mc "Genau wie früher."

# game/code/book-2/chapter-14/b2c14s01a.rpy:201
translate deutsch b2c14s01a_2e6a217f:

    # ba "Just... do it and let me know what you find."
    ba "Einfach... mach's und sag mir, was du findest."

# game/code/book-2/chapter-14/b2c14s01a.rpy:204
translate deutsch b2c14s01a_93dfa314:

    # mc "Will do."
    mc "Mach ich."

# game/code/book-2/chapter-14/b2c14s01a.rpy:206
translate deutsch b2c14s01a_a8fc3147:

    # mct "Alright. Time to get back on task."
    mct "Gut. Zeit, wieder zur Sache zu kommen."

