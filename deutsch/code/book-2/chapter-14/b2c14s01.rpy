# game/code/book-2/chapter-14/b2c14s01.rpy:31
translate deutsch b2c14s01_2ccf6138:

    # mct "Alright, I have a little bit of time before classes."
    mct "Gut, ich hab ein bisschen Zeit vor dem Unterricht."

# game/code/book-2/chapter-14/b2c14s01.rpy:35
translate deutsch b2c14s01_50621a77:

    # mct "Then I need to go investigate Doctor Howerton."
    mct "Dann muss ich Doctor Howerton untersuchen."

# game/code/book-2/chapter-14/b2c14s01.rpy:36
translate deutsch b2c14s01_2452ebc7:

    # mct "I'm getting close, I can feel it."
    mct "Ich bin dran, das spüre ich."

# game/code/book-2/chapter-14/b2c14s01.rpy:41
translate deutsch b2c14s01_600a855c:

    # mct "I need to step up my game this week. Or those missing girls will stay missing forever."
    mct "Ich muss diese Woche zulegen. Sonst bleiben diese vermissten Mädchen für immer verschwunden."

# game/code/book-2/chapter-14/b2c14s01.rpy:45
translate deutsch b2c14s01_32dcbfec:

    # mct "Today is going to be a long day."
    mct "Heute wird ein langer Tag."

# game/code/book-2/chapter-14/b2c14s01.rpy:49
translate deutsch b2c14s01_c4202597:

    # mct "I can't believe I have an exam for English, Physics, and Geography all on the same day."
    mct "Ich kann's nicht glauben, dass ich Prüfungen in Englisch, Physik und Geographie alles am gleichen Tag habe."

# game/code/book-2/chapter-14/b2c14s01.rpy:52
translate deutsch b2c14s01_d3d9ad37:

    # mct "Diana really screwed up my schedule."
    mct "Diana hat meinen Plan total durcheinandergebracht."

# game/code/book-2/chapter-14/b2c14s01.rpy:56
translate deutsch b2c14s01_cf62be42:

    # dm "[mcname]."
    dm "[mcname]."

# game/code/book-2/chapter-14/b2c14s01.rpy:61
translate deutsch b2c14s01_33a7774f:

    # mc "Oh. Hello."
    mc "Oh. Hallo."

# game/code/book-2/chapter-14/b2c14s01.rpy:65
translate deutsch b2c14s01_e14fbd95:

    # dm "You, in my office, now."
    dm "Du, in mein Büro, sofort."

# game/code/book-2/chapter-14/b2c14s01.rpy:68
translate deutsch b2c14s01_1bf60051:

    # mc "Of course."
    mc "Natürlich."

# game/code/book-2/chapter-14/b2c14s01.rpy:71
translate deutsch b2c14s01_48bbd92e:

    # dm "You need to come with me."
    dm "Du musst mit mir kommen."

# game/code/book-2/chapter-14/b2c14s01.rpy:74
translate deutsch b2c14s01_605c6856:

    # mc "Uh. Yes, Ms. Mills."
    mc "Äh. Ja, Ms. Mills."

# game/code/book-2/chapter-14/b2c14s01.rpy:81
translate deutsch b2c14s01_d92cf3b7:

    # mct "Like I don't have enough on my plate?"
    mct "Als hätte ich nicht schon genug um die Ohren?"

# game/code/book-2/chapter-14/b2c14s01.rpy:87
translate deutsch b2c14s01_2a86dd57:

    # dm "I've got great news, [mcname]."
    dm "Ich habe tolle Neuigkeiten, [mcname]."

# game/code/book-2/chapter-14/b2c14s01.rpy:90
translate deutsch b2c14s01_eddf5dd5:

    # mc "You found the girls?"
    mc "Du hast die Mädchen gefunden?"

# game/code/book-2/chapter-14/b2c14s01.rpy:96
translate deutsch b2c14s01_26bc6eff:

    # dm "What? No. I mean... It's not that great of news."
    dm "Was? Nein. Ich meine... Es sind nicht so tolle Neuigkeiten."

# game/code/book-2/chapter-14/b2c14s01.rpy:97
translate deutsch b2c14s01_e884eb68:

    # dm "But it might be just what we need."
    dm "Aber es könnte genau das sein, was wir brauchen."

# game/code/book-2/chapter-14/b2c14s01.rpy:102
translate deutsch b2c14s01_a5907f21:

    # dm "You have inspired me, Matthew."
    dm "Du hast mich inspiriert, Matthew."

# game/code/book-2/chapter-14/b2c14s01.rpy:107
translate deutsch b2c14s01_a64e8bc0:

    # mc "Thanks."
    mc "Danke."

# game/code/book-2/chapter-14/b2c14s01.rpy:108
translate deutsch b2c14s01_349c2dec:

    # mc "Uh... In what way?"
    mc "Äh... Auf welche Weise?"

# game/code/book-2/chapter-14/b2c14s01.rpy:112
translate deutsch b2c14s01_ab32e6ab:

    # dm "I don't think every man in your position could keep his head on straight."
    dm "Ich glaube nicht, dass jeder Mann in deiner Position einen kühlen Kopf bewahren könnte."

# game/code/book-2/chapter-14/b2c14s01.rpy:113
translate deutsch b2c14s01_8027516a:

    # dm "But you've doggedly stuck to your investigation."
    dm "Aber du hast hartnäckig an deinen Ermittlungen festgehalten."

# game/code/book-2/chapter-14/b2c14s01.rpy:116
translate deutsch b2c14s01_eda57333:

    # dm "I know that there are a lot of distractions on this campus."
    dm "Ich weiß, dass es auf diesem Campus viele Ablenkungen gibt."

# game/code/book-2/chapter-14/b2c14s01.rpy:117
translate deutsch b2c14s01_215fe8f8:

    # dm "And yet, you've continued pushing forward to find our missing students."
    dm "Und trotzdem hast du dich weiter vorangetrieben, um unsere vermissten Studenten zu finden."

# game/code/book-2/chapter-14/b2c14s01.rpy:124
translate deutsch b2c14s01_56ee53c5:

    # mc "Oh. Well, I'm very humbled to hear that."
    mc "Oh. Nun, ich fühle mich sehr geehrt, das zu hören."

# game/code/book-2/chapter-14/b2c14s01.rpy:125
translate deutsch b2c14s01_83ce676d:

    # mc "Just doing my job."
    mc "Ich mache nur meinen Job."

# game/code/book-2/chapter-14/b2c14s01.rpy:128
translate deutsch b2c14s01_9da9a69b:

    # dm "Yes."
    dm "Ja."

# game/code/book-2/chapter-14/b2c14s01.rpy:132
translate deutsch b2c14s01_1d13b5e7:

    # dm "I only wish you'd been here at the start. With your cunning, I imagine you may have unlocked the truth by now."
    dm "Ich wünschte nur, du wärst von Anfang an hier gewesen. Mit deiner List hätte die Wahrheit bestimmt schon längst Licht gesehen."

# game/code/book-2/chapter-14/b2c14s01.rpy:135
translate deutsch b2c14s01_207017bf:

    # mc "It doesn't do us much good to look back."
    mc "Es bringt uns nicht viel, zurückzublicken."

# game/code/book-2/chapter-14/b2c14s01.rpy:138
translate deutsch b2c14s01_2a6afd5b:

    # dm "Just the same."
    dm "Trotzdem."

# game/code/book-2/chapter-14/b2c14s01.rpy:140
translate deutsch b2c14s01_fa2ddd7a:

    # dm "During my off-time, I've been doing what I can to help you close the case."
    dm "In meiner Freizeit habe ich getan, was ich konnte, um dir beim Lösen des Falls zu helfen."

# game/code/book-2/chapter-14/b2c14s01.rpy:143
translate deutsch b2c14s01_a31340dd:

    # mc "Really?"
    mc "Echt?"

# game/code/book-2/chapter-14/b2c14s01.rpy:146
translate deutsch b2c14s01_872d8612:

    # dm "Yes. I know you have your hands full."
    dm "Ja. Ich weiß, du hast alle Hände voll zu tun."

# game/code/book-2/chapter-14/b2c14s01.rpy:147
translate deutsch b2c14s01_b8697f39:

    # dm "When I noticed that you seemed to be focusing on two of the three groups that a number of our students appear to be involved with, I decided to pull my weight."
    dm "Als ich gemerkt habe, dass du dich auf zwei der drei Gruppen konzentrierst, in die viele unserer Studenten verwickelt zu sein scheinen, habe ich beschlossen, meinen Teil beizutragen."

# game/code/book-2/chapter-14/b2c14s01.rpy:151
translate deutsch b2c14s01_00d5aded:

    # dm "I found evidence that Professor Harlan has been meeting with a Doctor Howerton."
    dm "Ich habe Beweise gefunden, dass Professor Harlan sich mit einem Doctor Howerton trifft."

# game/code/book-2/chapter-14/b2c14s01.rpy:154
translate deutsch b2c14s01_a6be913e:

    # mc "So?"
    mc "Und?"

# game/code/book-2/chapter-14/b2c14s01.rpy:155
translate deutsch b2c14s01_dd0985c8:

    # dm "Howerton isn't part of the University staff, nor is he connected to the medical facilities near us that support the school in case of emergencies."
    dm "Howerton gehört nicht zum Personal der Universität, noch ist er mit den medizinischen Einrichtungen in unserer Nähe verbunden, die die Schule im Notfall unterstützen."

# game/code/book-2/chapter-14/b2c14s01.rpy:156
translate deutsch b2c14s01_7a34004d:

    # mc "Gotcha. Might be worth checking out."
    mc "Verstanden. Könnte sich lohnen, das mal zu überprüfen."

# game/code/book-2/chapter-14/b2c14s01.rpy:160
translate deutsch b2c14s01_eb9239f3:

    # mct "Howerton. That's the same name on the clue I found in Kara's room."
    mct "Howerton. Das ist der gleiche Name, der auf dem Hinweis stand, den ich in Karas Zimmer gefunden habe."

# game/code/book-2/chapter-14/b2c14s01.rpy:161
translate deutsch b2c14s01_fb4fb38a:

    # mct "Now I really need to have a chat with him."
    mct "Jetzt muss ich unbedingt mal mit ihm reden."

# game/code/book-2/chapter-14/b2c14s01.rpy:165
translate deutsch b2c14s01_da472736:

    # mct "Howerton.{w} Wait! That's the same name I saw scribbled on that note."
    mct "Howerton.{w} Moment! Das ist der gleiche Name, den ich auf dieser Notiz gekritzelt gesehen habe."

# game/code/book-2/chapter-14/b2c14s01.rpy:166
translate deutsch b2c14s01_1325ace1:

    # mct "He's connected to Gabbie.{w} And the Winners Club by the sound of things."
    mct "Er steht in Verbindung mit Gabbie.{w} Und dem Winners Club, wenn man den Gerüchten glauben darf."

# game/code/book-2/chapter-14/b2c14s01.rpy:169
translate deutsch b2c14s01_a1c38ffa:

    # mct "Guess it's time I got a checkup."
    mct "Scheint, als wäre es Zeit für einen Arztbesuch."

# game/code/book-2/chapter-14/b2c14s01.rpy:173
translate deutsch b2c14s01_0e335442:

    # mc "That is great news, Diana. I was worried that some of my leads had gone cold."
    mc "Das sind tolle Neuigkeiten, Diana. Ich hatte schon Sorge, dass einige meiner Spuren sich verlaufen haben."

# game/code/book-2/chapter-14/b2c14s01.rpy:176
translate deutsch b2c14s01_f2e624ac:

    # dm "Well, sounds like you've got some new information to investigate."
    dm "Nun, klingt so, als hättest du neue Informationen, die du untersuchen kannst."

# game/code/book-2/chapter-14/b2c14s01.rpy:179
translate deutsch b2c14s01_5fef48cf:

    # mc "Alright. I'll shake the tree and see what falls out."
    mc "Gut. Ich werde mal nachhaken und sehen, was dabei rauskommt."

# game/code/book-2/chapter-14/b2c14s01.rpy:187
translate deutsch b2c14s01_fda68bc5:

    # dm "I found something very strange."
    dm "Ich habe etwas sehr Seltsames gefunden."

# game/code/book-2/chapter-14/b2c14s01.rpy:188
translate deutsch b2c14s01_7189e8d0:

    # dm "It's a note with scribblings, but it looks like some shopping list that includes amphetamines and tranquilizers."
    dm "Es ist eine Notiz mit Kritzeleien, aber es sieht wie eine Einkaufsliste aus, die Amphetamine und Beruhigungsmittel umfasst."

# game/code/book-2/chapter-14/b2c14s01.rpy:191
translate deutsch b2c14s01_fedc1d14:

    # mc "So what?"
    mc "Na und?"

# game/code/book-2/chapter-14/b2c14s01.rpy:194
translate deutsch b2c14s01_0022961e:

    # dm "So this note was found during a random search of student dormitories."
    dm "Diese Notiz wurde bei einer zufälligen Durchsuchung von Studentenwohnheimen gefunden."

# game/code/book-2/chapter-14/b2c14s01.rpy:197
translate deutsch b2c14s01_0669354c:

    # mc "What? Which student?"
    mc "Was? Welcher Student?"

# game/code/book-2/chapter-14/b2c14s01.rpy:200
translate deutsch b2c14s01_ac9a693c:

    # dm "I can't confirm. Each of the three dormmates says it came from the other."
    dm "Ich kann das nicht bestätigen. Jeder der drei Zimmerbewohner sagt, es komme von den anderen."

# game/code/book-2/chapter-14/b2c14s01.rpy:201
translate deutsch b2c14s01_bad62d6b:

    # dm "But it did come with a clue. The note has two names. Someone named Xasan and one Doctor Howerton. He has an office nearby."
    dm "Aber es gab einen Hinweis. Auf der Notiz stehen zwei Namen. Jemand namens Xasan und ein Doctor Howerton. Er hat ein Büro in der Nähe."

# game/code/book-2/chapter-14/b2c14s01.rpy:205
translate deutsch b2c14s01_16c24908:

    # mct "Howerton?!{w} That's the same name I found on the clues from both the Winners Club and the Cult!"
    mct "Howerton?!{w} Das ist der gleiche Name, den ich auf den Hinweisen sowohl vom Winners Club als auch von der Kult-Gruppe gefunden habe!"

# game/code/book-2/chapter-14/b2c14s01.rpy:206
translate deutsch b2c14s01_c1658ea7:

    # mct "I can't believe he's connected to the Syndicate as well."
    mct "Ich kann nicht glauben, dass er auch mit dem Syndikat verbandelt ist."

# game/code/book-2/chapter-14/b2c14s01.rpy:211
translate deutsch b2c14s01_d8c8a62c:

    # mct "Stranger and stranger. The Winners Club doesn't mess with either of those two."
    mct "Immer seltsamer. Der Winners Club hat mit beiden Gruppen normalerweise nichts am Hut."

# game/code/book-2/chapter-14/b2c14s01.rpy:212
translate deutsch b2c14s01_7b54f397:

    # mct "It must be the syndicate."
    mct "Es muss das Syndikat sein."

# game/code/book-2/chapter-14/b2c14s01.rpy:213
translate deutsch b2c14s01_7920889c:

    # mct "One way or another, I think I really need to set a time to meet the 'good' doctor."
    mct "So oder so, ich glaube, ich muss mir wirklich Zeit nehmen, um den 'guten' Doktor zu treffen."

# game/code/book-2/chapter-14/b2c14s01.rpy:215
translate deutsch b2c14s01_eb9239f3_1:

    # mct "Howerton. That's the same name on the clue I found in Kara's room."
    mct "Howerton. Das ist der gleiche Name, der auf dem Hinweis stand, den ich in Karas Zimmer gefunden habe."

# game/code/book-2/chapter-14/b2c14s01.rpy:216
translate deutsch b2c14s01_fb4fb38a_1:

    # mct "Now I really need to have a chat with him."
    mct "Jetzt muss ich unbedingt mal mit ihm reden."

# game/code/book-2/chapter-14/b2c14s01.rpy:220
translate deutsch b2c14s01_25f40816:

    # mc "Yes. A crooked doctor could be how the girls were kidnapped so quickly."
    mc "Ja. Ein korrupter Arzt könnte erklären, warum die Mädchen so schnell entführt werden konnten."

# game/code/book-2/chapter-14/b2c14s01.rpy:221
translate deutsch b2c14s01_22eda736:

    # mc "He could have access to tranquilizers."
    mc "Er hätte Zugang zu Beruhigungsmitteln."

# game/code/book-2/chapter-14/b2c14s01.rpy:224
translate deutsch b2c14s01_b66cbea3:

    # dm "Do you think it could be something?"
    dm "Denkst du, das könnte was sein?"

# game/code/book-2/chapter-14/b2c14s01.rpy:227
translate deutsch b2c14s01_068c6b94:

    # mc "I won't know till I check it out."
    mc "Ich werd's erst wissen, wenn ich es überprüft habe."

# game/code/book-2/chapter-14/b2c14s01.rpy:230
translate deutsch b2c14s01_f7165763:

    # mc "Thanks for the information, Diana."
    mc "Danke für die Info, Diana."

# game/code/book-2/chapter-14/b2c14s01.rpy:231
translate deutsch b2c14s01_7e14d002:

    # mc "I'll let you know how it shakes out."
    mc "Ich sag dir Bescheid, was dabei rauskommt."

# game/code/book-2/chapter-14/b2c14s01.rpy:238
translate deutsch b2c14s01_f3ac520a:

    # dm "I'm... a little hesitant to share this with you."
    dm "Ich bin... etwas zögerlich, dir das mitzuteilen."

# game/code/book-2/chapter-14/b2c14s01.rpy:241
translate deutsch b2c14s01_2876efd9:

    # mc "Why?"
    mc "Warum?"

# game/code/book-2/chapter-14/b2c14s01.rpy:244
translate deutsch b2c14s01_905a2fa0:

    # dm "It's about that self-help group on campus. The one that holds... very risque meetings."
    dm "Es geht um diese Selbsthilfegruppe auf dem Campus. Die, die... sehr gewagte Treffen abhält."

# game/code/book-2/chapter-14/b2c14s01.rpy:246
translate deutsch b2c14s01_8ee0df5e:

    # mc "Yes. I remember them."
    mc "Ja. Ich erinnere mich an die."

# game/code/book-2/chapter-14/b2c14s01.rpy:247
translate deutsch b2c14s01_3ace6170:

    # dm "I found something very interesting. Someone from the cleaning services found receipts in a library trash can."
    dm "Ich habe etwas sehr Interessantes gefunden. Jemand vom Reinigungsdienst hat Quittungen in einem Mülleimer der Bibliothek gefunden."

# game/code/book-2/chapter-14/b2c14s01.rpy:250
translate deutsch b2c14s01_4ebf87c3:

    # mc "And do the receipts show?"
    mc "Und was zeigen die Quittungen?"

# game/code/book-2/chapter-14/b2c14s01.rpy:253
translate deutsch b2c14s01_f7581cf8:

    # dm "Orders of fertility drugs and birth control drugs."
    dm "Bestellungen von Fruchtbarkeitsmedikamenten und Verhütungsmitteln."

# game/code/book-2/chapter-14/b2c14s01.rpy:255
translate deutsch b2c14s01_155963de:

    # mc "It is a self-help group."
    mc "Es ist eine Selbsthilfegruppe."

# game/code/book-2/chapter-14/b2c14s01.rpy:257
translate deutsch b2c14s01_f62c350c:

    # dm "Yes. But the dosages involved in this order... the amounts ordered, seem very excessive."
    dm "Ja. Aber die Dosierungen bei dieser Bestellung... die bestellten Mengen scheinen sehr übermäßig zu sein."

# game/code/book-2/chapter-14/b2c14s01.rpy:258
translate deutsch b2c14s01_3e2bed3d:

    # dm "The drugs were supplied by a Doctor Howerton. He has an office nearby."
    dm "Die Medikamente wurden von einem Doctor Howerton geliefert. Er hat ein Büro in der Nähe."

# game/code/book-2/chapter-14/b2c14s01.rpy:259
translate deutsch b2c14s01_7ac6fa57:

    # dm "They're up to something."
    dm "Die haben irgendwas vor."

# game/code/book-2/chapter-14/b2c14s01.rpy:263
translate deutsch b2c14s01_28d6c140:

    # mct "Howerton?!{w} That's the same name I found on the clues from both the Winners Club and the Syndicate!"
    mct "Howerton?!{w} Das ist der gleiche Name, den ich auf den Hinweisen sowohl vom Winners Club als auch vom Syndikat gefunden habe!"

# game/code/book-2/chapter-14/b2c14s01.rpy:264
translate deutsch b2c14s01_3322acc0:

    # mct "I can't believe he's connected to Nia's group as well."
    mct "Ich kann nicht glauben, dass er auch mit Nias Gruppe verbandelt ist."

# game/code/book-2/chapter-14/b2c14s01.rpy:268
translate deutsch b2c14s01_da472736_1:

    # mct "Howerton.{w} Wait! That's the same name I saw scribbled on that note."
    mct "Howerton.{w} Moment! Das ist der gleiche Name, den ich auf dieser Notiz gekritzelt gesehen habe."

# game/code/book-2/chapter-14/b2c14s01.rpy:269
translate deutsch b2c14s01_cf6f297f:

    # mct "Guess I need to make an appointment with this doctor."
    mct "Scheint, ich muss einen Termin bei diesem Arzt machen."

# game/code/book-2/chapter-14/b2c14s01.rpy:273
translate deutsch b2c14s01_5be1f91c:

    # mct "Stranger and stranger. Howerton is the name of the Doctor who is providing Harlan with drugs."
    mct "Immer seltsamer. Howerton ist der Name des Arztes, der Harlan mit Drogen versorgt."

# game/code/book-2/chapter-14/b2c14s01.rpy:274
translate deutsch b2c14s01_172f5bc5:

    # mct "It can't be a coincidence."
    mct "Das kann kein Zufall sein."

# game/code/book-2/chapter-14/b2c14s01.rpy:277
translate deutsch b2c14s01_5016e88a:

    # mc "Guess it's time for me to make a doctor's appointment."
    mc "Scheint, es ist Zeit für mich, einen Arzttermin zu machen."

# game/code/book-2/chapter-14/b2c14s01.rpy:278
translate deutsch b2c14s01_4707d368:

    # mc "Thanks for the tip, Diana."
    mc "Danke für den Tipp, Diana."

# game/code/book-2/chapter-14/b2c14s01.rpy:286
translate deutsch b2c14s01_a86cb49d:

    # mct "Damn. I need to check out this doctor."
    mct "Verdammt. Ich muss mir diesen Arzt mal ansehen."

# game/code/book-2/chapter-14/b2c14s01.rpy:287
translate deutsch b2c14s01_ebfea42b:

    # mct "But I can't leave yet."
    mct "Aber ich kann noch nicht gehen."

# game/code/book-2/chapter-14/b2c14s01.rpy:298
translate deutsch b2c14s01_48af1d1d:

    # mct "Fucking midterms!"
    mct "Verdammte Midterms!"

# game/code/book-2/chapter-14/b2c14s01.rpy:309
translate deutsch b2c14s01_24b25b0f:

    # mc "*sighs*"
    mc "*seufzt*"

# game/code/book-2/chapter-14/b2c14s01.rpy:310
translate deutsch b2c14s01_4dcc09b8:

    # mct "Diana said she'd make it so my grades are all fixed."
    mct "Diana sagte, sie würde dafür sorgen, dass meine Noten alle passen."

# game/code/book-2/chapter-14/b2c14s01.rpy:311
translate deutsch b2c14s01_b13ba43f:

    # mct "But I still have to sit around for this."
    mct "Aber ich muss trotzdem hier rumhängen."

# game/code/book-2/chapter-14/b2c14s01.rpy:314
translate deutsch b2c14s01_6c6a913a:

    # pjh "The midterms will last for one hour and forty-five minutes."
    pjh "Die Midterms dauern eine Stunde und fünfundvierzig Minuten."

# game/code/book-2/chapter-14/b2c14s01.rpy:315
translate deutsch b2c14s01_5fd41092:

