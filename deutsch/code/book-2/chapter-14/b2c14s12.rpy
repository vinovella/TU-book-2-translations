    # ll "Thank you."
    ll "Danke."

# game/code/book-2/chapter-14/b2c14s12.rpy:568
translate deutsch b2c14s12_41bbf5ce:

    # "She pulls back before you can respond, her cheeks flushing, and hurries away before her composure can crack completely."
    "Sie zieht Rückseite bevor du können respond, sie cheeks flushing, und hurries away bevor sie composure können crack completely."

# game/code/book-2/chapter-14/b2c14s12.rpy:571
translate deutsch b2c14s12_d1ff70e9:

    # mct "At least one good thing came out of this mess."
    mct "An least one gut Ding kam out von this mess."

# game/code/book-2/chapter-14/b2c14s12.rpy:575
translate deutsch b2c14s12_529b6a06:

    # nv "*soft* My hero."
    nv "*sanft* Mein hero."

# game/code/book-2/chapter-14/b2c14s12.rpy:576
translate deutsch b2c14s12_71dfcf1b:

    # "There's teasing in her voice, but underneath, warmth. Gratitude. Something that looks like awe."
    "There's teasing in sie voice, aber underneath, warmth. Gratitude. Etwas that schaut mögen awe."

# game/code/book-2/chapter-14/b2c14s12.rpy:579
translate deutsch b2c14s12_83ce676d:

    # mc "Just doing my job."
    mc "Ich mache nur meinen Job."

# game/code/book-2/chapter-14/b2c14s12.rpy:582
translate deutsch b2c14s12_bd704c76:

    # nv "Is that what you do? Rescue damsels from creeps with knives?"
    nv "Ist that what du machen? Rescue damsels von creeps mit knives?"

# game/code/book-2/chapter-14/b2c14s12.rpy:586
translate deutsch b2c14s12_15423b72:

    # mc "It's a living."
    mc "It's a lebend."

# game/code/book-2/chapter-14/b2c14s12.rpy:589
translate deutsch b2c14s12_cf123aff:

    # nv "*laughs* You're something else, you know that?"
    nv "*laughs* You're etwas else, du wissen that?"

# game/code/book-2/chapter-14/b2c14s12.rpy:595
translate deutsch b2c14s12_eec2c83c:

    # mc "And yet here you are. Arm in arm."
    mc "Und aber hier du sind. Arm in Arm."

# game/code/book-2/chapter-14/b2c14s12.rpy:598
translate deutsch b2c14s12_1d5823c1:

    # nv "*smiles* Mm. Don't let it go to your head."
    nv "*smiles* Mm. Nicht let es gehen zu dein Kopf."

# game/code/book-2/chapter-14/b2c14s12.rpy:601
translate deutsch b2c14s12_81d38395:

    # mc "Wouldn't dream of it."
    mc "Würde nicht Traum von es."

# game/code/book-2/chapter-14/b2c14s12.rpy:604
translate deutsch b2c14s12_40a7062c:

    # "At the passage's edge, you pause and look back."
    "An the passage's edge, du pause und schauen Rückseite."

# game/code/book-2/chapter-14/b2c14s12.rpy:605
translate deutsch b2c14s12_40a632a7:

    # "Kara sits on her throne, watching you leave. When you meet her eyes, she smiles."
    "Kara sitzt auf sie throne, schauend du verlassen. Wenn du treffen sie Augen, sie lächelt."

# game/code/book-2/chapter-14/b2c14s12.rpy:607
translate deutsch b2c14s12_5cd964a9:

    # "It's the smile of a spider watching a fly wander deeper into her web."
    "It's the lächeln von a spider schauend a fly wander deeper into sie web."

# game/code/book-2/chapter-14/b2c14s12.rpy:610
translate deutsch b2c14s12_e0ba8842:

    # mct "Kara discarded Andrejz like a broken tool. Didn't hesitate. Didn't flinch."
    mct "Kara discarded Andrejz mögen a kaputt tool. Nicht hesitate. Nicht flinch."

# game/code/book-2/chapter-14/b2c14s12.rpy:611
translate deutsch b2c14s12_60c2c97f:

    # mct "She's just as ruthless as he was. Just smarter about hiding it."
    mct "She's nur as ruthless as er war. Nur smarter über hiding es."

# game/code/book-2/chapter-14/b2c14s12.rpy:612
translate deutsch b2c14s12_908fc483:

    # mct "One down. One to go."
    mct "One runter. One zu gehen."

# game/code/book-2/chapter-14/b2c14s12.rpy:614
translate deutsch b2c14s12_95389431:

    # mct "She thinks she just acquired a new attack dog. A loyal enforcer with a strong right hook and a convenient conscience."
    mct "Sie denkt sie nur acquired a neu attack dog. A loyal enforcer mit a stark richtig hook und a convenient conscience."

# game/code/book-2/chapter-14/b2c14s12.rpy:615
translate deutsch b2c14s12_0f9ae8a4:

    # mct "Going to be a shame when she learns I'm not as malleable as Andrejz was..."
    mct "Gehend zu sein a shame wenn sie lernt I'm nicht as malleable as Andrejz war..."

# game/code/book-2/chapter-14/b2c14s12.rpy:618
translate deutsch b2c14s12_1747338d:

    # mct "Enjoy the view while you can, Kara."
    mct "Enjoy the view während du können, Kara."

# game/code/book-2/chapter-14/b2c14s12.rpy:619
translate deutsch b2c14s12_a012ed03:

    # mct "Your turn is coming."
    mct "Dein drehen ist kommend."

