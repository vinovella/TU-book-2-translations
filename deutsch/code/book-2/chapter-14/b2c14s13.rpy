    # ll "Can you come to my room tonight? Around 9 maybe? I want to show you something special."
    ll "Kannst du heute Abend zu mir kommen? So gegen 9 vielleicht? Ich will dir etwas Besonderes zeigen."

# game/code/book-2/chapter-14/b2c14s13.rpy:75
translate deutsch b2c14s13_replay_ee80f1fb:

