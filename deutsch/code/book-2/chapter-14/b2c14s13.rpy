translate deutsch b2c14s13_replay_6f573534:

    # ll "Stay here. Just... stay."
    ll "Bleiben hier. Nur... bleiben."

# game/code/book-2/chapter-14/b2c14s13.rpy:248
translate deutsch b2c14s13_replay_ac36b19c:

    # "She retrieves a small ceramic bowl and a folded washcloth."
    "Sie retrieves a klein ceramic bowl und a folded washcloth."

# game/code/book-2/chapter-14/b2c14s13.rpy:250
translate deutsch b2c14s13_replay_78da4ffc:

    # mct "What is she...?"
    mct "What ist sie...?"

# game/code/book-2/chapter-14/b2c14s13.rpy:255
translate deutsch b2c14s13_replay_f1580fef:

    # ll "Can you... sit on the edge of the bed? And take off your shoes?"
    ll "Kannst du... auf der Bettkante sitzen? Und deine Schuhe ausziehen?"

# game/code/book-2/chapter-14/b2c14s13.rpy:257
translate deutsch b2c14s13_replay_442e4771:

    # mc "Lumi, what are you doing?"
    mc "Lumi, what sind du machend?"

