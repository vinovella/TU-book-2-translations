translate deutsch b2c14s13_replay_8621a00d:

    # ll "I just... wanted to have something of you nearby. To remind me."
    ll "Ich wollte nur... etwas von dir in meiner Nähe haben. Um mich zu erinnern."

# game/code/book-2/chapter-14/b2c14s13.rpy:113
translate deutsch b2c14s13_replay_599ff7a7:

    # mc "Remind you of what?"
    mc "Woran soll es dich erinnern?"

# game/code/book-2/chapter-14/b2c14s13.rpy:115
translate deutsch b2c14s13_replay_eb27e2c8:

    # ll "That I'm safe now."
    ll "Dass ich jetzt sicher bin."

# game/code/book-2/chapter-14/b2c14s13.rpy:116
translate deutsch b2c14s13_replay_d3fc671b:

    # mct "From his hands to mine."
    mct "Von sein hands zu meins."

# game/code/book-2/chapter-14/b2c14s13.rpy:120
translate deutsch b2c14s13_replay_2aae4434:

    # mc "Hm. I like the way that you framed it."
    mc "Hm. Ich mögen the Weg that du framed es."

# game/code/book-2/chapter-14/b2c14s13.rpy:123
translate deutsch b2c14s13_replay_64ab1cab:

    # ll "I wanted it to feel right. When you came."
    ll "Ich wollte es zu fühlen richtig. Wenn du kam."

# game/code/book-2/chapter-14/b2c14s13.rpy:126
translate deutsch b2c14s13_replay_b370fffe:

    # ll "Sit with me, please?"
    ll "Sitzen mit mich, please?"

# game/code/book-2/chapter-14/b2c14s13.rpy:129
translate deutsch b2c14s13_replay_9371ede7:

    # "The sheets are fresh, crisp."
    "The sheets sind frisch, crisp."

# game/code/book-2/chapter-14/b2c14s13.rpy:131
translate deutsch b2c14s13_replay_bc9d4361:

    # ll "[mcname]... I wanted to thank you. Properly."
    ll "[mcname]... Ich wollte zu thank du. Properly."

# game/code/book-2/chapter-14/b2c14s13.rpy:134
translate deutsch b2c14s13_replay_96df5b45:

    # mc "Lumi, this isn't... You don't have to thank me for anything."
    mc "Lumi, das ist nicht... Du musst mir für nichts danken."

# game/code/book-2/chapter-14/b2c14s13.rpy:135
translate deutsch b2c14s13_replay_49693ff8:

    # mc "You don't owe me anything."
    mc "Du nicht owe mich irgendetwas."

# game/code/book-2/chapter-14/b2c14s13.rpy:138
translate deutsch b2c14s13_replay_a3fac54a:

    # ll "But I do..."
    ll "Aber Ich machen..."

# game/code/book-2/chapter-14/b2c14s13.rpy:139
translate deutsch b2c14s13_replay_cdf13e88:

    # ll "You promised you would keep me safe. And you did."
    ll "Du promised du würde keep mich sicher. Und du tat."

# game/code/book-2/chapter-14/b2c14s13.rpy:140
translate deutsch b2c14s13_replay_0392f24f:

    # ll "Andrejz... He's gone. He can't hurt me anymore. He can't hurt anyone."
    ll "Andrejz... Er ist gegangen. Er kann mir nicht mehr wehtun. Er kann niemandem mehr wehtun."

# game/code/book-2/chapter-14/b2c14s13.rpy:141
translate deutsch b2c14s13_replay_4be25697:

    # ll "You did that. You fought for me when no one else would."
    ll "Du tat that. Du fought für mich wenn nein one else würde."

# game/code/book-2/chapter-14/b2c14s13.rpy:142
translate deutsch b2c14s13_replay_224e3a84:

    # ll "You're the only man that's ever done that for me."
    ll "Du bist der einzige Mann, der das je für mich getan hat."

# game/code/book-2/chapter-14/b2c14s13.rpy:145
translate deutsch b2c14s13_replay_86c7e883:

    # mc "I told you I would."
    mc "Ich erzählte du Ich würde."

# game/code/book-2/chapter-14/b2c14s13.rpy:148
translate deutsch b2c14s13_replay_65c2bcc3:

    # ll "I know. And that's why..."
    ll "Ich wissen. Und that's why..."

# game/code/book-2/chapter-14/b2c14s13.rpy:151
translate deutsch b2c14s13_replay_c69cb73e:

    # "She takes your hand, both of hers wrapped around your palm."
    "Sie nimmt dein Hand, both von ihr wrapped um dein palm."

# game/code/book-2/chapter-14/b2c14s13.rpy:152
translate deutsch b2c14s13_replay_7ff31d67:

    # "Lumi guides your fingers lower and presses them gently against her stomach, just below her navel. Her skin is warm through the fabric."
    "Lumi guides dein fingers lower und presses sie gently against sie stomach, nur unter sie navel. Sie skin ist warm durch the fabric."

# game/code/book-2/chapter-14/b2c14s13.rpy:154
translate deutsch b2c14s13_replay_2992912b:

    # ll "That's why I know {b}this{/b} is real."
    ll "Deshalb weiß ich, {b}dass{/b} das echt ist."

# game/code/book-2/chapter-14/b2c14s13.rpy:157
translate deutsch b2c14s13_replay_9f19ba5b:

    # mc "...What are you saying?"
    mc "...What sind du sagend?"

# game/code/book-2/chapter-14/b2c14s13.rpy:160
translate deutsch b2c14s13_replay_45597304:

    # ll "I think... that I am with child, [mcname]."
    ll "Ich denken... that Ich bin mit Kind, [mcname]."

# game/code/book-2/chapter-14/b2c14s13.rpy:162
translate deutsch b2c14s13_replay_0f07e3e3:

    # mct "...She really thinks so."
    mct "...Sie wirklich denkt also."

