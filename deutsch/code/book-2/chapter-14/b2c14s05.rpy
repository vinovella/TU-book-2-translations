# game/code/book-2/chapter-14/b2c14s05.rpy:31
translate deutsch b2c14s05_73497f43:

    # "BUZZ. BUZZ."
    "SUMM. SUMM."

# game/code/book-2/chapter-14/b2c14s05.rpy:34
translate deutsch b2c14s05_34a80ea4:

    # mct "Phoebe is calling me."
    mct "Phoebe ruft mich an."

# game/code/book-2/chapter-14/b2c14s05.rpy:44
translate deutsch b2c14s05_bc1cf2e4:

    # mc "Hey, Mom."
    mc "Hey, Mom."

# game/code/book-2/chapter-14/b2c14s05.rpy:51
translate deutsch b2c14s05_5a5cc4a4:

    # pm "I got it, [mcname]!"
    pm "Ich hab's, [mcname]!"

# game/code/book-2/chapter-14/b2c14s05.rpy:54
translate deutsch b2c14s05_b9fa910e:

    # pm "I broke the decryption on the laptop."
    pm "Ich habe die Verschlüsselung des Laptops geknackt."

# game/code/book-2/chapter-14/b2c14s05.rpy:58
translate deutsch b2c14s05_f49fff8f:

    # mc "Yeah?"
    mc "Ja?"

# game/code/book-2/chapter-14/b2c14s05.rpy:63
translate deutsch b2c14s05_7d47949c:

    # pm "Yes. Meet me at the main campus road. I'm picking you up in five."
    pm "Ja. Triff mich an der Hauptstraße des Campus. Ich hol dich in fünf Minuten ab."

# game/code/book-2/chapter-14/b2c14s05.rpy:65
translate deutsch b2c14s05_606e2d02:

    # mc "Sure."
    mc "Klar."

# game/code/book-2/chapter-14/b2c14s05.rpy:75
translate deutsch b2c14s05_55e636e2:

    # mct "Sounds like she found something big on Howerton's laptop."
    mct "Klingt so, als hätte sie was Großes auf Howertons Laptop gefunden."

# game/code/book-2/chapter-14/b2c14s05.rpy:80
translate deutsch b2c14s05_95ff9db9:

    # mct "This is where it all started."
    mct "Hier hat alles angefangen."

# game/code/book-2/chapter-14/b2c14s05.rpy:83
translate deutsch b2c14s05_45eee9e2:

    # mct "Feels like I've been working undercover for years."
    mct "Fühlt sich an, als würde ich seit Jahren Undercover arbeiten."

# game/code/book-2/chapter-14/b2c14s05.rpy:88
translate deutsch b2c14s05_6113b36b:

    # pm "Hey, Son."
    pm "Hey, Sohn."

# game/code/book-2/chapter-14/b2c14s05.rpy:90
translate deutsch b2c14s05_bc1cf2e4_1:

    # mc "Hey, Mom."
    mc "Hey, Mom."

# game/code/book-2/chapter-14/b2c14s05.rpy:98
translate deutsch b2c14s05_67e2d357:

    # "VRROOOM"
    "BRUMM"

# game/code/book-2/chapter-14/b2c14s05.rpy:101
translate deutsch b2c14s05_a94d6dc7:

    # pm "I got you a gift."
    pm "Ich hab dir ein Geschenk mitgebracht."

# game/code/book-2/chapter-14/b2c14s05.rpy:107
translate deutsch b2c14s05_932efd36:

    # mc "Ah, you shouldn't have."
    mc "Ach, das hättest du nicht tun sollen."

# game/code/book-2/chapter-14/b2c14s05.rpy:110
translate deutsch b2c14s05_4175e099:

    # mc "But I didn't get you anything."
    mc "Aber ich hab dir nichts mitgebracht."

# game/code/book-2/chapter-14/b2c14s05.rpy:115
translate deutsch b2c14s05_44436ce3:

    # pm "Just find me those girls and we'll call it even."
    pm "Find mir einfach diese Mädchen, dann sind wir quitt."

# game/code/book-2/chapter-14/b2c14s05.rpy:119
translate deutsch b2c14s05_716019b8:

    # mc "Right."
    mc "Genau."

# game/code/book-2/chapter-14/b2c14s05.rpy:122
translate deutsch b2c14s05_5218bf34:

    # mc "So where are we off to?"
    mc "Also wohin geht's?"

# game/code/book-2/chapter-14/b2c14s05.rpy:124
translate deutsch b2c14s05_13618a6e:

    # pm "Queen's Garden Mental Hospital."
    pm "Queen's Garden Nervenklinik."

# game/code/book-2/chapter-14/b2c14s05.rpy:127
translate deutsch b2c14s05_d07e5c95:

    # mc "Uh, what is this an intervention?"
    mc "Äh, ist das ein Intervention?"

# game/code/book-2/chapter-14/b2c14s05.rpy:129
translate deutsch b2c14s05_5fe7bd35:

    # pm "Haha. Nope. When I got into the laptop, I found software linked to some surveillance cameras."
    pm "Haha. Nein. Als ich in den Laptop eingedrungen bin, hab ich Software gefunden, die mit Überwachungskameras verbunden ist."

# game/code/book-2/chapter-14/b2c14s05.rpy:132
translate deutsch b2c14s05_0740bc99:

    # pm "I..."
    pm "Ich..."

# game/code/book-2/chapter-14/b2c14s05.rpy:135
translate deutsch b2c14s05_1f1359b4:

    # pm "I saw the girls!"
    pm "Ich habe die Mädchen gesehen!"

# game/code/book-2/chapter-14/b2c14s05.rpy:138
translate deutsch b2c14s05_ab2d6bd6:

    # mc "Yes. We got them!"
    mc "Ja. Wir haben sie gefunden!"

# game/code/book-2/chapter-14/b2c14s05.rpy:140
translate deutsch b2c14s05_06d2b17e:

    # pm "Almost got them."
    pm "Fast."

# game/code/book-2/chapter-14/b2c14s05.rpy:143
translate deutsch b2c14s05_81ab2ef9:

    # mc "Wait. They're at a mental hospital?"
    mc "Warte. Sie sind in einer Nervenklinik?"

# game/code/book-2/chapter-14/b2c14s05.rpy:146
translate deutsch b2c14s05_24437cba:

    # pm "Yes. It was hard to tell at first. The cameras look in on a very simple room."
    pm "Ja. Am Anfang war es schwer zu erkennen. Die Kameras blicken in einen sehr einfachen Raum."

# game/code/book-2/chapter-14/b2c14s05.rpy:149
translate deutsch b2c14s05_113dd6ab:

    # pm "But there was something about the old tile on the screen, it stuck with me."
    pm "Aber da war etwas an den alten Fliesen auf dem Bildschirm, das mir nicht mehr aus dem Kopf ging."

# game/code/book-2/chapter-14/b2c14s05.rpy:150
translate deutsch b2c14s05_1eb92490:

    # pm "Then I remembered a picture of Roger Louis Coleman."
    pm "Dann erinnerte ich mich an ein Bild von Roger Louis Coleman."

# game/code/book-2/chapter-14/b2c14s05.rpy:153
translate deutsch b2c14s05_8114a09f:

    # mc "Uh..."
    mc "Äh..."

# game/code/book-2/chapter-14/b2c14s05.rpy:154
translate deutsch b2c14s05_925b9aea:

    # mct "Where do I know that name from?"
    mct "Woher kenn ich den Namen?"

# game/code/book-2/chapter-14/b2c14s05.rpy:158
translate deutsch b2c14s05_b8de06d3:

    # mc "Oh."
    mc "Oh."

# game/code/book-2/chapter-14/b2c14s05.rpy:161
translate deutsch b2c14s05_a94594c9:

    # mc "The Bright Slasher. Always blinded his victims by overloading lights at the murder sites."
    mc "Der Bright Slasher. Hat seine Opfer immer geblendet, indem er die Lichter an den Tatorten überlastet hat."

# game/code/book-2/chapter-14/b2c14s05.rpy:162
translate deutsch b2c14s05_e9abe88c:

    # mc "He was the first person to get the death penalty in Crowning in twenty-three years."
    mc "Er war die erste Person, der in Crowning seit dreiundzwanzig Jahren die Todesstrafe drohte."

# game/code/book-2/chapter-14/b2c14s05.rpy:165
translate deutsch b2c14s05_7f4de8b2:

    # pm "Bingo. I studied him at the academy for my pathology classes. They had an interview with him while he was on death row."
    pm "Bingo. Ich habe ihn an der Akademie in meinen Pathologie-Kursen studiert. Es gab ein Interview mit ihm, während er in der Todeszelle war."

# game/code/book-2/chapter-14/b2c14s05.rpy:166
translate deutsch b2c14s05_324098cc:

    # pm "One interview, he was in a room just like the ones the girls are in. It had the same tiles."
    pm "Bei einem Interview war er in einem Raum genau wie den, in denen die Mädchen sind. Es waren die gleichen Fliesen."

# game/code/book-2/chapter-14/b2c14s05.rpy:169
translate deutsch b2c14s05_e33f732d:

    # mc "Coleman was analyzed by a psychiatrist at Queen's Garden."
    mc "Coleman wurde von einem Psychiater in Queen's Garden untersucht."

# game/code/book-2/chapter-14/b2c14s05.rpy:172
translate deutsch b2c14s05_0ddc7c59:

    # pm "Not bad, my apprentice."
    pm "Nicht schlecht, mein Lehrling."

# game/code/book-2/chapter-14/b2c14s05.rpy:174
translate deutsch b2c14s05_1eb0703b:

    # mc "Haha. Thanks."
    mc "Haha. Danke."

# game/code/book-2/chapter-14/b2c14s05.rpy:184
translate deutsch b2c14s05_ad09b856:

    # mc "Shit."
    mc "Scheiße."

# game/code/book-2/chapter-14/b2c14s05.rpy:187
translate deutsch b2c14s05_31e49eeb:

    # pm "What's the problem?"
    pm "Was ist los?"

# game/code/book-2/chapter-14/b2c14s05.rpy:189
translate deutsch b2c14s05_8eb1f968:

    # mc "Lots of witnesses. Could be anyone who is recording some video for KitKok or something."
    mc "Viele Zeugen. Es könnte jeder sein, der irgendein Video für KitKok oder so aufnimmt."

# game/code/book-2/chapter-14/b2c14s05.rpy:192
translate deutsch b2c14s05_dc993a73:

    # pm "Well, yeah, but the whole point is that after this, you can stop being undercover."
    pm "Nun ja, aber der ganze Punkt ist, dass du danach aufhören kannst, Undercover zu sein."

# game/code/book-2/chapter-14/b2c14s05.rpy:198
translate deutsch b2c14s05_88dd0744:

    # mc "It is better to play this like last time."
    mc "Es ist besser, das wie letztes Mal anzugehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:199
translate deutsch b2c14s05_61cbd1d6:

    # mc "I should only reveal I'm a cop when it is absolutely necessary."
    mc "Ich sollte nur preisgeben, dass ich Cop bin, wenn es absolut nötig ist."

# game/code/book-2/chapter-14/b2c14s05.rpy:202
translate deutsch b2c14s05_d8e86919:

    # pm "Howerton was crooked, and his partner could be worse."
    pm "Howerton war korrupt, und sein Partner könnte noch schlimmer sein."

# game/code/book-2/chapter-14/b2c14s05.rpy:203
translate deutsch b2c14s05_bf6ba9e7:

    # pm "They could be waiting in there for anyone."
    pm "Die könnten da drin auf jemanden warten."

# game/code/book-2/chapter-14/b2c14s05.rpy:206
translate deutsch b2c14s05_eaf43ed7:

    # pm "They could shoot first before ever allowing themselves to be captured."
    pm "Die könnten zuerst schießen, bevor sie sich jemals gefangen nehmen lassen."

# game/code/book-2/chapter-14/b2c14s05.rpy:209
translate deutsch b2c14s05_d094efb5:

    # mc "The cameras didn't show anyone but the girls, right?"
    mc "Die Kameras haben niemanden außer den Mädchen gezeigt, oder?"

# game/code/book-2/chapter-14/b2c14s05.rpy:211
translate deutsch b2c14s05_fc0dbf95:

    # pm "Yes."
    pm "Ja."

# game/code/book-2/chapter-14/b2c14s05.rpy:214
translate deutsch b2c14s05_a1349c2f:

    # mc "Then let's play it that whoever captured them isn't moving them."
    mc "Dann gehen wir davon aus, dass wer auch immer sie gefangen hat, sie nicht bewegt."

# game/code/book-2/chapter-14/b2c14s05.rpy:218
translate deutsch b2c14s05_479ed0f9:

    # pm "*sighs*"
    pm "*seufzt*"

# game/code/book-2/chapter-14/b2c14s05.rpy:220
translate deutsch b2c14s05_52019d6b:

    # mc "I'm just doing this the way you trained me."
    mc "Ich mach das einfach so, wie du mich ausgebildet hast."

# game/code/book-2/chapter-14/b2c14s05.rpy:223
translate deutsch b2c14s05_68e7309a:

    # pm "Then keep your phone on. I'm still going in, I'll give you cover."
    pm "Dann lass dein Handy an. Ich geh trotzdem rein, ich geb dir Deckung."

# game/code/book-2/chapter-14/b2c14s05.rpy:228
translate deutsch b2c14s05_fd0b3136:

    # mc "Phoebe, this is a mistake. I shouldn't be here. I could get seen or recorded, and then my role at the university is screwed."
    mc "Phoebe, das ist ein Fehler. Ich sollte nicht hier sein. Ich könnte gesehen oder aufgenommen werden, und dann ist meine Rolle an der Universität im Eimer."

# game/code/book-2/chapter-14/b2c14s05.rpy:232
translate deutsch b2c14s05_f4025b54:

    # pm "If anyone deserves to be here, it is you, Matthew."
    pm "Wenn jemand es verdient, hier zu sein, dann du, Matthew."

# game/code/book-2/chapter-14/b2c14s05.rpy:234
translate deutsch b2c14s05_fe8db3eb:

    # mc "I know, but it is still a risk."
    mc "Ich weiß, aber es ist trotzdem ein Risiko."

# game/code/book-2/chapter-14/b2c14s05.rpy:236
translate deutsch b2c14s05_74df0204:

    # pm "..."
    pm "..."

# game/code/book-2/chapter-14/b2c14s05.rpy:239
translate deutsch b2c14s05_662474a2:

    # pm "Well, we can still play it smart."
    pm "Nun, wir können es trotzdem klug angehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:240
translate deutsch b2c14s05_d1f34594:

    # pm "I'll go in and make a ruckus, getting the attention. If the perp is there, they'll be distracted by me."
    pm "Ich geh rein und mach Krach, lenke die Aufmerksamkeit auf mich. Wenn der Täter da ist, wird er von mir abgelenkt."

# game/code/book-2/chapter-14/b2c14s05.rpy:243
translate deutsch b2c14s05_cd64b7c7:

    # pm "And your job is to be sneaky like a mouse, and find the girls."
    pm "Und dein Job ist es, wie eine Maus herumzuschleichen und die Mädchen zu finden."

# game/code/book-2/chapter-14/b2c14s05.rpy:247
translate deutsch b2c14s05_c187431b:

    # mc "You should just get backup."
    mc "Du solltest einfach Verstärkung holen."

# game/code/book-2/chapter-14/b2c14s05.rpy:249
translate deutsch b2c14s05_fbad2f7c:

    # pm "Oh, it's coming, but we can't take the risk. Come on, Matthew."
    pm "Oh, die kommt schon, aber wir können das Risiko nicht eingehen. Komm schon, Matthew."

# game/code/book-2/chapter-14/b2c14s05.rpy:252
translate deutsch b2c14s05_2aa9b6b7:

    # pm "I need you with me on this."
    pm "Ich brauche dich hierbei an meiner Seite."

# game/code/book-2/chapter-14/b2c14s05.rpy:256
translate deutsch b2c14s05_466dfb1d:

    # mc "Alright, sounds like a plan."
    mc "Gut, klingt nach einem Plan."

# game/code/book-2/chapter-14/b2c14s05.rpy:288
translate deutsch b2c14s05_3a46fc1b:

    # pm "Alright everyone. My name is Detective Martinez of the Crowning Police Department."
    pm "Alle schön zuhören. Mein Name ist Detective Martinez von der Polizei Crowning."

# game/code/book-2/chapter-14/b2c14s05.rpy:289
translate deutsch b2c14s05_b0ab733d:

    # pm "We have a possible kidnapping slash hostage situation at this location."
    pm "Wir haben hier eine mögliche Entführungs- bzw. Geiselsituation an diesem Ort."

# game/code/book-2/chapter-14/b2c14s05.rpy:292
translate deutsch b2c14s05_6ad61419:

    # pm "I need your complete attention. Backup is right behind me, and we need to secure this building."
    pm "Ich brauche eure volle Aufmerksamkeit. Verstärkung ist direkt hinter mir, und wir müssen dieses Gebäude sichern."

# game/code/book-2/chapter-14/b2c14s05.rpy:295
translate deutsch b2c14s05_cf1dd379:

    # d2 "You can't be serious."
    d2 "Du kann nicht sein ernst."

# game/code/book-2/chapter-14/b2c14s05.rpy:298
translate deutsch b2c14s05_77424464:

    # pm "One hundred percent serious. I need you to link me up with the main administrator."
    pm "Hundertprozentig ernst. Ich brauche, dass ihr mich mit dem Hauptverwalter verbindet."

# game/code/book-2/chapter-14/b2c14s05.rpy:299
translate deutsch b2c14s05_b602e3b3:

    # pm "No one is getting in or out."
    pm "Niemand kommt rein oder raus."

# game/code/book-2/chapter-14/b2c14s05.rpy:302
translate deutsch b2c14s05_df67b0c8:

    # d2 "I mean... I'm sure it's just the staff and our patients here."
    d2 "Ich gemein... I'm sure it's nur the staff und unser patients hier."

# game/code/book-2/chapter-14/b2c14s05.rpy:304
translate deutsch b2c14s05_b43cdf73:

    # pm "Then this should be nothing more than a little afternoon distraction."
    pm "Dann sollte das nichts weiter als eine kleine Nachmittags-Ablenkung sein."

# game/code/book-2/chapter-14/b2c14s05.rpy:307
translate deutsch b2c14s05_a94234e3:

    # pm "But if I'm right, and I am, the whole city will be happy you lent a hand."
    pm "Aber wenn ich recht habe, und das habe ich, wird die ganze Stadt froh sein, dass ihr geholfen habt."

# game/code/book-2/chapter-14/b2c14s05.rpy:309
translate deutsch b2c14s05_20f9fe43:

    # d2 "Alright, then, I guess you should follow me."
    d2 "Alright, dann, Ich guess du sollte follow mich."

# game/code/book-2/chapter-14/b2c14s05.rpy:321
translate deutsch b2c14s05_f7cfd908:

    # mct "Alright, Phoebe did her part. Now I've got to do mine."
    mct "Gut, Phoebe hat ihren Teil getan. Jetzt muss ich meinen machen."

# game/code/book-2/chapter-14/b2c14s05.rpy:324
translate deutsch b2c14s05_21b9fe87:

    # mct "If I was a maniacal criminal who'd taken hostages... where would I hide them?"
    mct "Wenn ich ein manischer Verbrecher wäre, der Geiseln genommen hat... wo würde ich sie verstecken?"

# game/code/book-2/chapter-14/b2c14s05.rpy:325
translate deutsch b2c14s05_86802cac:

    # mct "They can't be too close to the entrance. With the foot traffic, someone would have found them by now."
    mct "Sie können nicht zu nah am Eingang sein. Bei dem Laufverkehr hätte sie jemand schon gefunden."

# game/code/book-2/chapter-14/b2c14s05.rpy:328
translate deutsch b2c14s05_002bda94:

    # mct "And can't be too far off the beaten path, it would be too hard to check on them."
    mct "Und nicht zu abseits gelegen, es wäre zu schwer, nach ihnen zu sehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:329
translate deutsch b2c14s05_f609deb3:

    # mc "Hmmmm."
    mc "Hmmmm."

# game/code/book-2/chapter-14/b2c14s05.rpy:332
translate deutsch b2c14s05_f3cb82f8:

    # mct "Or, Option B. Flirt up the sexy nurse."
    mct "Oder, Option B. Die sexy Krankenschwester anflirten."

# game/code/book-2/chapter-14/b2c14s05.rpy:339
translate deutsch b2c14s05_5134760c:

    # mc "Excuse me, miss?"
    mc "Entschuldigung, Fräulein?"

# game/code/book-2/chapter-14/b2c14s05.rpy:342
translate deutsch b2c14s05_9fa5a051:

    # n2 "Hello, sir. I'm afraid you can't be here, right now."
    n2 "Hello, sir. I'm verängstigt du kann nicht sein hier, richtig jetzt."

# game/code/book-2/chapter-14/b2c14s05.rpy:343
translate deutsch b2c14s05_13239ee2:

    # n2 "The police are here, and they want everyone to go to the main waiting room."
    n2 "The police sind hier, und sie wollen jeder zu gehen zu the main wartend Zimmer."

# game/code/book-2/chapter-14/b2c14s05.rpy:346
translate deutsch b2c14s05_f4cd34b8:

    # mc "Oh really? Thanks for the heads-up. I'll be going there shortly."
    mc "Oh wirklich? Danke für die Vorwarnung. Ich werde gleich dort hingehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:347
translate deutsch b2c14s05_f3ad6caa:

    # mc "But I have to handle something real quick."
    mc "Aber ich muss noch schnell was erledigen."

# game/code/book-2/chapter-14/b2c14s05.rpy:351
translate deutsch b2c14s05_06d62370:

    # n2 "And what exactly is that?"
    n2 "Und what genau ist that?"

# game/code/book-2/chapter-14/b2c14s05.rpy:354
translate deutsch b2c14s05_901ed3aa:

    # mc "Don't worry, not trying to ask you out or anything, which isn't to say I wouldn't say 'no' to your number or wishing you'd indulge me in dinner some time."
    mc "Keine Sorge, ich versuche nicht, dich auszufragen oder so, was nicht heißt, dass ich 'nein' zu deiner Nummer sagen würde, oder dass ich wünschte, du würdest mich mal zum Abendessen einladen."

# game/code/book-2/chapter-14/b2c14s05.rpy:357
translate deutsch b2c14s05_a6759189:

    # mc "People who serve the city as doctors and nurses are some of the best people in Crowning."
    mc "Menschen, die der Stadt als Ärzte und Krankenschwestern dienen, sind einige der besten Menschen in Crowning."

# game/code/book-2/chapter-14/b2c14s05.rpy:360
translate deutsch b2c14s05_fe174b8a:

    # n2 "Alright, Mr. Smooth. So if you didn't come over to ask me my number, what {i}is{/i} on your mind."
    n2 "Alright, Mr. Smooth. Also wenn du nicht kommen über zu fragen mich mein Nummer, what{i}ist{/i}auf dein Geist."

# game/code/book-2/chapter-14/b2c14s05.rpy:364
translate deutsch b2c14s05_ff30fd0b:

    # mc "*chuckles* Well, a month ago, my mom had kind of a meltdown."
    mc "*kichert* Nun, vor einem Monat hat meine Mutter so'n bisschen einen Zusammenbruch gehabt."

# game/code/book-2/chapter-14/b2c14s05.rpy:365
translate deutsch b2c14s05_ee0d51e5:

    # mc "Her baby boy, leaving the nest and going to college, you know I'm all she's got."
    mc "Ihr kleiner Junge, der aus dem Nest fliegt und aufs College geht, weißt du, ich bin alles, was sie hat."

# game/code/book-2/chapter-14/b2c14s05.rpy:368
translate deutsch b2c14s05_8968f889:

    # "The lovely woman's features soften as you spin a yarn about your mother having an episode about you leaving for college."
    "Die Züge der reizenden Frau mildern sich, als du eine Geschichte über deine Mutter erzählst, die einen Anfall hatte, weil du aufs College gehst."

# game/code/book-2/chapter-14/b2c14s05.rpy:370
translate deutsch b2c14s05_af781df8:

    # mct "The best lies are built on truths. My 'mom' definitely worried about me going to college."
    mct "Die besten Lügen bauen auf Wahrheiten auf. Meine 'Mutter' hat sich definitiv Sorgen gemacht, dass ich aufs College gehe."

# game/code/book-2/chapter-14/b2c14s05.rpy:373
translate deutsch b2c14s05_f4d0eaa9:

    # mc "Long story short, she came here for a spell and this doctor, Uh... Doctor Howerton. He was the main one who helped get her back on his feet."
    mc "Kurz gesagt, sie kam hier eine Weile her und dieser Arzt, äh... Doctor Howerton. Er war der Hauptverantwortliche, der ihr geholfen hat, wieder auf die Beine zu kommen."

# game/code/book-2/chapter-14/b2c14s05.rpy:374
translate deutsch b2c14s05_17ea05c6:

    # mc "And I've been so busy with classes, this is the first time I've had space to thank him in person."
    mc "Und ich war so beschäftigt mit dem Unterricht, das ist das erste Mal, dass ich Zeit habe, ihm persönlich zu danken."

# game/code/book-2/chapter-14/b2c14s05.rpy:379
translate deutsch b2c14s05_d2f14cfc:

    # n2 "Ah, you're a sweet young man. I'm glad your mother is doing better."
    n2 "Ah, you're a süß jung Mann. I'm glad dein Mutter ist machend better."

# game/code/book-2/chapter-14/b2c14s05.rpy:382
translate deutsch b2c14s05_a2f17521:

    # mc "Thanks. The only thing is I don't think the good doctor is at his office. Have you seen him?"
    mc "Danke. Das Einzige ist, ich glaube nicht, dass der gute Doktor in seinem Büro ist. Hast du ihn gesehen?"

# game/code/book-2/chapter-14/b2c14s05.rpy:385
translate deutsch b2c14s05_5d443313:

    # n2 "You know, I haven't seen him the last couple of days."
    n2 "Du wissen, Ich haben nicht gesehen ihn the last couple von days."

# game/code/book-2/chapter-14/b2c14s05.rpy:388
translate deutsch b2c14s05_4bd96eb9:

    # mct "Yeah, I don't think you're going to be seeing him for a while."
    mct "Ja, ich glaube nicht, dass du ihn noch eine Weile sehen wirst."

# game/code/book-2/chapter-14/b2c14s05.rpy:391
translate deutsch b2c14s05_1a230082:

    # n2 "You know, if he's not in his office, you should check the old wing. I think he was helping with renovations over there."
    n2 "Du wissen, wenn he's nicht in sein office, du sollte check the alt wing. Ich denken er war helfend mit renovations über da."

# game/code/book-2/chapter-14/b2c14s05.rpy:394
translate deutsch b2c14s05_324dbdee:

    # mc "Ah, you're a lifesaver. I'll go see if he is there and then head to main waiting room."
    mc "Ach, du bist ein Lebensretter. Ich geh mal sehen, ob er dort ist, und dann geh ich ins Hauptwartezimmer."

# game/code/book-2/chapter-14/b2c14s05.rpy:397
translate deutsch b2c14s05_2d4ff69e:

    # n2 "Good. Don't make me chase you down."
    n2 "Gut. Nicht machen mich chase du runter."

# game/code/book-2/chapter-14/b2c14s05.rpy:403
translate deutsch b2c14s05_e1c7ac50:

    # mct "Alright, time to check out the old wing."
    mct "Gut, Zeit, den alten Flügel zu untersuchen."

# game/code/book-2/chapter-14/b2c14s05.rpy:410
translate deutsch b2c14s05_90d80f89:

    # mct "Please... let them be here..."
    mct "Bitte... lass sie hier sein..."

# game/code/book-2/chapter-14/b2c14s05.rpy:417
translate deutsch b2c14s05_2666f31e:

    # mct "Hello, what's this then?"
    mct "Hallo, was ist das denn?"

# game/code/book-2/chapter-14/b2c14s05.rpy:420
translate deutsch b2c14s05_0f7518e3:

    # mct "I don't think mental hospitals actually put padlocks on their doors."
    mct "Ich glaube nicht, dass Nervenkliniken wirklich Vorhängeschlösser an ihren Türen anbringen."

# game/code/book-2/chapter-14/b2c14s05.rpy:421
translate deutsch b2c14s05_cc052522:

    # mct "The room is marked as storage, but it's worth a peek."
    mct "Der Raum ist als Lager markiert, aber ein Blick rein lohnt sich."

# game/code/book-2/chapter-14/b2c14s05.rpy:425
translate deutsch b2c14s05_d230b8de:

    # "CLICK."
    "KLICK."

# game/code/book-2/chapter-14/b2c14s05.rpy:430
translate deutsch b2c14s05_6c31f2e8:

    # "The room is dark and foreboding. You feel the hairs sticking up across your neck with each step."
    "Der Raum ist dunkel und unheimlich. Du spürst, wie sich dir die Nackenhaare bei jedem Schritt aufstellen."

# game/code/book-2/chapter-14/b2c14s05.rpy:433
translate deutsch b2c14s05_21364064:

    # "Then you see it, shapes in the darkness. Your eyes adjust and you finally see..."
    "Dann siehst du es, Gestalten in der Dunkelheit. Deine Augen gewöhnen sich an und du siehst endlich..."

# game/code/book-2/chapter-14/b2c14s05.rpy:434
translate deutsch b2c14s05_229dc5bc:

    # "THEM!"
    "SIE!"

# game/code/book-2/chapter-14/b2c14s05.rpy:439
translate deutsch b2c14s05_4869cf64:

    # mct "What the hell?"
    mct "Was zur Hölle?"

# game/code/book-2/chapter-14/b2c14s05.rpy:441
translate deutsch b2c14s05_5b62cb5b:

    # "The three missing girls that you have been looking for across many days and hours of intensive work are there."
    "Die drei vermissten Mädchen, nach denen du seit vielen Tagen und Stunden intensiver Arbeit suchst, sind da."

# game/code/book-2/chapter-14/b2c14s05.rpy:442
translate deutsch b2c14s05_b7ba7a39:

    # "For a moment your heart races, fearing they are dead. But as you get closer, you notice IVs attached to each of them."
    "Einen Moment lang rast dein Herz, aus Angst, sie wären tot. Aber als du näher kommst, bemerkst du Infusionen, die an jeder von ihnen befestigt sind."

# game/code/book-2/chapter-14/b2c14s05.rpy:443
translate deutsch b2c14s05_dc6fdf90:

    # mct "They're breathing.{w} They're alive."
    mct "Sie atmen.{w} Sie leben."

# game/code/book-2/chapter-14/b2c14s05.rpy:446
translate deutsch b2c14s05_c4cc76a9:

    # "Moving forward, you meet with Leia and find her breathing, but hardly responsive."
    "Als du weitergehst, triffst du auf Leia und stellst fest, dass sie atmet, aber kaum ansprechbar ist."

# game/code/book-2/chapter-14/b2c14s05.rpy:448
translate deutsch b2c14s05_0d611b2a:

    # mc "Leia. You're okay. Can you hear me?"
    mc "Leia. Es geht dir gut. Kannst du mich hören?"

# game/code/book-2/chapter-14/b2c14s05.rpy:453
translate deutsch b2c14s05_e4d00bb0:

    # mc "Maria. It's going to be alright. I promise you."
    mc "Maria. Es wird alles gut. Ich verspreche es dir."

# game/code/book-2/chapter-14/b2c14s05.rpy:455
translate deutsch b2c14s05_bbdcb3d6:

    # mfk "*groggy noises*"
    mfk "*schläfrige Geräusche*"

# game/code/book-2/chapter-14/b2c14s05.rpy:458
translate deutsch b2c14s05_f3f8a066:

    # mct "Whatever is in there, it must be messing with them."
    mct "Was immer da drin ist, es muss sie durcheinanderbringen."

# game/code/book-2/chapter-14/b2c14s05.rpy:459
translate deutsch b2c14s05_e3aea4c7:

    # mct "Keeping them half asleep. The perfect hostages."
    mct "Hält sie halb schlafend. Die perfekten Geiseln."

# game/code/book-2/chapter-14/b2c14s05.rpy:466
translate deutsch b2c14s05_0718fbe4:

    # mc "Klara. Klara Crawford."
    mc "Klara. Klara Crawford."

# game/code/book-2/chapter-14/b2c14s05.rpy:467
translate deutsch b2c14s05_4e85cb4d:

    # mc "Hello?"
    mc "Hallo?"

# game/code/book-2/chapter-14/b2c14s05.rpy:473
translate deutsch b2c14s05_0e0412e8:

    # mct "Fuck!"
    mct "Fick!"

# game/code/book-2/chapter-14/b2c14s05.rpy:475
translate deutsch b2c14s05_a30ab42d:

    # "You swing into action on reflex, prepared to strike."
    "Du handelst reflexartig, bereit zuzuschlagen."

# game/code/book-2/chapter-14/b2c14s05.rpy:476
translate deutsch b2c14s05_ad4c2b5d:

    # "To your relief, you pull back your strike at the last second, realizing that it was Klara who touched you."
    "Zu deiner Erleichterung holst du deinen Schlag im letzten Moment zurück, als du erkennst, dass es Klara war, die dich berührt hat."

# game/code/book-2/chapter-14/b2c14s05.rpy:482
translate deutsch b2c14s05_f5845b19:

    # mc "It's okay, Klara. I got you..."
    mc "Es ist okay, Klara. Ich hab dich..."

# game/code/book-2/chapter-14/b2c14s05.rpy:484
translate deutsch b2c14s05_4c58b9b3:

    # kc "*weakly* Please don't leave."
    kc "*schwach* Bitte geh nicht weg."

# game/code/book-2/chapter-14/b2c14s05.rpy:487
translate deutsch b2c14s05_955b1906:

    # mc "I'm not. I'm just calling in my backup."
    mc "Tu ich nicht. Ich rufe nur meine Verstärkung an."

# game/code/book-2/chapter-14/b2c14s05.rpy:490
translate deutsch b2c14s05_aa93b263:

    # mct "Huh..."
    mct "Häh..."

# game/code/book-2/chapter-14/b2c14s05.rpy:491
translate deutsch b2c14s05_bb9f2f22:

    # "You can't put your finger on it, but you could swear you almost saw someone at the door."
    "Du kannst es nicht genau benennen, aber du könntest schwören, dass du fast jemanden an der Tür gesehen hast."

# game/code/book-2/chapter-14/b2c14s05.rpy:493
translate deutsch b2c14s05_944fb990:

    # "But you don't see anything now, and you don't hear anything."
    "Aber jetzt siehst du nichts, und du hörst nichts."

# game/code/book-2/chapter-14/b2c14s05.rpy:496
translate deutsch b2c14s05_0f952021:

    # mct "Come out if you're hiding scumbag. Let's finish this."
    mct "Komm raus, wenn du dich versteckst, Miststück. Lass uns das beenden."

# game/code/book-2/chapter-14/b2c14s05.rpy:498
translate deutsch b2c14s05_2b35b6fe:

    # mc "..."
    mc "..."

# game/code/book-2/chapter-14/b2c14s05.rpy:505
translate deutsch b2c14s05_f4f81d5a:

    # mc "Phoebe, I found them.{w} In the old wing..."
    mc "Phoebe, ich habe sie gefunden.{w} Im alten Flügel..."

# game/code/book-2/chapter-14/b2c14s05.rpy:510
translate deutsch b2c14s05_b7dd0350:

    # mc "So, the girls were all in a drug-induced coma, right?"
    mc "Also, die Mädchen waren alle in einem drogeninduzierten Koma, richtig?"

# game/code/book-2/chapter-14/b2c14s05.rpy:511
translate deutsch b2c14s05_58e49228:

    # mc "That's the basic explanation of what you're saying, doctor?"
    mc "Das ist die grundlegende Erklärung dafür, was du sagst, Doktor?"

# game/code/book-2/chapter-14/b2c14s05.rpy:514
translate deutsch b2c14s05_e475f5fa:

    # d3 "Something along those lines. I'll have more specifics after they've been here a bit longer."
    d3 "Etwas entlang those lines. I'll haben more specifics nach they've gewesen hier a bit longer."

# game/code/book-2/chapter-14/b2c14s05.rpy:516
translate deutsch b2c14s05_c101a27d:

    # mc "How long till they can answer a few questions?"
    mc "Wie lange dauert es, bis sie ein paar Fragen beantworten können?"

# game/code/book-2/chapter-14/b2c14s05.rpy:519
translate deutsch b2c14s05_a11c177c:

    # d3 "I'm sorry, officer. I wish I had specifics. But it's certainly not going to happen in a day. Maybe not even two."
    d3 "I'm sorry, officer. Ich wünschen Ich hatte specifics. Aber it's certainly nicht gehend zu happen in a Tag. Vielleicht nicht sogar two."

# game/code/book-2/chapter-14/b2c14s05.rpy:522
translate deutsch b2c14s05_18b90ad2:

    # mc "And how long will that take?"
    mc "Und wie lange wird das dauern?"

# game/code/book-2/chapter-14/b2c14s05.rpy:523
translate deutsch b2c14s05_bcb69444:

    # mc "These girls have to know who took them."
    mc "Diese Mädchen müssen wissen, wer sie entführt hat."

# game/code/book-2/chapter-14/b2c14s05.rpy:526
translate deutsch b2c14s05_e32f8474:

    # pm "Or at least, they have to be able to give us something."
    pm "Oder wenigstens müssen sie uns irgendwas geben können."

# game/code/book-2/chapter-14/b2c14s05.rpy:531
translate deutsch b2c14s05_99c1eea4:

    # d3 "I understand the situation, officers."
    d3 "Ich understand the situation, officers."

# game/code/book-2/chapter-14/b2c14s05.rpy:532
translate deutsch b2c14s05_fcd55e41:

    # d3 "But they are now my patients, and I'm going to make sure they are given the best medical treatment after what they went through."
    d3 "Aber sie sind jetzt mein patients, und I'm gehend zu machen sure sie sind gegeben the best medical treatment nach what sie ging durch."

# game/code/book-2/chapter-14/b2c14s05.rpy:537
translate deutsch b2c14s05_0340e6ce:

    # d3 "Excuse me."
    d3 "Excuse mich."

# game/code/book-2/chapter-14/b2c14s05.rpy:540
translate deutsch b2c14s05_74df0204_1:

    # pm "..."
    pm "..."

# game/code/book-2/chapter-14/b2c14s05.rpy:553
translate deutsch b2c14s05_f045156e:

    # pm "It's okay. Whatever else, we {i}found{/i} them."
    pm "Es ist okay. Was auch immer sonst, wir haben sie {i}gefunden{/i}."

# game/code/book-2/chapter-14/b2c14s05.rpy:556
translate deutsch b2c14s05_035054cc:

    # mc "Yeah. Diana will be happy."
    mc "Ja. Diana wird froh sein."

# game/code/book-2/chapter-14/b2c14s05.rpy:560
translate deutsch b2c14s05_6c14cd40:

    # mc "I guess this means that Professor Harlan and Kara are our perps."
    mc "Ich schätze, das bedeutet, dass Professor Harlan und Kara unsere Täter sind."

# game/code/book-2/chapter-14/b2c14s05.rpy:562
translate deutsch b2c14s05_92835db1:

    # pm "Yes. Klara and Maria must have gotten too close, seen something they weren't meant to see."
    pm "Ja. Klara und Maria sind ihnen wohl zu nahe gekommen, haben etwas gesehen, was sie nicht sehen sollten."

# game/code/book-2/chapter-14/b2c14s05.rpy:565
translate deutsch b2c14s05_045e583d:

    # mc "It's strange, Kara, I can see killing people, and Harlan..."
    mc "Es ist seltsam, bei Kara kann ich mir vorstellen, dass sie Leute tötet, und bei Harlan..."

# game/code/book-2/chapter-14/b2c14s05.rpy:566
translate deutsch b2c14s05_8a94efcd:

    # mc "Well, I imagined he'd have other people do it, but... You get my point."
    mc "Nun, ich hätte mir vorgestellt, dass er andere dafür hernimmt, aber... Du verstehst schon, was ich meine."

# game/code/book-2/chapter-14/b2c14s05.rpy:570
translate deutsch b2c14s05_17ef3d03:

    # mc "I guess that means Harlan and Gabbie did the deed."
    mc "Ich schätze, das bedeutet, Harlan und Gabbie haben die Tat begangen."

# game/code/book-2/chapter-14/b2c14s05.rpy:573
translate deutsch b2c14s05_6a6da3ff:

    # pm "Yup. The non-jock managing an elite volleyball team."
    pm "Jupp. Der Nicht-Sportler, der ein Elit-Volleyballteam managt."

# game/code/book-2/chapter-14/b2c14s05.rpy:574
translate deutsch b2c14s05_1a63d04a:

    # pm "And the lunch lady."
    pm "Und die Kantinenfrau."

# game/code/book-2/chapter-14/b2c14s05.rpy:577
translate deutsch b2c14s05_e9760cd3:

    # pm "Shame it wasn't some butler working for the Winners Club. That would be page one news for sure."
    pm "Schade, dass es kein Butler war, der für den Winners Club arbeitet. Das wäre sicher Titelseite gewesen."

# game/code/book-2/chapter-14/b2c14s05.rpy:578
translate deutsch b2c14s05_37cff8de:

    # pm "But something is eating you."
    pm "Aber etwas nagt an dir."

# game/code/book-2/chapter-14/b2c14s05.rpy:583
translate deutsch b2c14s05_ad1de528:

    # mc "Yeah. Isn't it strange that after all this time...{w} This is how the case ends?"
    mc "Ja. Ist es nicht seltsam, dass nach all dieser Zeit...{w} So endet der Fall?"

# game/code/book-2/chapter-14/b2c14s05.rpy:587
translate deutsch b2c14s05_36ef886f:

    # mc "Looks like Gabbie and Kara are going to be fitted for some prison coveralls."
    mc "Sieht so aus, als würden Gabbie und Kara bald Gefängnisuniformen tragen."

# game/code/book-2/chapter-14/b2c14s05.rpy:589
translate deutsch b2c14s05_58e8545c:

    # pm "I'm sure they'll look fabulous in them."
    pm "Ich bin sicher, die werden ihnen fabelhaft stehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:592
translate deutsch b2c14s05_d1f7b26c:

    # mc "Yeah. Kara looks good in anything."
    mc "Ja. Kara steht alles."

# game/code/book-2/chapter-14/b2c14s05.rpy:595
translate deutsch b2c14s05_fe2c54d7:

    # pm "*coughs*"
    pm "*hustet*"

# game/code/book-2/chapter-14/b2c14s05.rpy:598
translate deutsch b2c14s05_5f43ce82:

    # mc "Right. I forgot she's a wicked and manipulative bitch for a second."
    mc "Richtig. Ich hab kurz vergessen, dass sie eine böse und manipulative Schlampe ist."

# game/code/book-2/chapter-14/b2c14s05.rpy:601
translate deutsch b2c14s05_88170e5f:

    # mc "Which does beg the question. What was their endgame for this?"
    mc "Was aber die Frage aufwirft. Was war ihr Endziel damit?"

# game/code/book-2/chapter-14/b2c14s05.rpy:602
translate deutsch b2c14s05_1535a35a:

    # mc "There wasn't a random act or anything. And yet... this is where the clues lead us."
    mc "Es war keine zufällige Tat oder so. Und trotzdem... hierhin führen die Hinweise."

# game/code/book-2/chapter-14/b2c14s05.rpy:605
translate deutsch b2c14s05_843d6146:

    # mc "After all this time."
    mc "Nach all dieser Zeit."

# game/code/book-2/chapter-14/b2c14s05.rpy:607
translate deutsch b2c14s05_502e8b35:

    # pm "Meaning..."
    pm "Das heißt..."

# game/code/book-2/chapter-14/b2c14s05.rpy:610
translate deutsch b2c14s05_959e67ea:

    # mc "You know what I mean."
    mc "Du weißt, was ich meine."

# game/code/book-2/chapter-14/b2c14s05.rpy:612
translate deutsch b2c14s05_c2132a5d:

    # pm "Yeah..."
    pm "Ja..."

# game/code/book-2/chapter-14/b2c14s05.rpy:613
translate deutsch b2c14s05_d45a8d03:

    # pm "How come the girls are alive?"
    pm "Wieso leben die Mädchen noch?"

# game/code/book-2/chapter-14/b2c14s05.rpy:616
translate deutsch b2c14s05_b180829a:

    # mc "Bingo."
    mc "Bingo."

# game/code/book-2/chapter-14/b2c14s05.rpy:619
translate deutsch b2c14s05_ac1ee120:

    # pm "Anyone ever tell you, 'take the win'?"
    pm "Hat dir schon mal jemand gesagt, 'nehm den Sieg mit'?"

# game/code/book-2/chapter-14/b2c14s05.rpy:621
translate deutsch b2c14s05_0f63f9a3:

    # mc "My training officer helped to forge an inquisitive mind."
    mc "Meine Ausbilderin hat dazu beigetragen, einen wissbegierigen Verstand in mir zu schmieden."

# game/code/book-2/chapter-14/b2c14s05.rpy:624
translate deutsch b2c14s05_196345c1:

    # pm "*laughing* Damn her."
    pm "*lacht* Verdammte."

# game/code/book-2/chapter-14/b2c14s05.rpy:627
translate deutsch b2c14s05_0ebe9de5:

    # mc "It's nice to hear you laugh."
    mc "Es ist schön, dich lachen zu hören."

# game/code/book-2/chapter-14/b2c14s05.rpy:629
translate deutsch b2c14s05_98a73afd:

    # pm "In this job, it's good to celebrate the victories. The small and the big."
    pm "In diesem Job ist es gut, die Siege zu feiern. Die kleinen und die großen."

# game/code/book-2/chapter-14/b2c14s05.rpy:633
translate deutsch b2c14s05_5aaf9285:

    # pm "My only question is which one killed Howerton."
    pm "Meine einzige Frage ist, wer von beiden Howerton getötet hat."

# game/code/book-2/chapter-14/b2c14s05.rpy:636
translate deutsch b2c14s05_05ced916:

    # mc "I'll just be glad to see who turns on who first."
    mc "Ich freu mich einfach drauf, zu sehen, wer sich zuerst gegen den anderen wendet."

# game/code/book-2/chapter-14/b2c14s05.rpy:638
translate deutsch b2c14s05_058dc3a6:

    # pm "Oh yes. No honor among thieves."
    pm "Oh ja. Unter Dieben ist keine Ehre."

# game/code/book-2/chapter-14/b2c14s05.rpy:641
translate deutsch b2c14s05_be8ca094:

    # pm "Want to put the cuffs on our perps yourself?"
    pm "Willst du unseren Tätern selbst die Handschellen anlegen?"

# game/code/book-2/chapter-14/b2c14s05.rpy:643
translate deutsch b2c14s05_d08d6230:

    # mc "Nothing would please me more. But..."
    mc "Nichts würde mich mehr freuen. Aber..."

# game/code/book-2/chapter-14/b2c14s05.rpy:646
translate deutsch b2c14s05_68f0a8f0:

    # pm "But?"
    pm "Aber?"

# game/code/book-2/chapter-14/b2c14s05.rpy:649
translate deutsch b2c14s05_58ffc620:

    # mc "I think I need to prepare for my sendoff. I owe some people the truth about what I've been doing."
    mc "Ich glaube, ich muss mich auf meinen Abschied vorbereiten. Ich schulde einigen Leuten die Wahrheit darüber, was ich gemacht habe."

# game/code/book-2/chapter-14/b2c14s05.rpy:651
translate deutsch b2c14s05_d8e2a2e9:

    # pm "Mmm."
    pm "Mmm."

# game/code/book-2/chapter-14/b2c14s05.rpy:653
translate deutsch b2c14s05_a284f0fe:

    # mc "But I do want you to call me when we cuff those assholes. Even if I'm not putting the iron on myself, I'll enjoy the view."
    mc "Aber ich will, dass du mich anrufst, wenn wir diese Arschlöcher in Handschellen legst. Auch wenn ich sie nicht selbst anlege, wird mir der Anblick Freude bereiten."

# game/code/book-2/chapter-14/b2c14s05.rpy:656
translate deutsch b2c14s05_4ea44264:

    # pm "You got it."
    pm "Klar doch."

# game/code/book-2/chapter-14/b2c14s05.rpy:662
translate deutsch b2c14s05_2b35b6fe_1:

    # mc "..."
    mc "..."

# game/code/book-2/chapter-14/b2c14s05.rpy:665
translate deutsch b2c14s05_ee8570fa:

    # mc "You know, I think I would rather sail into a hurricane than have some of the conversations I need to have."
    mc "Weißt du, ich glaube, ich würde lieber in einen Hurrikan segeln, als einige der Gespräche zu führen, die ich führen muss."

# game/code/book-2/chapter-14/b2c14s05.rpy:667
translate deutsch b2c14s05_e5c78622:

    # pm "I know, Matthew."
    pm "Ich weiß, Matthew."

# game/code/book-2/chapter-14/b2c14s05.rpy:670
translate deutsch b2c14s05_e3cad578:

    # pm "I think this is... what makes being an undercover so hard. You saved the victims."
    pm "Ich glaube, das ist... was den Undercover-Job so schwer macht. Du hast die Opfer gerettet."

# game/code/book-2/chapter-14/b2c14s05.rpy:671
translate deutsch b2c14s05_1851f623:

    # pm "You're a hero. But..."
    pm "Du bist ein Held. Aber..."

# game/code/book-2/chapter-14/b2c14s05.rpy:674
translate deutsch b2c14s05_e3e97dbf:

    # mc "I've also been lying to plenty of people who were innocent."
    mc "Ich habe auch eine Menge Leute angelogen, die unschuldig waren."

# game/code/book-2/chapter-14/b2c14s05.rpy:675
translate deutsch b2c14s05_25be335b:

    # mc "Well... haha. Innocent-ish."
    mc "Nun... haha. Unschuldig ungefähr."

# game/code/book-2/chapter-14/b2c14s05.rpy:678
translate deutsch b2c14s05_b23987fe:

    # pm "Some of them should feel lucky they're not going down with management."
    pm "Einige von ihnen sollten froh sein, dass sie nicht zusammen mit der Leitung untergehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:680
translate deutsch b2c14s05_d184bea2:

    # mc "Haha, I'm not sure they'll feel that way."
    mc "Haha, ich bin mir nicht sicher, dass sie das so sehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:683
translate deutsch b2c14s05_27950184:

    # pm "Well, whatever the case, it's time to wrap it up."
    pm "Nun, wie auch immer, es ist Zeit, das abzuschließen."

# game/code/book-2/chapter-14/b2c14s05.rpy:687
translate deutsch b2c14s05_1d031f78:

    # pm "Whether that means a breakup or a group text, just know I'm here if you need anything."
    pm "Ob das nun eine Trennung bedeutet oder eine Gruppen-Nachricht, weiß einfach, dass ich hier bin, wenn du was brauchst."

# game/code/book-2/chapter-14/b2c14s05.rpy:689
translate deutsch b2c14s05_383fbd6d:

    # mc "I know, Phoebe. Thanks."
    mc "Ich weiß, Phoebe. Danke."

# game/code/book-2/chapter-14/b2c14s05.rpy:693
translate deutsch b2c14s05_740682b7:

    # pm "I need to get working on those arrests."
    pm "Ich muss mich an die Festnahmen machen."

# game/code/book-2/chapter-14/b2c14s05.rpy:695
translate deutsch b2c14s05_2da5d8c7:

    # mc "I'll catch up with you tomorrow."
    mc "Wir sehen uns morgen wieder."

# game/code/book-2/chapter-14/b2c14s05.rpy:698
translate deutsch b2c14s05_13c7d40b:

    # pm "Good. Things are about to get busy around here."
    pm "Gut. Es wird hier bald richtig losgehen."

# game/code/book-2/chapter-14/b2c14s05.rpy:704
translate deutsch b2c14s05_4e945e1a:

    # mct "How will I even begin to tell people what I've done here?"
    mct "Wie soll ich überhaupt anfangen, den Leuten zu erzählen, was ich hier getan habe?"

# game/code/book-2/chapter-14/b2c14s05.rpy:708
translate deutsch b2c14s05_25cde8d3:

    # mct "You know, it doesn't matter. Part of this job is being my best self."
    mct "Weißt du, es ist egal. Ein Teil dieses Jobs ist es, mein bestes Selbst zu sein."

# game/code/book-2/chapter-14/b2c14s05.rpy:711
translate deutsch b2c14s05_c512a785:

    # mct "To be an example to others. They can be angry with me, even hate me."
    mct "Ein Beispiel für andere zu sein. Sie können mir böse sein, mich sogar hassen."

# game/code/book-2/chapter-14/b2c14s05.rpy:715
translate deutsch b2c14s05_db7e0684:

    # mct "But it was all worth it so these girls can go back to their homes and families..."
    mct "Aber es war alles wert, damit diese Mädchen zurück zu ihren Häusern und Familien können..."

# game/code/book-2/chapter-14/b2c14s05.rpy:719
translate deutsch b2c14s05_6651ecfa:

    # mct "The smart people will understand that what I accomplished had a cost."
    mct "Die klugen Leute werden verstehen, dass das, was ich erreicht habe, einen Preis hatte."

# game/code/book-2/chapter-14/b2c14s05.rpy:720
translate deutsch b2c14s05_9cd9e702:

    # mct "They'll question it, and they'll probably cry and moan a bit about things like 'betrayal' and call me names."
    mct "Sie werden es anzweifeln, und sie werden wahrscheinlich ein bisschen heulen und jammern wegen Dingen wie 'Verrat' und mich beschimpfen."

# game/code/book-2/chapter-14/b2c14s05.rpy:723
translate deutsch b2c14s05_a4269633:

    # mct "But eventually they'll see that I had no choice."
    mct "Aber irgendwann werden sie verstehen, dass ich keine Wahl hatte."

# game/code/book-2/chapter-14/b2c14s05.rpy:727
translate deutsch b2c14s05_df960438:

    # mct "I had a job to do, and in the end, I delivered. End of story."
    mct "Ich hatte einen Job zu erledigen, und am Ende habe ich geliefert. Ende der Geschichte."

translate deutsch strings:

    # game/code/book-2/chapter-14/b2c14s05.rpy:21
    old "After you are done with all your girls"
    new "Nachdem du mit all deinen Mädchen fertig bist"

    # game/code/book-2/chapter-14/b2c14s05.rpy:193
    old "I should play it like last time"
    new "Ich sollte es wie letztes Mal angehen"

    # game/code/book-2/chapter-14/b2c14s05.rpy:193
    old "It was a mistake bringing me"
    new "Es war ein Fehler, mich mitzunehmen"

