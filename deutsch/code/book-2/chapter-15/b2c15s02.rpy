    zp "Der Mistkerl hat mich immer angemacht und Zusatzpunkte angeboten."

# game/code/book-2/chapter-15/b2c15s02.rpy:255
translate deutsch b2c15s02_d5cb4bea:

    # sm "Yeah. I don't think anyone is going to miss him."
    sm "Ja. Ich glaube nicht, dass ihn irgendjemand vermissen wird."

# game/code/book-2/chapter-15/b2c15s02.rpy:256
translate deutsch b2c15s02_a80f04d6:

    # sm "Hopefully our next faculty adviser will be a step up."
    sm "Hoffentlich wird unser nächster Fakultätsberater eine Verbesserung sein."

# game/code/book-2/chapter-15/b2c15s02.rpy:259
translate deutsch b2c15s02_28194043:

    # zp "In case not, you can always come slum it with us troublemakers at the Guns and Rosettes bar."
    zp "Falls nicht, kannst du immer mit uns Chaoten in der Guns-und-Rosettes-Bar abhängen."

# game/code/book-2/chapter-15/b2c15s02.rpy:262
translate deutsch b2c15s02_e2099e38:

    # sm "Haha. That's a no from me, Zem."
    sm "Haha. Da muss ich passen, Zem."

# game/code/book-2/chapter-15/b2c15s02.rpy:263
translate deutsch b2c15s02_1c66d812:

    # sm "I prefer to spend time with my girlfiend in a non-crime adjacent location."
    sm "Ich verbringe meine Zeit lieber mit meiner Freundin an einem Ort, der nichts mit Kriminalität zu tun hat."

# game/code/book-2/chapter-15/b2c15s02.rpy:268
translate deutsch b2c15s02_5296b465:

    # zp "Haha. Alles klar."
    zp "Haha. Alles klar."

# game/code/book-2/chapter-15/b2c15s02.rpy:271
translate deutsch b2c15s02_3cc4b46c:

    # sm "Speaking of the party, you're still okay picking up the drinks, [mcname]?"
    sm "Apropos Party, es ist noch okay, dass du die Getränke holst, [mcname]?"

# game/code/book-2/chapter-15/b2c15s02.rpy:274
translate deutsch b2c15s02_606e2d02:

    # mc "Sure."
    mc "Sicher."

# game/code/book-2/chapter-15/b2c15s02.rpy:276
translate deutsch b2c15s02_6da0df74:

    # sm "Thanks. It will be a big help."
    sm "Danke. Das wird eine große Hilfe sein."

# game/code/book-2/chapter-15/b2c15s02.rpy:277
translate deutsch b2c15s02_be434b77:

    # sm "I still haven't figured out what to wear."
    sm "Ich hab immer noch nicht rausgefunden, was ich anziehen soll."

# game/code/book-2/chapter-15/b2c15s02.rpy:281
translate deutsch b2c15s02_d8ab397a:

    # "{color=#aa0323}Zemfira{/color} and [mcname]" "..."
    "{color=#aa0323}Zemfira{/color} und [mcname]" "..."

# game/code/book-2/chapter-15/b2c15s02.rpy:284
translate deutsch b2c15s02_4697516f:

    # sm "What?"
    sm "Was?"

# game/code/book-2/chapter-15/b2c15s02.rpy:287
translate deutsch b2c15s02_5200821a:

    # zp "Nothing. But I think you know the kind of clothes [mcname] and I love to see you in."
    zp "Nichts. Aber ich denke, du weißt, was für Klamotten [mcname] und ich dich gerne sehen."

# game/code/book-2/chapter-15/b2c15s02.rpy:290
translate deutsch b2c15s02_00086f31:

    # sm "I'm not going to the party naked."
    sm "Ich gehe nicht nackt zur Party."

# game/code/book-2/chapter-15/b2c15s02.rpy:293
translate deutsch b2c15s02_5d5cba13:

    # mc "Come on, we can all do it. Haha."
    mc "Komm schon, wir könnten alle mitmachen. Haha."

# game/code/book-2/chapter-15/b2c15s02.rpy:296
translate deutsch b2c15s02_f0af8ab1:

    # sm "N. E. I. N., Mister."
    sm "N. E. I. N., Mister."

# game/code/book-2/chapter-15/b2c15s02.rpy:301
translate deutsch b2c15s02_ad1a7419:

    # zp "I'll keep talking to her about it. See you at the party, [mcname]."
    zp "Ich werd sie weiter bearbeiten. Bis zur Party, [mcname]."

# game/code/book-2/chapter-15/b2c15s02.rpy:304
translate deutsch b2c15s02_592a17f3:

    # mc "Looking forward to it."
    mc "Ich freue mich drauf."

# game/code/book-2/chapter-15/b2c15s02.rpy:312
translate deutsch b2c15s02_63159471:

    # nv "Hello, [mcname]."
    nv "Hallo, [mcname]."

# game/code/book-2/chapter-15/b2c15s02.rpy:314
translate deutsch b2c15s02_a21debd3:

    # mc "Always good to see my lovely ladies."
    mc "Immer schön, meine wundervollen Damen zu sehen."

# game/code/book-2/chapter-15/b2c15s02.rpy:319
translate deutsch b2c15s02_638f3b47:

    # nv "Mmhmm."
    nv "Mmhmm."

# game/code/book-2/chapter-15/b2c15s02.rpy:321
translate deutsch b2c15s02_b6f7c7ad:

    # sm "Ahhuah."
    sm "Ahhuah."

# game/code/book-2/chapter-15/b2c15s02.rpy:326
translate deutsch b2c15s02_e52d64c3:

    # nv "We really are blessed to have Maria and everyone back."
    nv "Wir sind wirklich gesegnet, Maria und alle anderen zurückzuhaben."

# game/code/book-2/chapter-15/b2c15s02.rpy:327
translate deutsch b2c15s02_d8eb0dbd:

    # nv "I was definitely praying for her safe return during our sessions."
    nv "Ich habe auf jeden Fall für ihre sichere Rückkehr während unserer Treffen gebetet."

# game/code/book-2/chapter-15/b2c15s02.rpy:332
translate deutsch b2c15s02_0046d7b0:

    # sm "That's wonderful, Nia. The important thing is you never gave up hope."
    sm "Das ist wunderbar, Nia. Das Wichtigste ist, dass du nie die Hoffnung aufgegeben hast."

# game/code/book-2/chapter-15/b2c15s02.rpy:333
translate deutsch b2c15s02_0681f777:

    # sm "I know... I really started to feel down about Klara ever coming back when [mcname] got her room."
    sm "Ich weiß... ich habe wirklich angefangen zu zweifeln, dass Klara je zurückkommt, als [mcname] ihr Zimmer bekam."

# game/code/book-2/chapter-15/b2c15s02.rpy:336
translate deutsch b2c15s02_12240427:

    # sm "But I was wrong."
    sm "Aber Ich war falsch."

# game/code/book-2/chapter-15/b2c15s02.rpy:337
translate deutsch b2c15s02_b0eca7b6:

    # sm "Someone out there was smiling on them. And us."
    sm "Irgendwo da draußen hat jemand über sie gewacht. Und über uns."

# game/code/book-2/chapter-15/b2c15s02.rpy:340
translate deutsch b2c15s02_fc155614:

    # nv "Well, I need to get ready for my next class."
    nv "Nun, ich muss mich für meine nächste Stunde fertig machen."

# game/code/book-2/chapter-15/b2c15s02.rpy:343
translate deutsch b2c15s02_62b83d57:

    # sm "It's at the Givens Building right? I'll walk with you."
    sm "Es ist im Givens-Gebäude, richtig? Ich laufe mit dir."

# game/code/book-2/chapter-15/b2c15s02.rpy:345
translate deutsch b2c15s02_b7bb4b62:

    # nv "Sure."
    nv "Sicher."

# game/code/book-2/chapter-15/b2c15s02.rpy:349
translate deutsch b2c15s02_085a731b:

    # nv "Coming along, [mcname]?"
    nv "Kommst du mit, [mcname]?"

# game/code/book-2/chapter-15/b2c15s02.rpy:352
translate deutsch b2c15s02_30de5721:

    # mc "Nah, I need to get some studying done."
    mc "Nee, ich muss noch ein bisschen lernen."

# game/code/book-2/chapter-15/b2c15s02.rpy:354
translate deutsch b2c15s02_e8a48f5d:

    # nv "Okay. Until next time."
    nv "Okay. Bis zum nächsten Mal."

# game/code/book-2/chapter-15/b2c15s02.rpy:364
translate deutsch b2c15s02_443d8122:

    # nv "Don't forget to pick up some drinks for the party."
    nv "Nicht vergessen, Getränke für die Party zu holen."

# game/code/book-2/chapter-15/b2c15s02.rpy:365
translate deutsch b2c15s02_5e68a0ff:

    # nv "Now that Leia is back and Professor Harlan is out, Isa seems pretty chill."
    nv "Jetzt wo Leia zurück ist und Professor Harlan raus ist, scheint Isa ziemlich locker zu sein."

# game/code/book-2/chapter-15/b2c15s02.rpy:369
translate deutsch b2c15s02_dc44ca18:

    # sm "Yeah, we should keep it that way."
    sm "Ja, das sollten wir auch so lassen."

# game/code/book-2/chapter-15/b2c15s02.rpy:370
translate deutsch b2c15s02_c7214920:

    # nv "Tschüss, [mcname]."
    nv "Tschüss, [mcname]."

# game/code/book-2/chapter-15/b2c15s02.rpy:373
translate deutsch b2c15s02_c467c75c:

    # sm "Küsschen."
    sm "Küsschen."

# game/code/book-2/chapter-15/b2c15s02.rpy:380
translate deutsch b2c15s02_24b25b0f:

    # mc "*sighs*"
    mc "*seufzt*"

# game/code/book-2/chapter-15/b2c15s02.rpy:386
translate deutsch b2c15s02_79557a11:

    # mct "It's really kind of funny, how everything turned out."
    mct "Es ist irgendwie witzig, wie alles gelaufen ist."

# game/code/book-2/chapter-15/b2c15s02.rpy:390
translate deutsch b2c15s02_08840af3:

    # mct "It was almost fate that put me in the cult at the right time. The way Kara was running things, it was only a matter of time before Andrejz screwed up."
    mct "Es war fast Schicksal, dass ich gerade zur richtigen Zeit in der Sekte war. So wie Kara die Dinge leitete, war es nur eine Frage der Zeit, bis Andrejz es vermasselt."

# game/code/book-2/chapter-15/b2c15s02.rpy:391
translate deutsch b2c15s02_0f336cf3:

    # mct "Guy was an asshole, but he was wound up tight and fully into the beliefs."
    mct "Der Typ war ein Arschloch, aber er total verspannt und voll und ganz von dem Glauben überzeugt."

# game/code/book-2/chapter-15/b2c15s02.rpy:392
translate deutsch b2c15s02_2c8e7cd0:

    # mct "Kara was going to use him until he broke, and I think Lumi and others would have gotten hurt in the aftermath."
    mct "Kara hätte ihn benutzt, bis er zerbrach, und ich denke, Lumi und andere hätten danach Schaden genommen."

# game/code/book-2/chapter-15/b2c15s02.rpy:397
translate deutsch b2c15s02_3b406db2:

    # mct "Still, all things considered it was the Winners Club who really owes me."
    mct "Trotzdem, alles in allem schuldet mir der Winners Club eigentlich was."

# game/code/book-2/chapter-15/b2c15s02.rpy:398
translate deutsch b2c15s02_c59e0e05:

    # mct "If I didn't get onto the volleyball team, Harlan would have kept pushing Brigitta and she'd still be a bitch."
    mct "Wenn ich nicht ins Volleyballteam gekommen wäre, hätte Harlan Brigitta weiter unter Druck gesetzt und sie wäre immer noch eine Zicke."

# game/code/book-2/chapter-15/b2c15s02.rpy:399
translate deutsch b2c15s02_366ee101:

    # mct "Okay, she is still a bitch, but Harlan was just a loser trying to get into the cool kids club."
    mct "Na gut, sie ist immer noch eine Zicke, aber Harlan war einfach ein Loser, der es in den Club der coolen Kids geschafft hat."

# game/code/book-2/chapter-15/b2c15s02.rpy:400
translate deutsch b2c15s02_226be12f:

    # mct "Eventually his business with the drugs and the team would have gotten someone hurt."
    mct "Letztendlich hätte sein Geschäft mit den Drogen und dem Team noch jemand geschadet."

# game/code/book-2/chapter-15/b2c15s02.rpy:406
translate deutsch b2c15s02_6bf1042a:

    # mct "And Gabbie... She thought she was better than everyone else in the criminal underworld."
    mct "Und Gabbie... Sie dachte, sie wäre besser als alle anderen in der kriminellen Unterwelt."

# game/code/book-2/chapter-15/b2c15s02.rpy:408
translate deutsch b2c15s02_47e68bfe:

    # mct "Foxy was right. Backstabbing Hellena put a target on our back."
    mct "Foxy hatte recht. Die hinterhältige Hellena hat uns zur Zielscheibe gemacht."

# game/code/book-2/chapter-15/b2c15s02.rpy:409
translate deutsch b2c15s02_040f76ce:

    # mct "It's just good that we arrested Gabbie before Foxy put her plan into action."
    mct "Es ist nur gut, dass wir Gabbie verhaftet haben, bevor Foxy ihren Plan in die Tat umgesetzt hat."

# game/code/book-2/chapter-15/b2c15s02.rpy:411
translate deutsch b2c15s02_5ada6980:

    # mct "If she didn't get arrested, it was only a matter of time before one of the other gang pushed back against the Syndicate."
    mct "Wäre sie nicht verhaftet worden, wäre es nur eine Frage der Zeit gewesen, bis eine der anderen Gangs gegen das Syndikat vorging."

# game/code/book-2/chapter-15/b2c15s02.rpy:415
translate deutsch b2c15s02_3585c668:

    # mct "Time is almost up. I shouldn't just keep coming here and acting like everything is alright."
    mct "Die Zeit ist fast um. Ich sollte nicht einfach weiter hier herkommen und so tun, als wäre alles in Ordnung."

# game/code/book-2/chapter-15/b2c15s02.rpy:416
translate deutsch b2c15s02_ba16f4db:

    # mct "That buzzer is going to hit zero, and if you haven't told the girls who you really are, it is going to be bad."
    mct "Dieser Summbald wird auf Null gehen, und wenn du den Mädchen nicht gesagt hast, wer du wirklich bist, wird es schlimm."

# game/code/book-2/chapter-15/b2c15s02.rpy:417
translate deutsch b2c15s02_ea595dac:

    # "As much as you know it is the right thing to do, giving voice to that reasoning fills you with dread."
    "So sehr du auch weißt, dass es das Richtige ist, dieser Gedanke macht dir Angst."

# game/code/book-2/chapter-15/b2c15s02.rpy:418
translate deutsch b2c15s02_49cbfb7f:

    # "It is hard to imagine it will be an easy conversation."
    "Es ist schwer vorzustellen, dass das ein einfaches Gespräch wird."

# game/code/book-2/chapter-15/b2c15s02.rpy:419
translate deutsch b2c15s02_6f91fc51:

    # mct "It is probably going to suck. But it is the right thing to do."
    mct "Es wird wahrscheinlich beschissen. Aber es ist das Richtige."

# game/code/book-2/chapter-15/b2c15s02.rpy:431
translate deutsch b2c15s02_outside_campus_21d3bc8d:

    # pm "Penny for your thoughts?"
    pm "Wonach denkst du denn?"

# game/code/book-2/chapter-15/b2c15s02.rpy:434
translate deutsch b2c15s02_outside_campus_fc087093:

    # mc "Might take more than a penny."
    mc "Könnte mehr als ein paar Gedanken sein."

# game/code/book-2/chapter-15/b2c15s02.rpy:435
translate deutsch b2c15s02_outside_campus_705e7437:

    # mc "Hi 'Mutti'."
    mc "Hi 'Mutti'."

# game/code/book-2/chapter-15/b2c15s02.rpy:439
translate deutsch b2c15s02_outside_campus_8ec82e8d:

    # pm "Hi my sweet. I've come to take you out for lunch."
    pm "Hi, mein Süßer. Ich bin gekommen, um dich zum Mittagessen auszuführen."

# game/code/book-2/chapter-15/b2c15s02.rpy:442
translate deutsch b2c15s02_outside_campus_d7058095:

    # mc "Was ist der Anlass?"
    mc "Was ist der Anlass?"

# game/code/book-2/chapter-15/b2c15s02.rpy:445
translate deutsch b2c15s02_outside_campus_1e241e47:

    # pm "Does a mother need an excuse to keep her son well fed?"
    pm "Braucht eine Mutter einen Grund, ihren Sohn gut zu versorgen?"

# game/code/book-2/chapter-15/b2c15s02.rpy:447
translate deutsch b2c15s02_outside_campus_c2eb53da:

    # mc "Of course not."
    mc "Natürlich nicht."

# game/code/book-2/chapter-15/b2c15s02.rpy:454
translate deutsch b2c15s02_outside_campus_611a0328:

    # mc "So what's up, Phoebe?"
    mc "Na, was geht, Phoebe?"

# game/code/book-2/chapter-15/b2c15s02.rpy:459
translate deutsch b2c15s02_outside_campus_cd4e599e:

    # pm "What is up?{w} Have you taken up weed since we last spoke?"
    pm "Was geht?{w}Hast du etwa angefangen zu kiffen, seit wir zuletzt gesprochen haben?"

# game/code/book-2/chapter-15/b2c15s02.rpy:462
translate deutsch b2c15s02_outside_campus_44ea33f1:

    # mc "*chuckles* Of course not."
    mc "*kichert* Natürlich nicht."

# game/code/book-2/chapter-15/b2c15s02.rpy:465
translate deutsch b2c15s02_outside_campus_6f8924e6:

    # pm "Then what are you still doing at the campus?"
    pm "Dann was machst du noch auf dem Campus?"

# game/code/book-2/chapter-15/b2c15s02.rpy:470
translate deutsch b2c15s02_outside_campus_b6846a88:

    # mc "I... I'm just making sure the girls are adjusting back to things."
    mc "Ich... ich stell nur sicher, dass die Mädchen sich wieder einleben."

# game/code/book-2/chapter-15/b2c15s02.rpy:475
translate deutsch b2c15s02_outside_campus_0f715b39:

    # pm "They each have a psychiatrist and plenty of support options for that, [mcname]."
    pm "Jede von ihnen hat einen Psychiater und jede Menge Unterstützungsmöglichkeiten dafür, [mcname]."

# game/code/book-2/chapter-15/b2c15s02.rpy:476
translate deutsch b2c15s02_outside_campus_351fe83d:

    # pm "Watching out for them is not your job."
    pm "Auf sie aufzupassen, ist nicht deine Aufgabe."

# game/code/book-2/chapter-15/b2c15s02.rpy:479
translate deutsch b2c15s02_outside_campus_fb18eccb:

    # mc "I know. Trust me, I just..."
    mc "Ich weiß. Vertrau mir, ich nur..."

# game/code/book-2/chapter-15/b2c15s02.rpy:480
translate deutsch b2c15s02_outside_campus_f26a2fbc:

    # mc "I just can't seem to let it lie. Something is still poking at me about the case."
    mc "Ich kann das einfach nicht ruhen lassen. Irgendetwas nagt noch an mir wegen dem Fall."

# game/code/book-2/chapter-15/b2c15s02.rpy:481
translate deutsch b2c15s02_outside_campus_576933bf:

    # mc "It's like when you get a piece of popcorn stuck in the back corner of a tooth and you can't dig it out."
    mc "Es ist wie bei einem Popcorn-Korn, das im hinteren Eck eines Zahns steckt und du es nicht rauskriegst."

# game/code/book-2/chapter-15/b2c15s02.rpy:484
translate deutsch b2c15s02_outside_campus_393efacf:

    # pm "Well you're going to have to figure out a way."
    pm "Nun, du wirst dir einen Weg suchen müssen."

# game/code/book-2/chapter-15/b2c15s02.rpy:485
translate deutsch b2c15s02_outside_campus_2fd1461f:

    # pm "Officially, the case is closed. The District Attorney is indicting the ringleaders on their charges, including kidnapping."
    pm "Offiziell ist der Fall abgeschlossen. Die Staatsanwaltschaft klagt die Anführer wegen ihrer Vorwürfe an, einschließlich Entführung."

# game/code/book-2/chapter-15/b2c15s02.rpy:490
translate deutsch b2c15s02_outside_campus_33032205:

    # pm "And you, Matthew, need to take a break before you get your next case."
    pm "Und du, Matthew, musst mal eine Pause machen, bevor du deinen nächsten Fall bekommst."

# game/code/book-2/chapter-15/b2c15s02.rpy:495
translate deutsch b2c15s02_outside_campus_410ca74f:

    # pm "Unless there is something else on your mind?"
    pm "Es sei denn, du hast noch etwas anderes im Kopf?"

# game/code/book-2/chapter-15/b2c15s02.rpy:498
translate deutsch b2c15s02_outside_campus_e9dee5c8:

    # mc "What is that supposed to mean?"
    mc "Was soll das denn heißen?"

# game/code/book-2/chapter-15/b2c15s02.rpy:501
translate deutsch b2c15s02_outside_campus_fe950fb4:

    # pm "Nothing. I trust you're making the right choices, [mcname]."
    pm "Nichts. Ich vertraue darauf, dass du die richtigen Entscheidungen triffst, [mcname]."

# game/code/book-2/chapter-15/b2c15s02.rpy:502
translate deutsch b2c15s02_outside_campus_6fc1e051:

    # pm "You were undercover for weeks, the only people who know how that actually works are people like you."
    pm "Du warst wochenlang undercover. Die einzigen Leute, die wissen, wie das wirklich funktioniert, sind Leute wie du."

# game/code/book-2/chapter-15/b2c15s02.rpy:503
translate deutsch b2c15s02_outside_campus_7d1620ef:

    # pm "But the chief and other people are worried. They asked me to check in on you."
    pm "Aber der Chef und andere machen sich Sorgen. Sie haben mich gebeten, mal bei dir vorbeizuschauen."

# game/code/book-2/chapter-15/b2c15s02.rpy:514
translate deutsch b2c15s02_outside_campus_bb08630c:

    # mc "They don't need to worry. And neither do you."
    mc "Die brauchen sich keine Sorgen zu machen. Und du auch nicht."

# game/code/book-2/chapter-15/b2c15s02.rpy:519
translate deutsch b2c15s02_outside_campus_0d26450c:

    # mc "I'll be back at the station in no time."
    mc "Ich bin im Nullkommanix zurück auf der Wache."

# game/code/book-2/chapter-15/b2c15s02.rpy:523
translate deutsch b2c15s02_outside_campus_b9979e23:

    # pm "Na gut..."
    pm "Na gut..."

# game/code/book-2/chapter-15/b2c15s02.rpy:527
translate deutsch b2c15s02_outside_campus_c503206e:

    # pm "It's time to come home."
    pm "Es ist Zeit, nach Hause zu kommen."

# game/code/book-2/chapter-15/b2c15s02.rpy:528
translate deutsch b2c15s02_outside_campus_70c4514b:

    # pm "You got the girls back, and the bad guys are locked up."
    pm "Du hast die Mädchen zurückgeholt, und die Bösen sitzen im Knast."

# game/code/book-2/chapter-15/b2c15s02.rpy:531
translate deutsch b2c15s02_outside_campus_8cc89239:

    # mc "I will be back, Phoebe."
    mc "Ich komme zurück, Phoebe."

# game/code/book-2/chapter-15/b2c15s02.rpy:532
translate deutsch b2c15s02_outside_campus_1b093c0f:

    # mc "But everything got wrapped up just a little too nicely."
    mc "Aber das Ganze wurde mir ein bisschen zu glatt abgewikkelt."

# game/code/book-2/chapter-15/b2c15s02.rpy:535
translate deutsch b2c15s02_outside_campus_d8245baa:

    # pm "You know they say that sometimes smart people don't like being happy and so they make up problems."
    pm "Weißt du, man sagt ja manchmal, dass kluge Leute es nicht mögen, glücklich zu sein, und sich deshalb selber Probleme machen."

# game/code/book-2/chapter-15/b2c15s02.rpy:538
translate deutsch b2c15s02_outside_campus_e43bf8da:

    # mc "Heh. Maybe. {w} But I don't think that is it."
    mc "Heh. Vielleicht.{w}Aber ich glaube nicht, dass das's ist."

# game/code/book-2/chapter-15/b2c15s02.rpy:539
translate deutsch b2c15s02_outside_campus_cc46e432:

    # mc "I gotta ask the girls some questions. Now that they're finally back and settling back in..."
    mc "Ich muss den Mädchen noch ein paar Fragen stellen. Jetzt wo sie endlich zurück sind und sich wieder einleben..."

# game/code/book-2/chapter-15/b2c15s02.rpy:540
translate deutsch b2c15s02_outside_campus_337b4390:

    # mc "I can make the approach."
    mc "Ich kann die Sache angehen."

# game/code/book-2/chapter-15/b2c15s02.rpy:543
translate deutsch b2c15s02_outside_campus_d33e1f5e:

    # pm "Okay. Just... be careful. They've been through a lot."
    pm "Okay. Nur... sei vorsichtig. Die haben viel durchgemacht."

# game/code/book-2/chapter-15/b2c15s02.rpy:545
translate deutsch b2c15s02_outside_campus_cfcc2293:

    # mc "I know."
    mc "Ich weiß."

# game/code/book-2/chapter-15/b2c15s02.rpy:548
translate deutsch b2c15s02_outside_campus_4d387bd5:

    # pm "Don't stay out in the cold too long."
    pm "Bleib nicht so lange draußen in der Kälte."

# game/code/book-2/chapter-15/b2c15s02.rpy:549
translate deutsch b2c15s02_outside_campus_953f40c4:

    # pm "Not when they're someone at home waiting."
    pm "Nicht, wenn jemand zu Hause auf dich wartet."

# game/code/book-2/chapter-15/b2c15s02.rpy:553
translate deutsch b2c15s02_outside_campus_cf8a4294:

    # mc "Ah so you think we should still keep violating about five rules of the officer's handbook."
    mc "Ah, also denkst du, wir sollten weiterhin gegen fünf Regeln des Beamtenhandbuchs verstoßen."

# game/code/book-2/chapter-15/b2c15s02.rpy:556
translate deutsch b2c15s02_outside_campus_721bafcb:

    # pm "I'm sure there is some paperwork we can sign."
    pm "Ich bin sicher, da gibt es ein paar Formulare, die wir unterschreiben können."

# game/code/book-2/chapter-15/b2c15s02.rpy:557
translate deutsch b2c15s02_outside_campus_ed1b985d:

    # pm "Even if there isn't, I'm okay breaking a few rules with you."
    pm "Selbst wenn nicht, bin ich bereit, ein paar Regeln mit dir zu brechen."

# game/code/book-2/chapter-15/b2c15s02.rpy:559
translate deutsch b2c15s02_outside_campus_425a8bc3:

    # mc "I'll be sure to keep that in mind."
    mc "Das werd ich mir merken."

# game/code/book-2/chapter-15/b2c15s02.rpy:568
translate deutsch b2c15s02_outside_campus_ff09b062:

    # pm "Be careful out there."
    pm "Pass auf dich auf draußen."

# game/code/book-2/chapter-15/b2c15s02.rpy:571
translate deutsch b2c15s02_outside_campus_0817892e:

    # mc "Always."
    mc "Immer."

# game/code/book-2/chapter-15/b2c15s02.rpy:590
translate deutsch b2c15s02_outside_campus_e2dbcb55:

    # mct "Jeez, first Phoebe. Now Diana."
    mct "Mann, erst Phoebe. Jetzt Diana."

# game/code/book-2/chapter-15/b2c15s02.rpy:595
translate deutsch b2c15s02_outside_campus_06eea3c2:

    # dm "[mcname]. Please come to my office with me."
    dm "[mcname]. Bitte kommen Sie mit mir in mein Büro."

# game/code/book-2/chapter-15/b2c15s02.rpy:598
translate deutsch b2c15s02_outside_campus_99e6c5df:

    # mc "Can it wait? I actually have a pretty full plate."
    mc "Kann das warten? Ich habe gerade ziemlich viel zu tun."

# game/code/book-2/chapter-15/b2c15s02.rpy:599
translate deutsch b2c15s02_outside_campus_f63e92a3:

    # "The administrator gives you a look as if to remind you that she knows that you don't have any homework to do."
    "Die Administratorin wirft dir einen Blick zu, als wollte sie dich daran erinnern, dass sie weiß, dass du keine Hausaufgaben zu erledigen hast."

# game/code/book-2/chapter-15/b2c15s02.rpy:602
translate deutsch b2c15s02_outside_campus_70b4bcc7:

    # mct "Yeah, she probably got some professors even noticing it by now."
    mct "Ja, die hat wahrscheinlich sogar ein paar Professoren darauf aufmerksam gemacht."

# game/code/book-2/chapter-15/b2c15s02.rpy:603
translate deutsch b2c15s02_outside_campus_90f01cf7:

    # mct "Guess I've relaxed since finding the girls no one else could."
    mct "Ich schätze, ich hab's mir zu bequem gemacht, seit ich die Mädchen gefunden habe, die sonst keiner fand."

# game/code/book-2/chapter-15/b2c15s02.rpy:606
translate deutsch b2c15s02_outside_campus_7d1e2944:

    # mc "I mean, of course I can fit you in."
    mc "Ich meine, natürlich kann ich mir Zeit für dich nehmen."

# game/code/book-2/chapter-15/b2c15s02.rpy:607
translate deutsch b2c15s02_outside_campus_df7ee913:

    # mc "Lead the way."
    mc "Geh voran."

# game/code/book-2/chapter-15/b2c15s02.rpy:612
translate deutsch b2c15s02_outside_campus_bc66fffa:

    # dm "Very good."
    dm "Sehr gut."

translate deutsch strings:

    # game/code/book-2/chapter-15/b2c15s02.rpy:22
    old "Two weeks later..."
    new "Two weeks später..."

