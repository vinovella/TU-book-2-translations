translate deutsch b2c15s02_f2780c80:

    # mc "Sailing is not nerdy."
    mc "Segeln ist nicht nerdig."

# game/code/book-2/chapter-15/b2c15s02.rpy:88
translate deutsch b2c15s02_cfa0aba8:

    # zp "Mmhmm."
    zp "Mmhmm."

# game/code/book-2/chapter-15/b2c15s02.rpy:91
translate deutsch b2c15s02_79de7289:

    # mc "Come here."
    mc "Komm her."

