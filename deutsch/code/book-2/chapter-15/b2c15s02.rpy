translate deutsch b2c15s02_2bffc5ee:

    # mc "You always look good."
    mc "Du siehst immer gut aus."

# game/code/book-2/chapter-15/b2c15s02.rpy:182
translate deutsch b2c15s02_e52ce4b4:

    # zp "I know that. But I want to look extra good."
    zp "Das weiß ich. Aber ich will extra gut aussehen."

