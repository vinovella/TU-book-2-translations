translate deutsch b2c15s02_59a9a148:

    # nv "Like when you decided you didn't even need to wear underwear while we were waiting for our boyfriend to come."
    nv "Zum Beispiel, als du beschlossen hast, gar keine Unterwäsche zu tragen, während wir auf unseren Freund gewartet haben."

# game/code/book-2/chapter-15/b2c15s02.rpy:121
translate deutsch b2c15s02_8a0d555e:

    # zp "Haha. Yeah. I guess I don't have much room to talk."
    zp "Haha. Ja. Ich schätze, ich kann nicht viel dazu sagen."

