translate deutsch b2c15s02_24f65fe2:

    # mc "Hah. You just want me to eat {i}you{/i} up, Zemfira."
    mc "Hah. Du willst nur, dass ich{i}dich{/i}verschlinge, Zemfira."

# game/code/book-2/chapter-15/b2c15s02.rpy:133
translate deutsch b2c15s02_00b17a85:

    # zp "Mmm. Well, I'm never opposed to having my pussy go into total meltdown."
    zp "Mmm. Nun, ich bin nie dagegen, wenn meine Muschi total ausrastet."

# game/code/book-2/chapter-15/b2c15s02.rpy:134
translate deutsch b2c15s02_f08a03ad:

    # zp "But enough about me, are you sure everything is good?"
    zp "Aber genug von mir, bist du sicher, dass alles gut ist?"

