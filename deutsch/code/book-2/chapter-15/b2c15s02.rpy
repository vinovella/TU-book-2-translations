    # mc "Everything good, Zem?"
    mc "Alles gut, Zem?"

# game/code/book-2/chapter-15/b2c15s02.rpy:235
translate deutsch b2c15s02_cde76e3c:

    # zp "Yeah. Mostly. I just remembered what happened at the last big party."
    zp "Ja. Meistens. Ich hab nur gerade an die letzte große Party erinnert."

# game/code/book-2/chapter-15/b2c15s02.rpy:237
translate deutsch b2c15s02_ab5259d4:

