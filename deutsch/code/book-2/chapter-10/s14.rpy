# game/code/book-2/chapter-10/s14.rpy:816

translate deutsch b2c10s14_nv_sm_4a7c1ae6:



    # sm "... Many times. In a row. In all directions. Intensely."

    sm "... Oft. Hintereinander. In alle Richtungen. Intensiv."



