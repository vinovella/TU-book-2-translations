translate deutsch b2c10s02_setup_harlan_3fd82bde:



    # pjh "You must be the new TA everyone's talking about. I'm James Harlan, Computer Science."

    pjh "Sie müssen die neue TA sein, von der alle reden. Ich bin James Harlan, Informatik."


