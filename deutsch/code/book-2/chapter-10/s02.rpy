translate deutsch b2c10s02_setup_kara_01586597:



    # mct "Poised and respected professor on the outside, devious manipulator on the inside."

    mct "Standhafter und respektierter Professor von außen, hinterhältiger Manipulator von innen."


# game/code/book-2/chapter-10/s02.rpy:541

translate deutsch b2c10s02_setup_kara_48195be4:



    # mct "I know you had an issue with Maria... But was it enough to hurt her? Just you wait - I'll find out soon enough."

    mct "Ich weiß, dass du ein Problem mit Maria hattest... Aber war es genug, um sie zu verletzen? Nur warten Sie - ich werde es bald genug herausfinden."


# game/code/book-2/chapter-10/s02.rpy:554

translate deutsch b2c10s02_setup_kara_e446cc6f:



    # mc "[mcname] Cheney."

    mc "[mcname] Cheney."


