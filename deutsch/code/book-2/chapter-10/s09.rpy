# game/code/book-2/chapter-10/s09.rpy:285

translate deutsch b2c10s09_855419c7:



    # ffl "I just...um. I really like you, too."

    ffl "Ich nur... äh. Ich mag dich auch wirklich."



# game/code/book-2/chapter-10/s09.rpy:286

translate deutsch b2c10s09_532acb70:



    # ffl "I'm not jealous or anything, it's just—"

    ffl "Ich bin nicht eifersüchtig oder so, es ist nur—"



# game/code/book-2/chapter-10/s09.rpy:289

translate deutsch b2c10s09_36aa74f4:



    # ffl "Well, no matter what I want you both to be happy."

    ffl "Nun, egal was, ich will, dass ihr beide glücklich seid."



# game/code/book-2/chapter-10/s09.rpy:291

translate deutsch b2c10s09_5c7cec40:



    # mc "Does Zem know that we've...?"

    mc "Weiß Zem, dass wir...?"



# game/code/book-2/chapter-10/s09.rpy:293

translate deutsch b2c10s09_80af6ccb:



    # ffl "No. She knows I have a major crush on a guy right now but not who. I was too shy to tell her and..."

    ffl "Nein. Sie weiß, dass ich gerade einen Riesenknall auf einen Typen hab, aber nicht wer. Ich war zu schüchtern, es ihr zu sagen und..."



# game/code/book-2/chapter-10/s09.rpy:296

translate deutsch b2c10s09_77289109:



    # ffl "Well, I wanted to wait until things...settled in a bit."

    ffl "Nun, ich wollte warten, bis sich die Dinge... ein bisschen gelegt haben."



# game/code/book-2/chapter-10/s09.rpy:298

translate deutsch b2c10s09_5880104d:



    # mc "As in?"

    mc "Wie meinen?"



# game/code/book-2/chapter-10/s09.rpy:301

translate deutsch b2c10s09_2d0d60b0:



    # ffl "As in knowing how {i}you{/i} feel about me. But I didn't want to rush things."

    ffl "So dass ich weiß, wie {i}du{/i} dich über mich fühlst. Aber ich wollte die Dinge nicht überstürzen."



# game/code/book-2/chapter-10/s09.rpy:304

translate deutsch b2c10s09_b805585e:



    # mc "Yeah, me too."

    mc "Ja, ich auch."



# game/code/book-2/chapter-10/s09.rpy:307

translate deutsch b2c10s09_8cd3dd59:



    # ffl "But now, with things progressing as they are..."

    ffl "Aber jetzt, wo die Dinge so voranschreiten..."



# game/code/book-2/chapter-10/s09.rpy:308

translate deutsch b2c10s09_337b2830:



    # ffl "I worry that feelings might get hurt."

    ffl "Ich mache mir Sorgen, dass Gefühle verletzt werden könnten."



# game/code/book-2/chapter-10/s09.rpy:312

translate deutsch b2c10s09_b238ed40:



    # mc "I care about you, Fleur. That hasn't changed."

    mc "Ich mag dich, Fleur. Das hat sich nicht geändert."



# game/code/book-2/chapter-10/s09.rpy:315

translate deutsch b2c10s09_c5c02230:



    # mc "There's a lot to think about—"

    mc "Es gibt viel zu bedenken—"



# game/code/book-2/chapter-10/s09.rpy:317

translate deutsch b2c10s09_052664e3:



    # ffl "Of course. I'm sorry I—"

    ffl "Natürlich. Es tut mir leid, ich—"



# game/code/book-2/chapter-10/s09.rpy:320

translate deutsch b2c10s09_c5c03f6d:



    # mc "Shh. It's okay. We're all a little unsure right now."

    mc "Pst. Schon okay. Wir sind uns alle ein bisschen unsicher gerade jetzt."



# game/code/book-2/chapter-10/s09.rpy:321

translate deutsch b2c10s09_e0795e0d:



    # mc "But I promise my care for you hasn't changed at all."

    mc "Aber ich verspreche, meine Zuneigung zu dir hat sich überhaupt nicht geändert."



# game/code/book-2/chapter-10/s09.rpy:324

translate deutsch b2c10s09_a6fa7738:



    # "Fleur gives you a small, pretty smile."

    "Fleur gives you a small, pretty smile."



# game/code/book-2/chapter-10/s09.rpy:326

translate deutsch b2c10s09_391f9209:



    # ffl "I know. I trust you."

    ffl "Ich weiß. Ich vertraue dir."



# game/code/book-2/chapter-10/s09.rpy:327

translate deutsch b2c10s09_1ec58390:



    # ffl "Above all, I want you and Zem to be happy."

    ffl "Vor allem will ich, dass du und Zem glücklich seid."



# game/code/book-2/chapter-10/s09.rpy:330

translate deutsch b2c10s09_626a5097:



    # mc "I want {i}you{/i} to be happy too."

    mc "Ich will, dass {i}du{/i} glücklich bist auch."



# game/code/book-2/chapter-10/s09.rpy:332

translate deutsch b2c10s09_4e8750e9:



    # ffl "That means a lot to me."

    ffl "Das bedeutet mir viel."



# game/code/book-2/chapter-10/s09.rpy:335

translate deutsch b2c10s09_f424daac:



    # ffl "And, listen. We're young. I'm not even sure I want a long term, committed connection right now."

    ffl "Und, hör mal. Wir sind jung. Ich bin mir nicht mal sicher, ob ich gerade eine langfristige, feste Beziehung will."



# game/code/book-2/chapter-10/s09.rpy:336

translate deutsch b2c10s09_65df5692:



    # ffl "But...I want romance. And I want you, still."

    ffl "Aber... ich will Romantik. Und ich will dich, immer noch."



# game/code/book-2/chapter-10/s09.rpy:337

translate deutsch b2c10s09_48e1ffde:



    # ffl "But never at the cost of someone else's happiness."

    ffl "Aber niemals auf Kosten der Glückseligkeit von jemand anderem."



# game/code/book-2/chapter-10/s09.rpy:340

translate deutsch b2c10s09_03aecfe4:



    # mc "What about your happiness, Fleur?"

    mc "Was ist mit deinem Glück, Fleur?"



# game/code/book-2/chapter-10/s09.rpy:342

translate deutsch b2c10s09_bde08b67:



    # ffl "Life is too short to dwell on things that don't work out."

    ffl "Das Leben ist zu kurz, um über Dinge nachzudenken, die nicht klappen."



# game/code/book-2/chapter-10/s09.rpy:348

translate deutsch b2c10s09_22270435:



    # ffl "So I try to focus on the things that do work out."

    ffl "Also versuche ich, mich auf die Dinge zu konzentrieren, die klappen."



# game/code/book-2/chapter-10/s09.rpy:349

translate deutsch b2c10s09_9061a1e8:



    # ffl "Anyway. Just...be careful with Zem, okay? She's been through a lot."

    ffl "Egal. Nur... sei vorsichtig mit Zem, okay? Sie hat viel durchgemacht."



# game/code/book-2/chapter-10/s09.rpy:354

translate deutsch b2c10s09_7cd93bb8:



    # mc "Trust me, she's the last person who deserves more shit on her plate."

    mc "Vertrau mir, sie ist die Letzte, die noch mehr Scheiß verdient hat."



# game/code/book-2/chapter-10/s09.rpy:358

translate deutsch b2c10s09_b31f9b80:



    # mct "It was such a stupid thing... What was I thinking?"

    mct "Es war so eine blöde Sache... Was habe ich mir gedacht?"



# game/code/book-2/chapter-10/s09.rpy:359

translate deutsch b2c10s09_7aa898f2:



    # mct "That had nothing to do with the investigation. And yet, I can't help but admit that I liked it, whatever it was."

    mct "Das hatte nichts mit der Ermittlung zu tun. Und trotzdem kann ich nicht anders, zuzugeben, dass ich es gemocht hab, was immer es war."



# game/code/book-2/chapter-10/s09.rpy:360

translate deutsch b2c10s09_089d7e4a:



    # mct "Still, I can't lose sight of the investigation. I owe it to the missing girls, and the ones who are still here."

    mct "Trotzdem darf ich die Ermittlung nicht aus den Augen verlieren. Ich schulde es den vermissten Mädchen, und denen, die noch hier sind."



# game/code/book-2/chapter-10/s09.rpy:363

translate deutsch b2c10s09_79e11993:



    # mc "I feel bad."

    mc "Ich fühle mich schlecht."



# game/code/book-2/chapter-10/s09.rpy:366

translate deutsch b2c10s09_d93f5c24:



    # ffl "Don't feel bad."

    ffl "Fühl dich nicht schlecht."



# game/code/book-2/chapter-10/s09.rpy:367

translate deutsch b2c10s09_175442e8:



    # ffl "She told me she had an excellent time."

    ffl "Sie hat mir gesagt, dass sie eine ausgezeichnete Zeit hatte."



# game/code/book-2/chapter-10/s09.rpy:370

translate deutsch b2c10s09_b56bbb9e:



    # ffl "Anyways, you should get going. I'll see you later."

    ffl "Sowieso, du solltest losgehen. Wir sehen uns später."



