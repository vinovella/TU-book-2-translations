# game/code/book-2/chapter-10/s12.rpy:64

translate deutsch b2c10s12_b1d1a951:



    # fox "Lilith and I are obviously quite close. We've been through a lot together."

    fox "Lilith und ich sind uns offensichtlich sehr nah. Wir haben viel gemeinsam durchgestanden."



# game/code/book-2/chapter-10/s12.rpy:67

translate deutsch b2c10s12_25928953:



    # fox "Indulging in pleasures like this is one of the ways we affirm our bond."

