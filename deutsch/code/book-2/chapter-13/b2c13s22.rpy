    # mc "Yes. Dangerous. And... I really shouldn't tell you why, but... I'm going to. For {i}you{/i}. Because I trust you - {i}both{/i} of you."
    mc "Ja. Gefährlich. Und... eigentlich sollte ich dir nicht sagen, warum, aber... ich tu es. Für {i}dich{/i}. Weil ich euch vertraue – euch {i}beide{/i}."

# game/code/book-2/chapter-13/b2c13s22.rpy:437
translate deutsch b2c13s22_continue_24dff1e5:

    # lw "Pssh- yeah? Even {i}me?{/i}"
    lw "Pssht- ja? Sogar {i}ich?{/i}"

