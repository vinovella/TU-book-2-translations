translate deutsch b2c13s22_continue_f724e6ef:

    # mc "... As much of a bitch as you can be, yeah. Like you said - we're straight shooters. For better or worse, I trust you."
    mc "... So eine Zicke, wie du sein kannst, ja. Wie du gesagt hast – wir sagen, was wir meinen. Guten oder schlechten – ich vertraue dir."

# game/code/book-2/chapter-13/b2c13s22.rpy:444
translate deutsch b2c13s22_continue_f52272e3:

    # lw "... Hm."
    lw "... Hm."

