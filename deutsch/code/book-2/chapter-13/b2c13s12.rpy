translate deutsch b2c13s12_96ca658d:



    # dk "This is as far as I go."

    dk "So weit gehe ich nur."



# game/code/book-2/chapter-13/b2c13s12.rpy:130

translate deutsch b2c13s12_3b9bc24e:



    # mc "Any advice?"

    mc "Irgendein Rat?"



# game/code/book-2/chapter-13/b2c13s12.rpy:133

translate deutsch b2c13s12_c8b12ddc:



    # "She grips your arm. Her fingers dig into your bicep."

    "Sie packt deinen Arm. Ihre Finger bohren sich in deinen Bizeps."



# game/code/book-2/chapter-13/b2c13s12.rpy:135

translate deutsch b2c13s12_0de305fe:



    # dk "Don't let her eat you alive, golden boy. I kinda like having you around."

    dk "Lass dich nicht von ihr lebendig auffressen, Goldjunge. Ich hab dich irgendwie gern hier."



# game/code/book-2/chapter-13/b2c13s12.rpy:140

translate deutsch b2c13s12_42eadccf:



    # dk "Mmm."

    dk "Mmm."



# game/code/book-2/chapter-13/b2c13s12.rpy:143

translate deutsch b2c13s12_46a6bc68:



    # "She turns and walks away fast, her footsteps echoing."

    "Sie dreht sich um und geht schnell weg, ihre Schritte hallen wider."



# game/code/book-2/chapter-13/b2c13s12.rpy:144

translate deutsch b2c13s12_d91a241d:



    # mct "Comforting."

    mct "Beruhigend."



# game/code/book-2/chapter-13/b2c13s12.rpy:148

translate deutsch b2c13s12_ab7ebd71:



    # "You push the heavy timber door open. The wood groans against the stone floor, announcing your arrival."

    "Du drückst die schwere Holztür auf. Das Holz stöhnt auf dem Steinboden und kündigt deine Ankunft an."



# game/code/book-2/chapter-13/b2c13s12.rpy:153

translate deutsch b2c13s12_replay_3c61afd4:



    # "The air inside hits you, it's heavy, humid, and thick with the scent of sandalwood and burning beeswax."

    "Die Luft im Inneren trifft dich, sie ist schwer, feucht und dick mit dem Duft von Sandelholz und brennendem Bienenwachs."



# game/code/book-2/chapter-13/b2c13s12.rpy:154

translate deutsch b2c13s12_replay_2d37d3e4:



    # "It masks the rot of the catacombs completely. It smells expensive. Suffocating."

    "Sie überdeckt die Fäulnis der Katakomben vollständig. Es riecht nach teurem. Erstickendem."



# game/code/book-2/chapter-13/b2c13s12.rpy:157

translate deutsch b2c13s12_replay_34beaebb:



    # mct "This place always gives off a vibe.{w} Like a spider's web. A very comfortable, very expensive web."

    mct "Dieser Ort strahlt immer so eine Stimmung aus.{w} Wie ein Spinnennetz. Ein sehr bequemes, sehr teures Netz."



# game/code/book-2/chapter-13/b2c13s12.rpy:158

translate deutsch b2c13s12_replay_21185473:



    # "Your eyes sweep the room. Soft, golden light blurs the edges of the chamber, making the stone walls feel almost cozy."

    "Deine Blicke schweifen durch den Raum. Sanftes, goldenes Licht verwischt die Kanten der Kammer und lässt die Steinwände fast gemütlich wirken."



# game/code/book-2/chapter-13/b2c13s12.rpy:160

translate deutsch b2c13s12_replay_ef12ee6a:



    # mct "There's the staff. Looks normal, but that doesn't mean she hasn't found the listening device."

    mct "Da ist der Stab. Sieht normal aus, aber das heißt nicht, dass sie das Abhörgerät nicht gefunden hat."



# game/code/book-2/chapter-13/b2c13s12.rpy:163

translate deutsch b2c13s12_replay_18b8d291:



    # mct "Steam rising from the pot. She can't be far away."

    mct "Dampf steigt aus dem Topf. Sie kann nicht weit sein."



# game/code/book-2/chapter-13/b2c13s12.rpy:166

translate deutsch b2c13s12_replay_e8996a29:



    # kd "Please. Sit."

    kd "Bitte. Setz dich."



# game/code/book-2/chapter-13/b2c13s12.rpy:168

translate deutsch b2c13s12_replay_b9c404fa:



    # "You turn. She just materialized, stepping out from a shadow you hadn't noticed."

    "Du drehst dich um. Sie ist einfach materialisiert, aus einem Schatten getreten, den du nicht bemerkt hast."



# game/code/book-2/chapter-13/b2c13s12.rpy:171

translate deutsch b2c13s12_replay_19ac88a0:



    # "She's stripped off the mask and the ceremonial robes. Just a woman in silk, hair loose, looking dangerously ordinary."

    "Sie hat Maske und Zeremoniengewänder abgelegt. Nur eine Frau in Seide, offene Haare, sieht gefährlich gewöhnlich aus."



# game/code/book-2/chapter-13/b2c13s12.rpy:175

translate deutsch b2c13s12_replay_f037ade6:



    # mct "She's coming down to my level. Disarming me."

    mct "Sie begibt sich auf meine Ebene. Entwaffnet mich."



# game/code/book-2/chapter-13/b2c13s12.rpy:179

translate deutsch b2c13s12_replay_9f760752:



    # kd "I've been looking forward to talking with you again, [mcname]."

    kd "Ich habe mich darauf gefreut, wieder mit dir zu reden, [mcname]."



# game/code/book-2/chapter-13/b2c13s12.rpy:182

translate deutsch b2c13s12_replay_305e77a0:



    # kd "I've heard many breathless things about you from the others lately. The man who brings life where there was none."

    kd "Ich habe in letzter Zeit viel Atemloses über dich von den anderen gehört. Der Mann, der Leben dorthin bringt, wo keines war."



# game/code/book-2/chapter-13/b2c13s12.rpy:184

translate deutsch b2c13s12_replay_32779a8d:



    # mct "There's no way the tea doesn't have some sort of relaxant. Or poison."

    mct "Der Tee hat bestimmt irgendwas Beruhigendes drin. Oder Gift."



