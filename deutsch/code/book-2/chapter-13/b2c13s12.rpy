translate deutsch b2c13s12_replay_b7cc6957:



    # kd "Neither do I."

    kd "Ich auch nicht."



# game/code/book-2/chapter-13/b2c13s12.rpy:243

translate deutsch b2c13s12_replay_5f56e2d7:



    # mct "What? This has to be some kind of test to get me to slip up."

    mct "Was? Das muss irgendein Test sein, damit ich einen Fehler mache."



# game/code/book-2/chapter-13/b2c13s12.rpy:244

translate deutsch b2c13s12_replay_a97bffac:



