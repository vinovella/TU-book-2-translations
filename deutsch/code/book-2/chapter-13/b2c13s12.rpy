translate deutsch b2c13s12_replay_3a604480:



    # "You take the cup. The china is delicate, almost eggshell thin in your hand."

    "Du nimmst die Tasse. Das Porzellan ist zart, fast eierschalldünn in deiner Hand."



# game/code/book-2/chapter-13/b2c13s12.rpy:189

translate deutsch b2c13s12_replay_b503464a:



    # mc "Have you?"

    mc "Wirklich?"



# game/code/book-2/chapter-13/b2c13s12.rpy:191

translate deutsch b2c13s12_replay_fed665d1:



    # kd "Mm, oh yes. Your energy has become so...{i}vibrant{/i} within the community since the birth."

    kd "Mm, oh ja. Deine Energie ist seit der Geburt so...{i}lebendig{/i} in der Gemeinde geworden."



# game/code/book-2/chapter-13/b2c13s12.rpy:195

translate deutsch b2c13s12_replay_ced459ce:



    # kd "Sit. I don't bite.{w} Unless asked."

    kd "Setz dich. Ich beiße nicht.{w} Außer man bittet mich darum."



# game/code/book-2/chapter-13/b2c13s12.rpy:204

translate deutsch b2c13s12_replay_34a2274a:



    # kd "You're tense. Understandable. Most people are, their first time here."

    kd "Du bist angespannt. Verständlich. Die meisten sind das, wenn sie das erste Mal hier sind."



# game/code/book-2/chapter-13/b2c13s12.rpy:206

translate deutsch b2c13s12_replay_bfc6b60d:



