# game/code/book-2/chapter-13/b2c13s12.rpy:800

translate deutsch b2c13s12_sex_72e38159:



    # mc "I have to ask. This community celebrates fertility. Breeding. Why...?"

    mc "Ich muss fragen. Diese Gemeinde feiert Fruchtbarkeit. Fortpflanzung. Warum...?"



# game/code/book-2/chapter-13/b2c13s12.rpy:804

translate deutsch b2c13s12_sex_733e7b03:



    # kd "Oh, you {i}have{/i} been paying attention."

    kd "Oh, du hast {i}wohl{/i} aufgepasst."



# game/code/book-2/chapter-13/b2c13s12.rpy:807

translate deutsch b2c13s12_sex_57e08334:



    # "She pulls the robe on, covering the sweat and the plug, instantly regaining her silhouette."

    "Sie zieht das Gewand an, bedeckt den Schweiß und den Plug, und gewinnt sofort ihre Silhouette zurück."



# game/code/book-2/chapter-13/b2c13s12.rpy:810

translate deutsch b2c13s12_sex_3c7667a7:



    # kd "The community celebrates creation, yes. But I'm not one of my lambs, child."

    kd "Die Gemeinde feiert die Schöpfung, ja. Aber ich bin keines meiner Lämmer, Kind."



# game/code/book-2/chapter-13/b2c13s12.rpy:811

translate deutsch b2c13s12_sex_67d6710b:



    # kd "I don't serve. I'm {i}served{/i}."

    kd "Ich diene nicht. Mir {i}wird gedient{/i}."



# game/code/book-2/chapter-13/b2c13s12.rpy:814

translate deutsch b2c13s12_sex_343c95f6:



    # kd "I prefer pleasure without...consequences."

    kd "Ich bevorzuge Lust ohne... Konsequenzen."



# game/code/book-2/chapter-13/b2c13s12.rpy:817

translate deutsch b2c13s12_sex_33133509:



    # mct "She gets what she prefers. Meanwhile Lumi is terrified and Eliina is crying over a baby she might lose."

    mct "Sie bekommt, was sie bevorzugt. Inzwischen hat Lumi Todesangst und Eliina weint über ein Baby, das sie vielleicht verliert."



# game/code/book-2/chapter-13/b2c13s12.rpy:818

translate deutsch b2c13s12_sex_97eaf3f6:



    # mct "Rules for thee, not for me."

    mct "Regeln für dich, nicht für mich."



# game/code/book-2/chapter-13/b2c13s12.rpy:823

translate deutsch b2c13s12_sex_15f27018:



    # mc "Is this standard procedure for the position? Or am I special?"

    mc "Ist das Standardverfahren für diese Position? Oder bin ich etwas Besonderes?"



# game/code/book-2/chapter-13/b2c13s12.rpy:825

translate deutsch b2c13s12_sex_2999e98e:



    # kd "Only the ones worth testing."

    kd "Nur die, die es wert sind, getestet zu werden."



# game/code/book-2/chapter-13/b2c13s12.rpy:829

translate deutsch b2c13s12_sex_ecb635c8:



    # kd "Andrejz never made it past the first stage. He was too busy worshipping the ground I walked on to realize I wanted someone to walk with me."

    kd "Andrejz hat es nie über die erste Stufe geschafft. Er war zu sehr damit beschäftigt, den Boden anzubeten, auf dem ich ging, um zu merken, dass ich jemanden wollte, der mit mir geht."



# game/code/book-2/chapter-13/b2c13s12.rpy:832

translate deutsch b2c13s12_sex_91bd7faf:



    # mct "She's comparing us. Making me feel special."

    mct "Sie vergleicht uns. Lässt mich besonders fühlen."



# game/code/book-2/chapter-13/b2c13s12.rpy:833

translate deutsch b2c13s12_sex_87e87f6c:



    # mct "But why does it feel so good to hear?"

    mct "Aber warum fühlt es sich so gut an, das zu hören?"



# game/code/book-2/chapter-13/b2c13s12.rpy:836

translate deutsch b2c13s12_sex_5f7ae3be:



    # "She smooths her hair. In ten seconds, the feral woman who begged to be broken is gone. The Prophet is back."

    "Sie glättet ihr Haar. In zehn Sekunden ist die wilde Frau, die darum bettelte, gebrochen zu werden, weg. Die Prophetin ist zurück."



# game/code/book-2/chapter-13/b2c13s12.rpy:838

translate deutsch b2c13s12_sex_a4c4663a:



    # kd "You've passed the first test. There will be others."

    kd "Du hast die erste Prüfung bestanden. Es wird weitere geben."



# game/code/book-2/chapter-13/b2c13s12.rpy:842

translate deutsch b2c13s12_sex_5ba6dc38:



    # kd "But for now...consider yourself on the path."

    kd "Aber für jetzt... sieh dich auf dem Weg."



# game/code/book-2/chapter-13/b2c13s12.rpy:862

translate deutsch b2c13s12_end_c6dc0802:



    # "You exit the chamber. The humidity drops instantly, replaced by the chill of the tunnels."

    "Du verlässt die Kammer. Die Feuchte sinkt sofort, ersetzt durch die Kälte der Tunnel."



# game/code/book-2/chapter-13/b2c13s12.rpy:866

translate deutsch b2c13s12_end_ab81166a:



    # mct "She got what she wanted. Control. Leverage. A piece of me she can use later."

    mct "Sie hat bekommen, was sie wollte. Kontrolle. Druckmittel. Ein Stück von mir, das sie später benutzen kann."



# game/code/book-2/chapter-13/b2c13s12.rpy:867

translate deutsch b2c13s12_end_fe231d81:



    # mct "But I got something too. Access. And I know she can be broken. I felt her crack."

    mct "Aber ich habe auch etwas bekommen. Zugang. Und ich weiß, dass sie gebrochen werden kann. Ich habe gespürt, wie sie zerbricht."



# game/code/book-2/chapter-13/b2c13s12.rpy:870

translate deutsch b2c13s12_end_2ee98cfa:



    # mct "And confirmation that Andrejz is dead walking."

    mct "Und die Bestätigung, dass Andrejz ein toter Mann ist."



# game/code/book-2/chapter-13/b2c13s12.rpy:874

translate deutsch b2c13s12_end_0cfb72a0:



    # mct "She didn't punish the refusal. That's either a good sign or a very bad one."

    mct "Sie hat die Ablehnung nicht bestraft. Das ist entweder ein gutes oder ein sehr schlechtes Zeichen."



# game/code/book-2/chapter-13/b2c13s12.rpy:875

translate deutsch b2c13s12_end_a7f94cd8:



    # mct "She's patient. She'll find another way to bind me. Or she'll just replace me."

    mct "Sie ist geduldig. Sie wird einen anderen Weg finden, mich zu binden. Oder sie ersetzt mich einfach."



# game/code/book-2/chapter-13/b2c13s12.rpy:878

translate deutsch b2c13s12_end_3c7ade23:



    # mct "\"External partners.\" \"Couriers.\" What is she hinting at here?"

    mct "\"Externe Partner.\" \"Kurier.\" Worauf spielt sie hier an?"



# game/code/book-2/chapter-13/b2c13s12.rpy:879

translate deutsch b2c13s12_end_1d247d79:



    # mct "And she was cagey about Andrejz. \"Find peace one way or another.\""

    mct "Und sie war ausweichend wegen Andrejz. \"Auf die eine oder andere Weise Frieden finden.\""



# game/code/book-2/chapter-13/b2c13s12.rpy:882

translate deutsch b2c13s12_end_b5e74f86:



    # mct "She's setting us up. Me and Andrejz. Two dogs fighting over the same bone while she holds the leash."

    mct "Sie stellt uns gegeneinander. Mich und Andrejz. Zwei Hunde, die um den selben Knochen kämpfen, während sie die Leine hält."



