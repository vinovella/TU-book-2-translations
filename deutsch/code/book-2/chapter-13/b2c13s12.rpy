    mct "Das ist ein Glücksspiel. Die falsche Antwort könnte mich fertigmachen."



# game/code/book-2/chapter-13/b2c13s12.rpy:248

translate deutsch b2c13s12_replay_a65bccbd:



    # mct "No...{w} I can see it in her eyes."

    mct "Nein...{w} Ich sehe es in ihren Augen."



# game/code/book-2/chapter-13/b2c13s12.rpy:249

