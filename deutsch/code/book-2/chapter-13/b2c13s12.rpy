translate deutsch b2c13s12_51f9f720:



    # mc "Made an impression, apparently."

    mc "Hab scheinbar Eindruck gemacht."



# game/code/book-2/chapter-13/b2c13s12.rpy:119

translate deutsch b2c13s12_48990b56:



    # dk "*shuddering breath* Understatement of the century."

