# game/code/book-2/chapter-13/b2c13s12.rpy:105

translate deutsch b2c13s12_a5861bd7:



    # mc "I'm getting that impression."

    mc "Das hab ich mir schon gedacht."



# game/code/book-2/chapter-13/b2c13s12.rpy:108

translate deutsch b2c13s12_567f07ad:



    # dk "Hmmm. Even I've never been past the door while she's there."

    dk "Hmmm. Sogar ich war noch nie hinter der Tür, wenn sie drin ist."



# game/code/book-2/chapter-13/b2c13s12.rpy:109

translate deutsch b2c13s12_bbbac080:



