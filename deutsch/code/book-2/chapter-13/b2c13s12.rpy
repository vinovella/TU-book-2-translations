translate deutsch b2c13s12_6236dea8:



    # mct "Shit. Did she find the bug? Did Andrejz come whining to her? Or does she just want to \"talk\"?"

    mct "Scheiße. Hat sie den Wanzen gefunden? Ist Andrejz zu ihr geheult? Oder will sie einfach nur \"reden\"?"



# game/code/book-2/chapter-13/b2c13s12.rpy:92

translate deutsch b2c13s12_df7ee913:



    # mc "Lead the way."

    mc "Geh voran."



