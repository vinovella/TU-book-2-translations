translate deutsch b2c13s06_saint_06b721cd:

    # mct "And it'll knock you out if you take too much..."
    mct "Und es macht dich bewusstlos, wenn du zu viel nimmst..."

# game/code/book-2/chapter-13/b2c13s06.rpy:486
translate deutsch b2c13s06_saint_7aedd4dc:

    # ba "Wait. These chemical names..."
