translate deutsch b2c13s06_saint_19c985e7:

    # ba "Who's Dr. Howerton?"
    ba "Wer ist Dr. Howerton?"

# game/code/book-2/chapter-13/b2c13s06.rpy:458
translate deutsch b2c13s06_saint_0521582c:

    # mct "Dr. Howerton. Never heard of him."
    mct "Dr. Howerton. Nie von ihm gehört."

# game/code/book-2/chapter-13/b2c13s06.rpy:459
translate deutsch b2c13s06_saint_5ab655b8:

    # mct "But recurring meetings at some off-campus facility? That's not standard faculty behavior."
    mct "Aber wiederkehrende Treffen in einer Einrichtung außerhalb des Campus? Das ist kein normales Fakultätsverhalten."

# game/code/book-2/chapter-13/b2c13s06.rpy:460
translate deutsch b2c13s06_saint_45bbc15b:

    # mct "Harlan has to have a supplier somewhere. Could it be...?"
    mct "Harlan muss irgendwo einen Lieferanten haben. Könnte das...?"

# game/code/book-2/chapter-13/b2c13s06.rpy:463
translate deutsch b2c13s06_saint_8ba96e90:

    # mc "I don't recognize it. But something tells me this Howerton is important."
    mc "Ich kenne ihn nicht. Aber irgendetwas sagt mir, dass dieser Howerton wichtig ist."

# game/code/book-2/chapter-13/b2c13s06.rpy:466
translate deutsch b2c13s06_saint_b87f5a82:

    # ba "Important how?"
