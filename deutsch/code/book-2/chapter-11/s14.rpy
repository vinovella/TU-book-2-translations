    mc "Wir holen dich hier auf Bewährung raus."

# game/code/book-2/chapter-11/s14.rpy:245
translate deutsch b2c11s14_ece7ec4b:

    # cb "... I like this proposition so far."
    cb "... Dieser Vorschlag gefällt mir soweit."

